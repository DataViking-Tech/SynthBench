---
// sb-1i6 — disaggregated subgroup scorecard for a single vendor.
// Buyers reject single-number leaderboard scores (PMF survey n=70). This
// component renders, per dataset the vendor has runs on:
//   * overall SPS with 95% CI band
//   * a question-type matrix (rows: topics) with per-cell SPS and N
//   * a demographic-subgroup matrix (attribute / group rows) with p_dist,
//     p_cond, and a coverage flag from n_questions
// Both matrices are expandable: clicking a row reveals additional metrics
// (p_dist / p_rank / p_refuse for topics; p_cond for demographics).
//
// The component degrades when topic_metrics or demographic_scores are
// missing — many providers don't yet publish demographic conditioning.

import leaderboardRaw from "@/data/leaderboard.json";
import type {
  DemographicScorecardDimension,
  LeaderboardEntry,
  SynthBenchData,
  TopicMetricBreakdown,
} from "@/types/leaderboard";

interface Props {
  entries: LeaderboardEntry[];
}

const { entries } = Astro.props as Props;

// Ground-truth provenance per dataset (panel review: expert readers missed
// that cells are scored against REAL human subgroup answers, not against a
// model of the subgroup). Wire the citation from dataset_policies so the
// statement stays in sync with `synthbench publish-data` output.
const datasetCitations = new Map<string, string | null>(
  ((leaderboardRaw as unknown as SynthBenchData).dataset_policies ?? []).map((p) => [
    p.name,
    p.citation,
  ]),
);

// Below this n, a subgroup cell is rendered de-emphasized (no color grade,
// explicit "low n" tag) instead of visually claiming the same rigor as
// high-n cells. 30 mirrors the dataset-inclusion floor in DATASETS.md
// ("≥ 30 respondents minimum — anything smaller makes the human distribution
// itself noisier than the model signal"), and it cleanly separates the
// current data (cells are n=20 or n=100).
const LOW_N_THRESHOLD = 30;

const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const submitHref = `${base}submit/`;

interface TopicRow {
  topic: string;
  metric: TopicMetricBreakdown;
}

interface ScorecardView {
  entry: LeaderboardEntry;
  topics: TopicRow[];
  dimensions: DemographicScorecardDimension[];
  cellCount: number;
  missingDimensions: string[];
  halfCi: number | null;
  ciLabel: string;
  topicId: string;
  demoId: string;
}

// Fallback labels for entries that predate the structured
// `demographic_scorecard` block (legacy flat `demographic_scores` only).
// Mirrors _DEMOGRAPHIC_DIMENSION_LABELS in src/synthbench/publish.py.
const DIMENSION_LABELS: Record<string, string> = {
  AGE: "Age",
  CREGION: "Geography (US Census region)",
  EDUCATION: "Education",
  SEX: "Sex",
  RACE: "Race / ethnicity",
  INCOME: "Income",
  POLPARTY: "Political party",
  POLIDEOLOGY: "Political ideology",
  RELIG: "Religion",
  RELIGATTEND: "Religious attendance",
};

// The issue-#255 canonical matrix dimensions we track coverage against.
// Question-type is covered by the topic matrix above; these are the
// demographic axes. Only dimensions with real measured data render scores —
// the rest get an explicit "Not yet measured" state, never fabricated cells.
const CANONICAL_DIMENSIONS: { attribute: string; label: string }[] = [
  { attribute: "AGE", label: "Age" },
  { attribute: "CREGION", label: "Geography" },
  { attribute: "EDUCATION", label: "Education" },
];

// Prefer the structured scorecard; fall back to grouping the legacy flat
// demographic_scores list so older payloads still render.
function scorecardDimensions(entry: LeaderboardEntry): DemographicScorecardDimension[] {
  if (entry.demographic_scorecard) return entry.demographic_scorecard.dimensions;
  const demos = entry.demographic_scores ?? [];
  const order: string[] = [];
  const byAttr: Record<string, DemographicScorecardDimension> = {};
  for (const d of demos) {
    if (!(d.attribute in byAttr)) {
      byAttr[d.attribute] = {
        attribute: d.attribute,
        label: DIMENSION_LABELS[d.attribute] ?? d.attribute,
        groups: [],
      };
      order.push(d.attribute);
    }
    byAttr[d.attribute].groups.push({
      group: d.group,
      score: d.p_dist,
      ci_lower: null,
      ci_upper: null,
      n: d.n_questions,
      p_cond: d.p_cond,
    });
  }
  return order.sort().map((attr) => byAttr[attr]);
}

// Color gradient for score cells: red (0) → amber → green (1), rendered as a
// translucent background so it works in both light and dark themes.
function scoreGradient(score: number): string {
  const clamped = Math.max(0, Math.min(1, score));
  const hue = Math.round(clamped * 140);
  return `background-color: hsl(${hue} 75% 45% / 0.22)`;
}

function fmt3(value: number | null | undefined): string {
  return value == null || Number.isNaN(value) ? "—" : value.toFixed(3);
}

function ciBand(entry: LeaderboardEntry): string {
  if (entry.ci_lower == null || entry.ci_upper == null) return "";
  return `[${entry.ci_lower.toFixed(3)}, ${entry.ci_upper.toFixed(3)}]`;
}

function ciHalfWidth(entry: LeaderboardEntry): number | null {
  if (entry.ci_lower == null || entry.ci_upper == null) return null;
  return Math.max(0, (entry.ci_upper - entry.ci_lower) / 2);
}

function topicRows(entry: LeaderboardEntry): TopicRow[] {
  if (entry.topic_metrics) {
    return Object.entries(entry.topic_metrics)
      .map(([topic, m]) => ({ topic, metric: m as TopicMetricBreakdown }))
      .sort((a, b) => b.metric.sps - a.metric.sps);
  }
  if (entry.topic_scores) {
    return Object.entries(entry.topic_scores)
      .map(([topic, sps]) => ({ topic, metric: { sps: sps as number, n: 0 } }))
      .sort((a, b) => b.metric.sps - a.metric.sps);
  }
  return [];
}

function coverage(n: number): { label: string; cls: string } {
  if (n >= 100) return { label: "high", cls: "bg-emerald-500" };
  if (n >= 50) return { label: "medium", cls: "bg-amber-500" };
  return { label: "low", cls: "bg-rose-500" };
}

// Render one card per entry. Sorted by (dataset asc, sps desc) so the most
// relevant run within each dataset surfaces first.
const sortedEntries = [...entries].sort((a, b) => {
  if (a.dataset !== b.dataset) return a.dataset.localeCompare(b.dataset);
  return b.sps - a.sps;
});

const cards: ScorecardView[] = sortedEntries.map((entry, idx) => {
  const dimensions = scorecardDimensions(entry);
  const measured = new Set(dimensions.map((d) => d.attribute));
  return {
    entry,
    topics: topicRows(entry),
    dimensions,
    cellCount: dimensions.reduce((acc, d) => acc + d.groups.length, 0),
    missingDimensions: CANONICAL_DIMENSIONS.filter((c) => !measured.has(c.attribute)).map(
      (c) => c.label,
    ),
    halfCi: ciHalfWidth(entry),
    ciLabel: ciBand(entry),
    topicId: `topic-${idx}`,
    demoId: `demo-${idx}`,
  };
});

const anyDemographic = cards.some((c) => c.dimensions.length > 0);

// Ground-truth sources actually present on this page, for the statement box.
const sourceLines = Array.from(new Set(cards.map((c) => c.entry.dataset)))
  .sort()
  .map((ds) => ({ dataset: ds, citation: datasetCitations.get(ds) ?? null }));
---

<section
  class="vendor-scorecard w-full max-w-5xl mx-auto py-8 px-4 space-y-10"
  aria-label="Vendor subgroup scorecards"
>
  {cards.length > 0 && (
    <div
      class="rounded-lg border border-primary/30 bg-primary/5 p-4 text-sm"
      data-ground-truth-statement
    >
      <p class="font-semibold">What each cell measures</p>
      <p class="mt-1">
        Each cell compares this vendor's synthetic responses against{" "}
        <strong>real human respondents in that demographic subgroup</strong> —
        published survey ground truth, not a model's guess about the subgroup.
        Higher = closer to how that real subgroup actually answered.
      </p>
      <p class="mt-2 text-xs text-muted">
        Demographic conditioning here is not stereotyping: every conditioned
        score is checked against what real subgroup members said, not against
        assumptions about them — and where the vendor's output diverges from
        the real subgroup, the score drops.
      </p>
      {sourceLines.length > 0 && (
        <ul class="mt-2 text-xs text-muted">
          {sourceLines.map((s) => (
            <li>
              <span class="font-mono">{s.dataset}</span>
              {s.citation ? <> — ground truth: {s.citation}</> : null}
            </li>
          ))}
        </ul>
      )}
      <div class="mt-3 border-t border-muted/20 pt-2 text-xs text-muted space-y-1">
        <p>
          <span class="font-medium text-text dark:text-text-dark">Low-n cells:</span>{" "}
          cells with n &lt; {LOW_N_THRESHOLD} are shown muted and tagged{" "}
          <em>low n — suggestive only</em> instead of color-graded; they are
          reported for transparency, not as findings.
        </p>
        <p>
          <span class="font-medium text-text dark:text-text-dark">CIs:</span>{" "}
          "no CI — single run" marks point estimates from a single run with no
          confidence interval yet; treat the uncertainty as unknown, never zero.
        </p>
        <p>
          <span class="font-medium text-text dark:text-text-dark">Columns:</span>{" "}
          Score = distributional parity (p_dist) restricted to the subgroup ·
          p_cond = conditioning strength vs the unconditioned baseline ·
          N = questions answered under that conditioning · Cov. = coverage
          dot derived from N (green = high, ≥100 · amber = medium, 50–99 ·
          red = low, &lt;50). Topic tables: SPS = Survey Parity Score for the
          topic · p_dist = 1 − mean(JSD) · p_rank = (1 + mean(τ)) / 2 ·
          p_refuse = 1 − mean(|R_model − R_human|).
        </p>
        <p>
          <span class="font-medium text-text dark:text-text-dark">Multiple comparisons:</span>{" "}
          with this many subgroup cells, a few extreme cells are expected by
          chance alone — read patterns across a dimension, not single cells.
        </p>
      </div>
    </div>
  )}

  {cards.length === 0 ? (
    <div class="rounded-lg border border-default bg-surface p-8 text-center text-sm text-muted">
      No runs for this vendor.
    </div>
  ) : (
    cards.map((card) => (
      <article
        class="rounded-lg border border-muted/20 bg-surface/40 dark:bg-surface-dark/40 p-5"
        aria-label={`${card.entry.dataset} scorecard`}
      >
        <header class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
          <div>
            <h3 class="text-lg font-semibold">
              {card.entry.dataset}
              <span class="ml-2 text-sm font-normal text-muted">{card.entry.framework}</span>
            </h3>
            {card.entry.config_id && (
              <p class="text-xs text-muted font-mono break-all">{card.entry.config_id}</p>
            )}
          </div>
          <div class="text-right">
            <div class="text-2xl font-mono font-semibold tabular-nums">
              {fmt3(card.entry.sps)}
              {card.halfCi != null && card.halfCi > 0 && (
                <span class="ml-1 text-base font-normal text-muted">
                  ± {card.halfCi.toFixed(3)}
                </span>
              )}
            </div>
            <div class="text-xs text-muted">
              SPS · 95% CI {card.ciLabel} · n = {card.entry.n}
            </div>
          </div>
        </header>

        {card.topics.length > 0 && (
          <details class="mb-4 group" open>
            <summary class="cursor-pointer select-none text-sm font-medium hover:text-primary">
              Question-type breakdown
              <span class="ml-1 text-xs text-muted">({card.topics.length} topic{card.topics.length === 1 ? "" : "s"})</span>
            </summary>
            <div class="mt-3 overflow-x-auto rounded border border-muted/20">
              <table class="w-full text-xs" id={card.topicId}>
                <thead>
                  <tr class="bg-surface dark:bg-surface-dark border-b border-muted/20 text-muted">
                    <th class="px-3 py-2 text-left font-medium" scope="col">Topic</th>
                    <th class="px-3 py-2 text-right font-medium" scope="col" title="Survey Parity Score restricted to this topic">SPS</th>
                    <th class="px-3 py-2 text-right font-medium" scope="col" title="Distributional parity: 1 − mean(JSD)">p_dist</th>
                    <th class="px-3 py-2 text-right font-medium" scope="col" title="Rank-order parity: (1 + mean(τ)) / 2">p_rank</th>
                    <th class="px-3 py-2 text-right font-medium" scope="col" title="Refusal calibration: 1 − mean(|R_model − R_human|)">p_refuse</th>
                    <th class="px-3 py-2 text-right font-medium" scope="col" title="Questions in this topic">N</th>
                  </tr>
                </thead>
                <tbody>
                  {card.topics.map((r) => (
                    <tr class="border-b border-muted/10 last:border-b-0">
                      <td class="px-3 py-2">{r.topic}</td>
                      <td class="px-3 py-2 text-right font-mono">{fmt3(r.metric.sps)}</td>
                      <td class="px-3 py-2 text-right font-mono text-muted">{fmt3(r.metric.p_dist)}</td>
                      <td class="px-3 py-2 text-right font-mono text-muted">{fmt3(r.metric.p_rank)}</td>
                      <td class="px-3 py-2 text-right font-mono text-muted">{fmt3(r.metric.p_refuse)}</td>
                      <td class="px-3 py-2 text-right font-mono text-muted">{r.metric.n ?? "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}

        {card.dimensions.length > 0 ? (
          <>
            <details class="group scorecard-demo-details" open data-dataset={card.entry.dataset}>
              <summary class="cursor-pointer select-none text-sm font-medium hover:text-primary">
                Demographic subgroup scorecard
                <span class="ml-1 text-xs text-muted">({card.cellCount} cell{card.cellCount === 1 ? "" : "s"} · {card.dimensions.length} dimension{card.dimensions.length === 1 ? "" : "s"})</span>
              </summary>
              <div class="mt-3 overflow-x-auto rounded border border-muted/20">
                <table class="w-full text-xs" id={card.demoId}>
                  <thead>
                    <tr class="bg-surface dark:bg-surface-dark border-b border-muted/20 text-muted">
                      <th class="px-3 py-2 text-left font-medium" scope="col">Dimension</th>
                      <th class="px-3 py-2 text-left font-medium" scope="col">Subgroup</th>
                      <th class="px-3 py-2 text-right font-medium" scope="col" title="Subgroup score: distributional parity (p_dist) restricted to this subgroup">Score</th>
                      <th class="px-3 py-2 text-right font-medium" scope="col" title="95% CI on the subgroup score. 'no CI — single run' means only a point estimate exists today; treat the uncertainty as unknown, never zero.">95% CI</th>
                      <th class="px-3 py-2 text-right font-medium" scope="col" title="Conditioning strength: how much the score moves vs. the unconditioned baseline">p_cond</th>
                      <th class="px-3 py-2 text-right font-medium" scope="col" title="Questions answered with this subgroup conditioning">N</th>
                      <th class="px-3 py-2 text-center font-medium" scope="col" title="Coverage flag derived from N: ≥100 high, 50–99 medium, <50 low">Cov.</th>
                    </tr>
                  </thead>
                  <tbody>
                    {card.dimensions.map((dim) => (
                      dim.groups.map((g, i) => {
                        const cov = coverage(g.n);
                        const lowN = g.n < LOW_N_THRESHOLD;
                        return (
                          <tr class="border-b border-muted/10 last:border-b-0">
                            {i === 0 ? (
                              <th
                                rowspan={dim.groups.length}
                                scope="rowgroup"
                                class="px-3 py-2 text-left font-medium align-top bg-surface/30 dark:bg-surface-dark/30"
                                title={dim.attribute}
                              >
                                {dim.label}
                              </th>
                            ) : null}
                            <td class="px-3 py-2">{g.group}</td>
                            {lowN ? (
                              <td
                                class="px-3 py-2 text-right font-mono text-muted"
                                title={`Only ${g.n} questions under this conditioning — below the n=${LOW_N_THRESHOLD} display threshold, so this cell is not color-graded. Suggestive only.`}
                              >
                                {fmt3(g.score)}
                                <span class="ml-1 inline-block rounded bg-muted/15 px-1 py-0.5 font-sans text-[10px] uppercase tracking-wide align-middle whitespace-nowrap">
                                  low n — suggestive only
                                </span>
                              </td>
                            ) : (
                              <td class="px-3 py-2 text-right font-mono" style={scoreGradient(g.score)}>{fmt3(g.score)}</td>
                            )}
                            <td class="px-3 py-2 text-right font-mono text-muted">
                              {g.ci_lower != null && g.ci_upper != null ? (
                                `[${g.ci_lower.toFixed(3)}, ${g.ci_upper.toFixed(3)}]`
                              ) : (
                                <span
                                  class="font-sans italic whitespace-nowrap"
                                  title="No confidence interval yet — this is a point estimate from a single run. Treat the uncertainty as unknown, never zero."
                                >
                                  no CI — single run
                                </span>
                              )}
                            </td>
                            <td class="px-3 py-2 text-right font-mono text-muted">{fmt3(g.p_cond)}</td>
                            <td class="px-3 py-2 text-right font-mono text-muted">{g.n}</td>
                            <td class="px-3 py-2 text-center">
                              <span
                                class:list={["inline-block w-2 h-2 rounded-full align-middle", cov.cls]}
                                aria-label={`${cov.label} coverage (${g.n} questions)`}
                                title={`${cov.label} (${g.n} questions)`}
                              ></span>
                            </td>
                          </tr>
                        );
                      })
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
            {card.missingDimensions.length > 0 && (
              <div class="mt-3 rounded border border-dashed border-amber-500/40 bg-amber-500/5 p-3 text-xs">
                <span class="font-medium">Not yet measured:</span>{" "}
                this vendor has no demographic-conditioned runs for{" "}
                {card.missingDimensions.join(", ")}.{" "}
                <a href={submitHref} class="text-primary hover:underline">
                  Submit a conditioned run
                </a>{" "}
                to fill in the missing dimension{card.missingDimensions.length === 1 ? "" : "s"}.
              </div>
            )}
          </>
        ) : (
          <div class="rounded border border-dashed border-amber-500/40 bg-amber-500/5 p-4 text-sm">
            <p class="font-medium">Not yet measured</p>
            <p class="mt-1 text-xs text-muted">
              This vendor has no demographic-conditioned runs for age, geography,
              education, or any other subgroup dimension on {card.entry.dataset}.
              No cells are fabricated — scores appear here only when a
              conditioned run actually measured them.
            </p>
            <p class="mt-2 text-xs">
              <a href={submitHref} class="text-primary hover:underline">
                How to submit a demographic-conditioned run →
              </a>
            </p>
          </div>
        )}
      </article>
    ))
  )}

  {!anyDemographic && cards.length > 0 && (
    <p class="text-xs text-muted text-center">
      No demographic conditioning data has been published for this vendor yet. The
      question-type matrix above shows topic-level parity; subgroup rows fill in
      once SynthPanel-style conditioned runs land.
    </p>
  )}
</section>

<script>
  // Expansion instrumentation (issue #255 leading indicator): fire a PostHog
  // event when a visitor toggles a demographic scorecard section open. Uses
  // the site-wide PostHog snippet (Analytics.astro) — on non-production
  // hostnames posthog.init never runs, so `capture` is undefined and the
  // optional chain makes this a no-op. No new dependencies.
  type PostHogLike = {
    capture?: (event: string, properties?: Record<string, unknown>) => void;
  };
  function phCapture(event: string, properties: Record<string, unknown>): void {
    const ph = (window as { posthog?: PostHogLike }).posthog;
    ph?.capture?.(event, properties);
  }

  for (const details of document.querySelectorAll<HTMLDetailsElement>(
    ".scorecard-demo-details",
  )) {
    details.addEventListener("toggle", () => {
      if (!details.open) return;
      phCapture("vendor_scorecard_demographics_expanded", {
        dataset: details.dataset.dataset ?? null,
        path: window.location.pathname,
      });
    });
  }
</script>
