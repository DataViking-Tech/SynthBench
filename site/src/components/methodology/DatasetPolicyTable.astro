---
import type { DatasetPolicyEntry, SynthBenchData } from "@/types/leaderboard";

import leaderboardRaw from "@/data/leaderboard.json";

// `as unknown as` — the JSON's entry unions don't narrow to the strict
// interface cleanly; this component only reads dataset_policies (populated
// by publish.py at build time).
const leaderboard = leaderboardRaw as unknown as SynthBenchData;
const policies: DatasetPolicyEntry[] = leaderboard.dataset_policies ?? [];

const tierLabel: Record<string, string> = {
  full: "full",
  gated: "gated",
  aggregates_only: "aggregates-only",
  citation_only: "citation-only",
};

const tierCopy: Record<string, string> = {
  full: "Per-question human distributions published openly on the static site.",
  gated:
    "Per-question human distributions served from an authenticated origin. Sign-in required (research-use license).",
  aggregates_only:
    "Aggregate scores are public. No per-question artifact ships (permission missing or ambiguous).",
  citation_only: "Question metadata only. All per-question and aggregate metrics are suppressed.",
};
---

{
  policies.length > 0 && (
    <section class="w-full max-w-4xl mx-auto py-12" id="dataset-policies">
      <h2
        class="text-2xl font-bold tracking-tight text-text dark:text-text-dark mb-2"
      >
        Dataset redistribution policy
      </h2>
      <p class="text-muted mb-6 max-w-2xl">
        Each upstream dataset has its own license terms. SynthBench applies
        them at publish time using four tiers:
      </p>
      <ul class="mb-6 max-w-2xl list-disc pl-6 text-sm text-muted space-y-1">
        <li>
          <span class="font-mono">full</span>: per-question distributions
          are published openly (public-domain datasets).
        </li>
        <li>
          <span class="font-mono">gated</span>: per-question distributions
          are served from a Cloudflare Worker that validates a Supabase JWT, so
          research-use sign-in is required. No distribution is served anonymously.
        </li>
        <li>
          <span class="font-mono">aggregates_only</span>: aggregate scores
          are public, and no per-question artifact ships at all. Gating is not a
          substitute for missing redistribution permission.
        </li>
        <li>
          <span class="font-mono">citation_only</span>: question metadata
          only. Every downstream metric is suppressed.
        </li>
      </ul>
      <p class="text-muted mb-6 max-w-2xl">
        Aggregate metrics (SPS, JSD, ranks, cross-model parity) are derived
        quantities and remain public regardless of tier.
      </p>

      <div class="overflow-x-auto rounded-lg border border-muted/20">
        <table class="w-full text-sm">
          <caption class="sr-only">
            Per-dataset redistribution policy tier and provenance, used by
            synthbench publish to gate which fields appear in public
            artifacts.
          </caption>
          <thead>
            <tr class="border-b border-muted/20 bg-surface text-xs dark:bg-surface-dark">
              <th class="px-3 py-2 text-left font-semibold" scope="col">
                Dataset
              </th>
              <th class="px-3 py-2 text-left font-semibold" scope="col">
                Tier
              </th>
              <th class="px-3 py-2 text-left font-semibold" scope="col">
                Source &amp; license
              </th>
            </tr>
          </thead>
          <tbody>
            {policies.map((p) => (
              <tr class="border-b border-muted/10">
                <td class="px-3 py-2 font-mono text-xs">{p.name}</td>
                <td class="px-3 py-2">
                  <span class="font-mono text-xs">
                    {tierLabel[p.redistribution_policy] ?? p.redistribution_policy}
                  </span>
                  <p class="mt-0.5 text-xs text-muted">
                    {tierCopy[p.redistribution_policy] ?? ""}
                  </p>
                </td>
                <td class="px-3 py-2 text-xs">
                  {p.citation ?? "—"}
                  {p.license_url && (
                    <>
                      {" "}
                      <a
                        href={p.license_url}
                        class="text-primary hover:underline"
                        rel="noopener noreferrer"
                        target="_blank"
                      >
                        (license)
                      </a>
                    </>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
