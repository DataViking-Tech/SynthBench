---
// The sub-metrics behind SPS. Leaderboard SPS and the Index use the first
// three; P_cond and P_sub are computed only for runs that test demographic
// conditioning and are published alongside, never folded into the score.
// Phones show the table as one stacked block per metric (.sb-msub-t in
// styles/sb-method.css).
import MethodSection from "./MethodSection.astro";

const rows = [
  {
    name: "P_dist",
    label: "Shares match",
    checks: "How closely the share of answers on each option matches the real survey.",
    formula: "1 − mean JSD(system, people) over questions",
    use: "SPS and Index",
  },
  {
    name: "P_rank",
    label: "Order match",
    checks:
      "Whether the options come out in the same order as for people, even when the shares differ.",
    formula: "(1 + mean Kendall τb) ÷ 2",
    use: "SPS and Index",
  },
  {
    name: "P_refuse",
    label: "Refusal match",
    checks: "Whether the system declines to answer about as often as people do.",
    formula: "1 − mean |refusal rate gap|",
    use: "SPS and Index",
  },
  {
    name: "P_cond",
    label: "Conditioning gain",
    checks:
      "When the prompt names a demographic group, how much closer the answers get to that group's real answers.",
    formula: "mean over groups of max(0, match with group named − match without)",
    use: "Conditioning runs only",
  },
  {
    name: "P_sub",
    label: "Subgroup evenness",
    checks: "Whether the shares match is similar across groups or much worse for some.",
    formula: "1 − coefficient of variation of per-group P_dist",
    use: "Conditioning runs only",
  },
];
---

<MethodSection id="metrics" title="The sub-metrics">
  <p class="sb-muted sb-measure" slot="lede">
    Each runs from 0 to 1. SPS is the mean of the first three, with equal weights. P_cond and P_sub are
    published only for runs that name a demographic group in the prompt, and are not part of SPS or the
    Index. The
    <a href={`${import.meta.env.BASE_URL?.replace(/\/?$/, "/") ?? "/"}groups/`}>Groups</a> page shows
    the per-group comparisons they summarize.
  </p>
  <div class="sb-tablewrap sb-mt">
    <table class="sb-ct sb-msub-t">
      <thead>
        <tr>
          <th scope="col">Metric</th>
          <th scope="col">What it checks</th>
          <th scope="col">Per run</th>
          <th scope="col">Used in</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td class="nowrap">
                <span class="sb-strong">{r.label}</span>
                <div class="sb-mono sb-muted sb-small">{r.name}</div>
              </td>
              <td class="sb-msub-c">{r.checks}</td>
              <td class="sb-mono sb-small" data-label="Per run">{r.formula}</td>
              <td class="nowrap sb-muted" data-label="Used in">{r.use}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</MethodSection>
