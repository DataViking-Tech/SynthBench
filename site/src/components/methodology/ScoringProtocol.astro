---
import MethodSection from "./MethodSection.astro";

const steps = [
  {
    number: 1,
    title: "Select dataset and question set",
    detail:
      "Choose a dataset and how many of its questions to run. Pinned question sets (smoke: 28 and core: 200, both from OpinionsQA) keep repeat runs comparable.",
  },
  {
    number: 2,
    title: "Generate samples for each question",
    detail:
      "For each question-persona pair, generate N independent samples from the model. Default: 30 samples. Publication-grade: 100 samples.",
  },
  {
    number: 3,
    title: "Parse responses into distributions",
    detail:
      "Map each model response to a survey option. Compute P(option_i) = count(option_i) / N. Logprob-capable providers return distributions directly.",
  },
  {
    number: 4,
    title: "Compare against human ground truth",
    detail:
      "For each question-demographic pair, compute JSD between the model distribution and the human distribution from real survey data.",
  },
  {
    number: 5,
    title: "Compute per-question metrics",
    detail:
      "Calculate the sub-metrics computable for the run configuration (P_dist, P_rank, and P_refuse for standard leaderboard runs; P_cond and P_sub when demographic conditioning is evaluated) at the question level.",
  },
  {
    number: 6,
    title: "Aggregate with confidence intervals",
    detail:
      "Average across questions. Bootstrap resampling produces 95% confidence intervals for each metric and the composite SPS.",
  },
];

const protocols = [
  {
    title: "Sampling",
    items: [
      "Minimum 30 samples per question-persona pair",
      "100 samples recommended for publication",
      "Wilson score intervals quantify estimation uncertainty",
      "Parse failures are logged and excluded from counts",
    ],
  },
  {
    title: "Replication",
    items: [
      "Multiple independent runs recommended",
      "Convergence data checks stability",
      "Repeat runs of three top systems on the same questions moved the SynthBench Index by less than 1 point, and one dataset's Index by at most 2.3",
      "The 95% intervals are wider because they also cover which questions were drawn",
    ],
  },
  {
    title: "Fairness",
    items: [
      "Provider-default temperature unless a run sets one; runs at other temperatures are listed as separate variants",
      "Each provider tested via its native interface",
      "Same question sets and evaluation pipeline for all providers",
    ],
  },
];
---

<MethodSection id="scoring" title="How a benchmark run works" fold>
  <p class="sb-muted sb-measure" slot="lede">
    Every provider goes through the same evaluation pipeline. These are the steps that run when you call
    <code class="sb-mcode">synthbench run</code>.
  </p>

  <ol class="sb-msteps">
    {
      steps.map((s) => (
        <li>
          <h3 class="sb-h3">{s.title}</h3>
          <p>{s.detail}</p>
        </li>
      ))
    }
  </ol>

  <div class="sb-msubs sb-msubs-3">
    {
      protocols.map((p) => (
        <div class="sb-msub">
          <h3 class="sb-h3">{p.title}</h3>
          <ul class="sb-mlist">
            {p.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</MethodSection>
