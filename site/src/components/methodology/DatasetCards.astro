---
// Each entry's `slug` MUST match a key in synthbench.datasets.DATASETS
// (src/synthbench/datasets/__init__.py). The drift-guard test
// tests/test_site_dataset_cards.py asserts this set equality so a new
// adapter can't be registered without a methodology card.
import leaderboardRaw from "@/data/leaderboard.json";
import { CORE_DATASETS } from "@/lib/synthIndex";

interface Props {
  /** Section heading: "Datasets" on /methodology; the /datasets page has its own h1. */
  title?: string;
}
const { title = "Datasets" } = Astro.props;

type Tier = "full" | "gated";

type DatasetCard = {
  slug: string;
  name: string;
  tier: Tier;
  questions?: { full: number; core?: number };
  source: string;
  scope: string;
  temporal: string;
  demographics: string;
  description: string;
};

const datasets: DatasetCard[] = [
  {
    slug: "opinionsqa",
    name: "OpinionsQA",
    tier: "gated",
    questions: { full: 1498, core: 200 },
    source: "Pew American Trends Panel",
    scope: "US population",
    temporal: "2017–2022 (15 survey waves)",
    demographics: "56 groups across 11 attributes",
    description:
      "The primary ground-truth dataset. Multiple-choice questions covering political, social, and economic attitudes from nationally representative US surveys.",
  },
  {
    slug: "globalopinionqa",
    name: "GlobalOpinionQA",
    tier: "gated",
    questions: { full: 2556 },
    source: "Pew Global Attitudes",
    scope: "138 countries",
    temporal: "Cross-national",
    demographics: "Country-level cultural variation",
    description:
      "Cross-national attitudes from Pew Global Attitudes surveys. Tests whether models capture how opinion differs between countries, beyond US demographics.",
  },
  {
    slug: "subpop",
    name: "SubPOP",
    tier: "gated",
    questions: { full: 3362 },
    source: "22 US subpopulations",
    scope: "US demographic subgroups",
    temporal: "Cross-sectional",
    demographics:
      "11 attributes: age, education, gender, ideology, party, income, religion, attendance, region, marital status, citizenship",
    description:
      "Extended dataset focused on demographic subgroup variation. Tests whether models can differentiate between fine-grained population segments.",
  },
  {
    slug: "gss",
    name: "GSS",
    tier: "full",
    source: "NORC General Social Survey",
    scope: "US population",
    temporal: "1972–present (cumulative file)",
    demographics: "Individual-level microdata (microdata-capable)",
    description:
      "General Social Survey cumulative microdata from NORC. It is the only public-domain adapter that ships per-respondent rows, which allows convergence curves from real sampling alongside the bootstrap baseline.",
  },
  {
    slug: "ntia",
    name: "NTIA Internet Use Supplement",
    tier: "full",
    source: "US Census / NTIA CPS Supplement",
    scope: "US households",
    temporal: "Biennial waves, 1994–present",
    demographics: "Standard CPS demographics",
    description:
      "NTIA Computer & Internet Use Supplement to the Current Population Survey. U.S. Government public-domain work under 17 USC 105; per-question distributions ship openly.",
  },
  {
    slug: "wvs",
    name: "WVS (World Values Survey)",
    tier: "gated",
    source: "World Values Survey Association",
    scope: "Cross-national (Wave 7, 2017–2022)",
    temporal: "Wave 7 (2017–2022)",
    demographics: "Country + standard demographic cells",
    description:
      "World Values Survey Wave 7. Cross-cultural value orientations across national populations. Research-use license. Per-question artifacts are gated behind JWT auth.",
  },
  {
    slug: "eurobarometer",
    name: "Eurobarometer",
    tier: "gated",
    source: "European Commission / GESIS",
    scope: "EU member states",
    temporal: "Quarterly (Standard / Flash / Special)",
    demographics: "Country + EU-harmonized demographic cells",
    description:
      "Eurobarometer Consumer Modules. EU-wide consumer conditions, digital services, and sustainability attitudes. GESIS restricts redistribution, so per-question data is served from a gated origin.",
  },
  {
    slug: "michigan",
    name: "Michigan (Surveys of Consumers)",
    tier: "gated",
    source: "University of Michigan SRC",
    scope: "US consumers",
    temporal: "Monthly cadence",
    demographics: "Standard consumer-survey demographics",
    description:
      "University of Michigan Surveys of Consumers: consumer sentiment, inflation expectations, and household finance. Academic use terms. Per-question data is gated.",
  },
  {
    slug: "pewtech",
    name: "Pew Technology",
    tier: "gated",
    source: "Pew Research Center Internet & Technology",
    scope: "US population (American Trends Panel)",
    temporal: "10 tech waves (W86–W113)",
    demographics: "ATP demographic weights",
    description:
      "Pew Research Internet & Technology waves: tech adoption, digital privacy, social media, and AI attitudes. Pew redistribution terms. Per-question data is gated.",
  },
];

const tierStyle: Record<Tier, string> = {
  full: "bg-emerald-500/15 text-emerald-700 dark:text-emerald-300",
  gated: "bg-slate-500/15 text-slate-700 dark:text-slate-300",
};

const tierLabel: Record<Tier, string> = {
  full: "full",
  gated: "gated",
};

// Whether each dataset is scored, from the published leaderboard: the core
// datasets make up the Index, others with runs are scored for reference only
// (NTIA), and the rest are registered adapters with no published runs yet.
type Status = "index" | "reference" | "registered";
const scored = new Set(
  ((leaderboardRaw as { datasets?: string[] }).datasets ?? []).map((d) => d.split(" ", 1)[0]),
);
const statusOf = (id: string): Status =>
  (CORE_DATASETS as readonly string[]).includes(id)
    ? "index"
    : scored.has(id)
      ? "reference"
      : "registered";
const statusLabel: Record<Status, string> = {
  index: "In the Index",
  reference: "Reference only",
  registered: "Not scored yet",
};
const statusStyle: Record<Status, string> = {
  index: "border-primary/40 text-primary dark:border-primary-light/40 dark:text-primary-light",
  reference: "border-muted/40 text-muted",
  registered: "border-dashed border-muted/40 text-muted",
};
const count = (s: Status) => datasets.filter((d) => statusOf(d.slug) === s).length;
const WORDS = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const word = (n: number) => WORDS[n] ?? String(n);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const nIndex = count("index");
const nReference = count("reference");
const nRegistered = count("registered");
const referenceNames = datasets
  .filter((d) => statusOf(d.slug) === "reference")
  .map((d) => (d.slug === "ntia" ? "NTIA" : d.name));
---

<section class="w-full max-w-4xl mx-auto py-8 sm:py-12" id="datasets">
  <h2
    class="text-2xl font-bold tracking-tight text-text dark:text-text-dark mb-2"
  >
    {title}
  </h2>
  <p class="text-muted mb-3 max-w-2xl">
    {cap(word(datasets.length))} datasets are registered.{" "}
    {cap(word(nIndex))} are scored and make up the SynthBench Index
    (<b class="font-medium text-text dark:text-text-dark">{statusLabel.index}</b>).
    {
      nReference > 0 && (
        <>
          {" "}
          {referenceNames.join(" and ")}{nReference === 1 ? " is" : " are"} scored for reference
          only{referenceNames.join() === "NTIA" ? ": its questions are yes/no facts about internet use, not opinions" : ""}
          (<b class="font-medium text-text dark:text-text-dark">{statusLabel.reference}</b>).
        </>
      )
    }
    {
      nRegistered > 0 && (
        <>
          {" "}
          The other {word(nRegistered)} have adapters but no published runs yet
          (<b class="font-medium text-text dark:text-text-dark">{statusLabel.registered}</b>).
        </>
      )
    }
  </p>
  <p class="text-muted mb-6 sm:mb-8 max-w-2xl">
    Each card also shows the dataset's redistribution tier.
    <span class="font-mono">full</span> datasets ship per-question distributions
    publicly. <span class="font-mono">gated</span> datasets require a research-use
    sign-in for per-question data.
  </p>

  <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      datasets.map((d) => {
        const st = statusOf(d.slug);
        return (
          <div
            data-dataset-slug={d.slug}
            data-status={st}
            class="rounded-lg border border-muted/20 bg-surface dark:bg-surface-dark p-4 sm:p-6 flex flex-col"
          >
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <h3 class="text-lg font-semibold text-text dark:text-text-dark mr-auto lg:basis-full">
                {d.name}
              </h3>
              <span
                class:list={["text-xs px-2 py-0.5 rounded-full border", statusStyle[st]]}
              >
                {statusLabel[st]}
              </span>
              <span
                class:list={[
                  "text-xs font-mono px-2 py-0.5 rounded-full",
                  tierStyle[d.tier],
                ]}
                title={
                  d.tier === "full"
                    ? "Per-question distributions published openly"
                    : "Per-question distributions gated behind research-use sign-in"
                }
              >
                {tierLabel[d.tier]}
              </span>
            </div>

            <p class="text-sm text-muted mb-4 flex-1">{d.description}</p>

            <dl class="ds-facts space-y-2 text-sm">
              {d.questions && (
                <div>
                  <dt class="text-muted">Questions</dt>
                  <dd class="font-medium text-text dark:text-text-dark">
                    {d.questions.full.toLocaleString()}
                    {d.questions.core && (
                      <span class="text-muted font-normal">
                        {" "}
                        ({d.questions.core} core)
                      </span>
                    )}
                  </dd>
                </div>
              )}
              <div>
                <dt class="text-muted">Source</dt>
                <dd class="font-medium text-text dark:text-text-dark">{d.source}</dd>
              </div>
              <div>
                <dt class="text-muted">Scope</dt>
                <dd class="font-medium text-text dark:text-text-dark">{d.scope}</dd>
              </div>
              <div>
                <dt class="text-muted">Coverage</dt>
                <dd class="font-medium text-text dark:text-text-dark">{d.temporal}</dd>
              </div>
              <div class="ds-wide">
                <dt class="text-muted mb-0.5">Demographics</dt>
                <dd class="text-xs text-text/80 dark:text-text-dark/80">
                  {d.demographics}
                </dd>
              </div>
            </dl>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  /* Label and value on one row. Wide cards push the value right; phones put
     it in a column beside a fixed-width label, so long values wrap under
     themselves instead of ragged right. */
  .ds-facts > div:not(.ds-wide) {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .ds-facts > div:not(.ds-wide) > dd {
    text-align: right;
  }
  @media (max-width: 639px) {
    .ds-facts > div:not(.ds-wide) {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }
    .ds-facts > div:not(.ds-wide) > dd {
      text-align: left;
    }
  }
</style>
