---
// One section of the Method page: a panel with an h2, a short lede and the
// body. `fold` marks a long, secondary body: on phones it starts folded under
// the lede behind a "Read more" button (scripts/methodNav.ts). Wide screens,
// readers without JavaScript and links into the section always get it open.
// Styles: styles/sb-method.css.
interface Props {
  id: string;
  title: string;
  fold?: boolean;
  class?: string;
}
const { id, title, fold = false, class: cls } = Astro.props;
---

<section class:list={["sb-block sb-panel sb-pad sb-msec", cls]} id={id}>
  <h2 class="sb-h2">{title}</h2>
  <slot name="lede" />
  <div class="sb-msec-body" data-mfold={fold ? "" : undefined}>
    <slot />
  </div>
</section>
