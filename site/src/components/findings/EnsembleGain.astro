---
import Chart from "@/components/shared/Chart.astro";
import type { LeaderboardData } from "@/types/leaderboard";

import leaderboardRaw from "@/data/leaderboard.json";

const leaderboard = leaderboardRaw as LeaderboardData;
const ensembleData = leaderboard.findings.ensemble_comparison ?? [];

const datasets = ensembleData.map((d) => d.dataset);
const bestSingleData = ensembleData.map((d) => d.best_single_sps);
const ensembleSpsData = ensembleData.map((d) => d.ensemble_sps);

// Pre-compute improvement labels for markPoint annotations
const improvementAnnotations = ensembleData.map((d) => ({
  name: `+${(d.improvement * 100).toFixed(1)} pts`,
  coord: [d.dataset, d.ensemble_sps],
  symbolSize: 0,
  label: {
    show: true,
    formatter: "{b}",
    position: "top" as const,
    fontSize: 12,
    fontWeight: "bold" as const,
    color: "#059669",
    padding: [2, 6] as [number, number],
    backgroundColor: "rgba(255,255,255,0.85)",
    borderRadius: 3,
  },
}));

const chartOption = {
  tooltip: {
    trigger: "axis" as const,
    axisPointer: { type: "shadow" as const },
  },
  legend: {
    data: ["Best Single Model", "Ensemble"],
    top: 10,
  },
  grid: { left: 60, right: 30, top: 60, bottom: 40, containLabel: true },
  xAxis: {
    type: "category" as const,
    data: datasets,
  },
  yAxis: {
    type: "value" as const,
    name: "SPS",
    nameLocation: "middle" as const,
    nameGap: 45,
    min: 0,
    max: 1,
    axisLabel: { formatter: "{value}" },
  },
  series: [
    {
      name: "Best Single Model",
      type: "bar" as const,
      data: bestSingleData,
      itemStyle: { color: "#94a3b8" },
      barMaxWidth: 50,
      emphasis: {
        itemStyle: { shadowBlur: 10, shadowColor: "rgba(0,0,0,0.3)" },
      },
    },
    {
      name: "Ensemble",
      type: "bar" as const,
      data: ensembleSpsData,
      itemStyle: { color: "var(--color-provider-althing)" },
      barMaxWidth: 50,
      emphasis: {
        itemStyle: { shadowBlur: 10, shadowColor: "rgba(0,0,0,0.3)" },
      },
      markPoint: {
        data: improvementAnnotations,
      },
    },
  ],
  toolbox: {
    feature: { saveAsImage: { title: "Save as PNG" } },
    right: 10,
    top: 10,
  },
};

const hasData = ensembleData.length > 0;
const improvementsPts = ensembleData.map((d) => d.improvement * 100);
const gainRange = hasData
  ? `+${Math.min(...improvementsPts).toFixed(1)} to +${Math.max(...improvementsPts).toFixed(1)}`
  : "";
const comparisonSet = leaderboard.findings.comparison_sets?.ensemble_comparison ?? "";

// Error-correlation matrix between the ensemble constituents (round 3
// panel item: the "uncorrelated errors" framing needs published evidence).
const errorCorrelation = leaderboard.findings.ensemble_error_correlation ?? [];
const correlationComparisonSet =
  leaderboard.findings.comparison_sets?.ensemble_error_correlation ?? "";
const allR = errorCorrelation.flatMap((d) => d.pairs.map((p) => p.pearson_r));
const rRange =
  allR.length > 0 ? `${Math.min(...allR).toFixed(2)}–${Math.max(...allR).toFixed(2)}` : "";

// Compact model label: "Althing (Haiku 4.5)" -> "Haiku 4.5".
function shortName(name: string): string {
  const m = name.match(/\(([^)]+)\)/);
  return m ? m[1] : name;
}

// r for an unordered constituent pair, for the matrix cells.
function pairR(d: (typeof errorCorrelation)[number], a: string, b: string): number | null {
  const hit = d.pairs.find((p) => (p.a === a && p.b === b) || (p.a === b && p.b === a));
  return hit ? hit.pearson_r : null;
}
---

<section class="w-full max-w-4xl mx-auto py-8">
  <h2 class="text-2xl font-bold text-center mb-2">The Biggest Lever: Ensemble Blending</h2>
  <p class="text-center text-sm text-muted mb-6">
    For each dataset, ensemble blending of 3 models outperforms the best single
    leaderboard entry at matched question count by {gainRange} SPS points.
    The blend itself is arithmetic — no new model calls beyond the three
    constituent runs — but producing all three costs roughly 3× a
    single-model run.
  </p>
  {hasData ? (
    <Chart
      title="Ensemble Gain over Best Single Model"
      description={`Bar chart comparing the SPS of the best single model against a 3-model ensemble for each dataset. Ensemble gains range from ${gainRange} SPS points.`}
      option={chartOption}
      height="420px"
    />
  ) : (
    <div class="text-center text-muted py-12 border border-muted/20 rounded-lg">
      Ensemble comparison data not yet available.
    </div>
  )}
  {comparisonSet && (
    <p class="text-xs text-muted text-center mt-2 max-w-2xl mx-auto">
      Comparison set: {comparisonSet}
    </p>
  )}

  {errorCorrelation.length > 0 && (
    <div class="mt-10" id="ensemble-error-correlation">
      <h3 class="text-lg font-semibold text-center mb-2">
        How correlated are the constituents' errors?
      </h3>
      <p class="text-center text-sm text-muted mb-4 max-w-2xl mx-auto">
        Pairwise Pearson r between the constituent runs' per-question error
        (JSD vs the human distribution) over each ensemble's common question
        set. The constituents' errors are moderately positively correlated
        (r {rRange}) — not uncorrelated. The ensemble gain comes from partial,
        not full, independence of errors.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {errorCorrelation.map((d) => (
          <div class="rounded-lg border border-muted/20 bg-surface dark:bg-surface-dark p-4">
            <h4 class="text-sm font-semibold mb-1">{d.dataset}</h4>
            <p class="text-xs text-muted mb-3">
              n = {d.n_questions} questions · mean pairwise r ={" "}
              {d.mean_pearson_r.toFixed(2)}
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-xs">
                <caption class="sr-only">
                  Pairwise Pearson r between ensemble constituents' per-question
                  errors on {d.dataset}
                </caption>
                <thead>
                  <tr class="text-muted border-b border-muted/20">
                    <th class="py-1 pr-2 text-left font-medium" scope="col">
                      <span class="sr-only">Constituent</span>
                    </th>
                    {d.constituents.map((c) => (
                      <th class="py-1 px-2 text-right font-medium" scope="col">
                        {shortName(c)}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {d.constituents.map((rowC, i) => (
                    <tr class="border-b border-muted/10 last:border-b-0">
                      <th class="py-1 pr-2 text-left font-medium" scope="row">
                        {shortName(rowC)}
                      </th>
                      {d.constituents.map((colC, j) => (
                        <td class="py-1 px-2 text-right font-mono text-muted">
                          {i === j
                            ? "—"
                            : (pairR(d, rowC, colC)?.toFixed(3) ?? "—")}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
      {correlationComparisonSet && (
        <p class="text-xs text-muted text-center mt-3 max-w-2xl mx-auto">
          Comparison set: {correlationComparisonSet}
        </p>
      )}
    </div>
  )}
</section>
