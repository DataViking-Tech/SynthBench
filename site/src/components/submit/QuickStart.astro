---
// From install to a leaderboard listing, one step at a time. Each command
// step has exactly one command with its own Copy button (a one-line
// CodeBlock, .sb-cmdline in styles/sb-submit.css). This replaces the
// separate "Submission flow" list, which repeated these steps.
import Cmd from "@/components/shared/Cmd.astro";
import CodeBlock from "@/components/shared/CodeBlock.astro";

interface Props {
  /** Upload is configured in this build (see pages/submit.astro). */
  uploadAvailable: boolean;
  uploadHref: string;
}
const { uploadAvailable, uploadHref } = Astro.props;

const install =
  'pip install "synthbench-eval[openai] @ git+https://github.com/DataViking-Tech/SynthBench.git"';
const run = "synthbench run --dataset opinionsqa --provider your-provider";
const repo = "https://github.com/DataViking-Tech/synthbench";
---

<section class="w-full max-w-4xl mx-auto py-10 sm:py-12" id="quick-start">
  <h2 class="text-2xl font-bold tracking-tight text-text dark:text-text-dark mb-2">Quick start</h2>
  <p class="text-muted mb-6 max-w-2xl">
    Two commands to benchmark your model, then one step to submit the result.
  </p>

  <ol class="sb-qs">
    <li>
      <h3 class="text-base font-semibold text-text dark:text-text-dark">Install the CLI</h3>
      <CodeBlock code={install} what="install command" class="sb-cmdline" />
      <p class="text-sm text-muted">
        Installs the SynthBench CLI and evaluation framework from GitHub. Requires Python 3.10+. (The
        synthbench name on PyPI is an unrelated project.)
      </p>
    </li>
    <li>
      <h3 class="text-base font-semibold text-text dark:text-text-dark">Run the benchmark</h3>
      <CodeBlock code={run} what="run command" class="sb-cmdline" />
      <p class="text-sm text-muted">
        Replace <Cmd class="sb-qs-code" text="your-provider" /> with your adapter (e.g. openai, anthropic,
        openrouter). The CLI handles sampling, parsing, and metric computation, and writes a result JSON
        with per-question response distributions and aggregate scores.
      </p>
    </li>
    <li>
      <h3 class="text-base font-semibold text-text dark:text-text-dark">Submit the result JSON</h3>
      <p class="text-sm text-muted">
        {
          uploadAvailable ? (
            <>
              <a href={uploadHref} class="text-primary hover:underline dark:text-primary-light">
                Upload it
              </a>{" "}
              (sign-in required), or fork{" "}
            </>
          ) : (
            <>Fork </>
          )
        }
        <a href={`${repo}/fork`} class="text-primary hover:underline dark:text-primary-light" target="_blank" rel="noopener noreferrer"
          >DataViking-Tech/synthbench<span class="sr-only"> (opens in a new tab)</span></a
        >, copy the file into <Cmd class="sb-qs-code" text="leaderboard-results/" /> and open a pull request.
      </p>
    </li>
    <li>
      <h3 class="text-base font-semibold text-text dark:text-text-dark">Validation and listing</h3>
      <p class="text-sm text-muted">
        CI validates the JSON schema and recomputes all aggregate scores from your per-question data.
        Reported scores that don't match the recomputed ones are rejected. Once the submission is merged,
        the site rebuilds automatically and your model appears on the leaderboard.
      </p>
    </li>
  </ol>
</section>
