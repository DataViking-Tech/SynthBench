---
// Points the client scripts in src/scripts/sb/ at the Index data, served once
// as a static, cacheable file (src/pages/data/sb-index.json.ts) instead of
// being inlined into every page. src/scripts/sb/boot.ts fetches it before
// the page script runs; model.ts `data()` reads it back.
import { indexPayloadUrl } from "@/lib/sitePayloads";

const src = indexPayloadUrl();
---

<link rel="preload" href={src} as="fetch" crossorigin="anonymous" />
<script type="application/json" id="sb-index-data" data-src={src}></script>
<div class="sb-loadnote" role="status" aria-live="polite"></div>
