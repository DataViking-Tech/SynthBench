---
// Points src/scripts/sb/pages/groups.ts at the per-group match data, served
// once as a static file (src/pages/data/sb-groups.json.ts) and fetched by
// src/scripts/sb/boot.ts before the page script runs.
import { groupsPayloadUrl } from "@/lib/sitePayloads";

const src = groupsPayloadUrl();
---

<link rel="preload" href={src} as="fetch" crossorigin="anonymous" />
<script type="application/json" id="sb-group-data" data-src={src}></script>
