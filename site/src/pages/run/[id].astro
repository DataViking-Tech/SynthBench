---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import IndexScales from "@/components/sb/IndexScales.astro";
import Info from "@/components/sb/Info.astro";
import ProviderLogo from "@/components/sb/ProviderLogo.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { datasetLabel } from "@/lib/runExplorer";
import { type SystemLink, systemLinkFor } from "@/lib/systemLinks";
import { INDEX_EXPLAINER, METHOD_NAMES, datasetAudience, runSystem } from "@/lib/vocab";
import type { RunIndex, RunIndexEntry } from "@/types/runs";

export async function getStaticPaths() {
  const indexPath = resolve("public/data/runs-index.json");
  if (!existsSync(indexPath)) {
    return [];
  }
  const index = JSON.parse(readFileSync(indexPath, "utf-8")) as RunIndex;
  // Datasets with a /question/<dataset>/ index page: full-tier ones ship
  // question/<dataset>/index.json locally, gated ones list their keys in
  // gated-routes.json.
  const withQuestions = new Set<string>();
  const routesPath = resolve("public/data/gated-routes.json");
  if (existsSync(routesPath)) {
    const routes = JSON.parse(readFileSync(routesPath, "utf-8")) as {
      datasets?: Record<string, string[]>;
    };
    for (const ds of Object.keys(routes.datasets ?? {})) withQuestions.add(ds);
  }
  return index.runs.map((entry) => ({
    params: { id: entry.run_id },
    props: {
      entry,
      system: systemLinkFor(entry),
      hasQuestionIndex:
        withQuestions.has(entry.dataset) ||
        existsSync(resolve(`public/data/question/${entry.dataset}/index.json`)),
    },
  }));
}

interface Props {
  entry: RunIndexEntry;
  system: SystemLink | null;
  hasQuestionIndex: boolean;
}

const { entry, system, hasQuestionIndex } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Encode path segments for URLs — space and a few reserved chars only.
// Static hosts (and Astro preview) match filenames literally, so we must
// leave characters like `=` unescaped.
const encodePathSegment = (s: string): string =>
  s.replace(/ /g, "%20").replace(/#/g, "%23").replace(/\?/g, "%3F");

const runPath = `run/${encodePathSegment(entry.run_id)}.json`;
const configUrl = `${base}/config/${encodePathSegment(entry.config_id)}/`;
const exploreUrl = `${base}/explore/?ds=${encodeURIComponent(entry.dataset)}`;
const systemUrl = system ? `${base}/system/${system.slug}/` : null;
const questionBaseUrl = `${base}/question/${encodePathSegment(entry.dataset)}`;
const questionIndexUrl = hasQuestionIndex ? `${questionBaseUrl}/` : "";
const dsName = datasetLabel(entry.dataset);
// Canonical names (lib/vocab.ts), shared with the leaderboard and charts.
const sys = runSystem(entry);

// Public aggregates from runs-index.json. They render immediately and stay
// when the per-question artifact is gated; the run JSON (when it loads)
// replaces them with the full set including intervals.
const indexScores = JSON.stringify({
  sps: entry.sps,
  p_dist: entry.p_dist,
  p_rank: entry.p_rank,
  p_refuse: entry.p_refuse,
  jsd: entry.jsd,
  tau: entry.tau,
});
---

<BaseLayout title={`Run: ${sys.full} on ${dsName}`} noindex={true}>
  <IndexScales />
  <div
    class="run-detail mx-auto w-full max-w-6xl px-4 py-8"
    data-run-id={entry.run_id}
    data-run-path={runPath}
    data-dataset={entry.dataset}
    data-question-base={questionBaseUrl}
    data-question-index={questionIndexUrl}
    data-index-scores={indexScores}
  >
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-muted" aria-label="Breadcrumb">
      <a href={exploreUrl} class="hover:text-primary">Runs · {dsName}</a>
      {
        systemUrl && (
          <>
            <span class="mx-2">/</span>
            <a href={systemUrl} class="hover:text-primary">
              {system?.name}
            </a>
          </>
        )
      }
      <span class="mx-2">/</span>
      <a href={configUrl} class="hover:text-primary">Config</a>
      <span class="mx-2">/</span>
      <span class="text-text dark:text-text-dark">Run</span>
    </nav>

    <!-- Header (server-rendered from index entry) -->
    <header class="mb-8">
      <div class="flex flex-wrap items-baseline gap-2">
        <h1 class="flex items-center gap-2 text-2xl font-bold sm:text-3xl"><ProviderLogo of={sys.method === "ensemble" ? "ensemble" : entry.model} />{sys.full}</h1>
        {
          entry.is_ensemble && (
            <span class="rounded bg-primary/10 px-2 py-0.5 text-xs text-primary">
              ensemble
            </span>
          )
        }
        {
          entry.is_baseline && (
            <span class="rounded bg-muted/20 px-2 py-0.5 text-xs text-muted">
              baseline
            </span>
          )
        }
      </div>
      <p class="mt-1 text-sm text-muted">
        {dsName}{datasetAudience(entry.dataset) && ` · ${datasetAudience(entry.dataset)}`}
      </p>
      <p class="mt-1 break-all font-mono text-xs text-muted">{entry.run_id}</p>
    </header>

    <!-- 1. Config metadata -->
    <section class="mb-8 rounded-lg border border-muted/20 p-5">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">
        Configuration
      </h2>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3 md:grid-cols-4">
        <div>
          <dt class="text-xs text-muted">Method</dt>
          <dd>{METHOD_NAMES[sys.method].label}</dd>
        </div>
        {
          sys.harness && (
            <div>
              <dt class="text-xs text-muted">Harness</dt>
              <dd>{`via ${sys.harness}`}</dd>
            </div>
          )
        }
        <div>
          <dt class="text-xs text-muted">Base provider</dt>
          <dd class="font-mono">{entry.base_provider ?? "—"}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Model</dt>
          <dd class="font-mono">{entry.model}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Dataset</dt>
          <dd>{dsName}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Temperature</dt>
          <dd class="font-mono">{entry.temperature ?? "default"}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Reasoning effort</dt>
          <dd class="font-mono">{entry.effort ?? "default"}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Template</dt>
          <dd class="font-mono">{entry.template ?? "current"}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Samples/question</dt>
          <dd class="font-mono">{entry.samples_per_question ?? "—"}</dd>
        </div>
        <div>
          <dt class="text-xs text-muted">Timestamp</dt>
          <dd class="font-mono text-xs" data-vrt-mask>{entry.timestamp ?? "—"}</dd>
        </div>
      </dl>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
        <a href={configUrl} class="text-primary hover:underline"
          >View all replicates for this config →</a
        >
        {
          systemUrl && (
            <a href={systemUrl} class="text-primary hover:underline">
              {system?.name} profile →
            </a>
          )
        }
      </div>
    </section>

    <!-- 2. Aggregate scores -->
    <section class="mb-8">
      <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-muted">
        Aggregate scores
      </h2>
      <p class="mb-3 text-xs text-muted">
        {INDEX_EXPLAINER}
        <Info label="About the Index">
          Index = 100 × (SPS − SPS of random answers) ÷ (human ceiling − SPS of random answers), on this
          run's dataset. The leaderboard averages it over the core datasets.
        </Info>
      </p>
      <div
        id="run-scores"
        class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4"
      >
        <p class="col-span-full text-sm text-muted">Loading scores…</p>
      </div>
    </section>

    <!-- 3. Per-question table -->
    <section class="mb-8">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">
          Per-question detail
          {
            questionIndexUrl && (
              <a
                href={questionIndexUrl}
                class="ml-2 text-xs font-normal normal-case tracking-normal text-primary hover:underline"
              >
                All {dsName} questions, ranked by divergence →
              </a>
            )
          }
        </h2>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <label class="inline-flex items-center gap-1.5 text-muted" title="Rows where the model's most common answer differs from the human one">
            <input id="flipped-filter" type="checkbox" class="accent-primary" />
            Modal answer differs from human
          </label>
          <label for="topic-filter" class="text-muted">Topic:</label>
          <select
            id="topic-filter"
            class="rounded border border-muted/30 bg-surface px-2 py-1 text-sm dark:bg-surface-dark"
          >
            <option value="all">All</option>
          </select>
          <span id="row-count" class="text-xs text-muted"></span>
        </div>
      </div>

      <!-- Demographic breakdown (SubPOP only, rendered when present) -->
      <div id="run-demographic" class="mb-4 hidden"></div>

      <div class="overflow-x-auto rounded-lg border border-muted/20">
        <table class="sb-stack w-full text-sm" id="per-question-table">
          <caption class="sr-only">Per-question results for this run. Select a column header to sort; expand a row via the button in the Question column for full distribution bars.</caption>
          <thead>
            <tr class="bg-surface dark:bg-surface-dark border-b border-muted/20">
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="key" aria-sort="none"><button type="button" class="pq-sort font-semibold hover:text-primary" data-sort="key">Question</button></th>
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="topic" aria-sort="none"><button type="button" class="pq-sort font-semibold hover:text-primary" data-sort="topic">Topic</button></th>
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="model" aria-sort="none"><button type="button" class="pq-sort font-semibold hover:text-primary" data-sort="model">Model modal</button></th>
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="human" aria-sort="none"><button type="button" class="pq-sort font-semibold hover:text-primary" data-sort="human">Human modal</button></th>
              <th class="year-col hidden px-3 py-2 text-right font-semibold" scope="col" data-sort="year" aria-sort="none"><button type="button" class="pq-sort font-semibold hover:text-primary" data-sort="year">Year</button></th>
              <th class="px-3 py-2 text-right font-semibold" scope="col" data-sort="jsd" aria-sort="descending"><button type="button" class="pq-sort font-semibold hover:text-primary" data-sort="jsd" title="Distribution gap: Jensen-Shannon divergence from people's answers (lower is better)">Distribution gap <span class="font-normal text-muted">(JSD)</span></button></th>
            </tr>
          </thead>
          <tbody id="per-question-tbody">
            <tr>
              <td colspan="6" class="px-3 py-8 text-center text-muted"
                >Loading per-question detail…</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <div
      id="run-error"
      class="hidden rounded-lg border border-baseline/40 bg-baseline/5 p-4 text-sm"
    >
      <strong>Could not load run data.</strong>
      <span id="run-error-detail" class="ml-2 text-muted"></span>
    </div>
  </div>
</BaseLayout>

<script>
  import "@/scripts/stackTables";
  import {
    datasetLabel,
    modalOption,
    questionPageKeys,
    safeQuestionKey,
  } from "@/lib/runExplorer";
  import { METRIC_NAMES, datasetId, fmtIndex, readIndexScales, spsToIndex } from "@/lib/vocab";
  import { optionColor } from "@/lib/answerPalette";
  import { topicLabel } from "@/lib/topics";
  import type { PerQuestionRow, RunAggregate, RunDetail, RunScores } from "@/types/runs";

  type DemographicEntry = {
    attribute: string;
    group: string;
    p_dist: number;
    p_cond: number;
    n_questions: number;
  };
  type SortKey = "key" | "topic" | "model" | "human" | "year" | "jsd";
  type SortDir = "asc" | "desc";
  const SORT_KEYS: SortKey[] = ["key", "topic", "model", "human", "year", "jsd"];
  const defaultDir = (k: SortKey): SortDir => (k === "jsd" || k === "year" ? "desc" : "asc");

  interface PqRow {
    row: PerQuestionRow;
    topic: string;
    modelModal: string;
    humanModal: string;
    /** Model's modal answer differs from the human one (null: no human data). */
    flipped: boolean | null;
  }

  const view = {
    rows: [] as PqRow[],
    sortKey: "jsd" as SortKey,
    sortDir: "desc" as SortDir,
    topic: "all",
    flippedOnly: false,
    showYear: false,
    questionBaseUrl: "",
    pageKeys: null as Set<string> | null,
  };

  const fmt = (n: number | null | undefined, places = 3): string =>
    n == null || Number.isNaN(n) ? "—" : n.toFixed(places);

  function escapeHtml(s: unknown): string {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function renderStackedBar(
    label: string,
    dist: Record<string, number> | undefined,
    options: string[],
  ): string {
    if (!dist) return "";
    // Preserve option order; fall back to dist key order if options is empty.
    const keys = options.length ? options : Object.keys(dist);
    const segments = keys
      .map((k, i) => {
        const v = dist[k] ?? 0;
        const pct = Math.max(0, Math.min(1, v)) * 100;
        const color = optionColor(keys, i);
        const title = `${escapeHtml(k)}: ${(v * 100).toFixed(1)}%`;
        return `<span class="dist-seg" title="${title}" style="width:${pct}%;background:${color}"></span>`;
      })
      .join("");
    const accessibleSummary = keys
      .map((k) => `${k}: ${((dist[k] ?? 0) * 100).toFixed(1)}%`)
      .join(", ");
    const barLabel = `${label} distribution: ${accessibleSummary}`;
    return `
      <div class="dist-row">
        <span class="dist-label" aria-hidden="true">${escapeHtml(label)}</span>
        <span class="dist-bar" role="img" aria-label="${escapeHtml(barLabel)}">${segments}</span>
      </div>
    `;
  }

  function renderLegend(
    options: string[],
    dist: Record<string, number> | undefined,
  ): string {
    if (!dist) return "";
    const keys = options.length ? options : Object.keys(dist);
    return keys
      .map((k, i) => {
        const color = optionColor(keys, i);
        return `<span class="dist-chip"><span class="dist-swatch" style="background:${color}"></span>${escapeHtml(k)}</span>`;
      })
      .join("");
  }

  function renderScores(
    scores: RunScores,
    agg: Pick<RunAggregate, "mean_jsd" | "mean_kendall_tau" | "per_metric_ci">,
    questionIndexUrl: string,
    dataset: string,
  ): string {
    // Lead with the Index (the scale every other page uses); SPS and its parts follow.
    const scale = readIndexScales()[datasetId(dataset)];
    const ci = agg.per_metric_ci ?? {};
    const range = (...keys: string[]): [number, number] | null => {
      for (const k of keys) {
        const r = ci[k];
        if (r && r[0] != null && r[1] != null) return r;
      }
      return null;
    };
    const ciText = (r: [number, number] | null, f: (v: number) => string = (v) => fmt(v)) =>
      r ? `[${f(r[0])}, ${f(r[1])}]` : "";
    const spsCi = range("sps");
    const toIdx = (v: number) => fmtIndex(spsToIndex(v, scale));
    type Tile = [keyof typeof METRIC_NAMES, string, string];
    const tiles: Tile[] = [
      ["index", fmtIndex(spsToIndex(scores.sps, scale)), ciText(spsCi, toIdx)],
      ["sps", fmt(scores.sps), ciText(spsCi)],
      ["pDist", fmt(scores.p_dist), ciText(range("p_dist"))],
      ["pRank", fmt(scores.p_rank), ciText(range("p_rank"))],
      ["pRefuse", fmt(scores.p_refuse), ciText(range("p_refuse"))],
      ["jsd", fmt(agg.mean_jsd), ciText(range("jsd", "mean_jsd"))],
      ["tau", fmt(agg.mean_kendall_tau), ciText(range("tau", "mean_kendall_tau"))],
    ];
    if (scores.p_cond != null) tiles.push(["pCond", fmt(scores.p_cond), ciText(range("p_cond"))]);
    if (scores.p_sub != null) tiles.push(["pSub", fmt(scores.p_sub), ciText(range("p_sub"))]);

    return tiles
      .map(([key, value, ciRange]) => {
        const m = METRIC_NAMES[key];
        const label = key === "index" ? "Index" : key === "sps" ? "SPS" : m.label;
        // The distribution gap links to the dataset's question index, ranked by divergence.
        const link =
          key === "jsd" && questionIndexUrl
            ? `<a class="score-link" href="${escapeHtml(questionIndexUrl)}?sort=human">Which questions diverge most? →</a>`
            : "";
        return `
          <div class="score-tile${key === "index" ? " score-tile--lead" : ""}" title="${escapeHtml(m.desc)}">
            <div class="score-label">${escapeHtml(label)}</div>
            <div class="score-tech">${escapeHtml(m.tech)}</div>
            <div class="score-value">${escapeHtml(value)}</div>
            ${ciRange ? `<div class="score-ci">${escapeHtml(ciRange)}</div>` : ""}
            ${link}
          </div>
        `;
      })
      .join("");
  }

  function renderDemographic(
    breakdown: Record<string, DemographicEntry[]>,
  ): string {
    const attrs = Object.keys(breakdown);
    if (!attrs.length) return "";
    const sections = attrs
      .map((attr) => {
        const rows = breakdown[attr]
          .map(
            (row) => `
              <tr>
                <td class="px-3 py-1.5">${escapeHtml(row.group)}</td>
                <td class="px-3 py-1.5 text-right font-mono">${fmt(row.p_dist)}</td>
                <td class="px-3 py-1.5 text-right font-mono">${fmt(row.p_cond)}</td>
                <td class="px-3 py-1.5 text-right font-mono text-xs text-muted">${row.n_questions}</td>
              </tr>
            `,
          )
          .join("");
        return `
          <div class="mb-3">
            <h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-muted">${escapeHtml(attr)}</h3>
            <div class="overflow-x-auto rounded border border-muted/20">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-muted/20 bg-surface text-xs dark:bg-surface-dark">
                    <th class="px-3 py-1.5 text-left font-semibold" scope="col">Group</th>
                    <th class="px-3 py-1.5 text-right font-semibold" scope="col">Shares match <span class="font-normal text-muted">(p_dist)</span></th>
                    <th class="px-3 py-1.5 text-right font-semibold" scope="col">Persona effect <span class="font-normal text-muted">(p_cond)</span></th>
                    <th class="px-3 py-1.5 text-right font-semibold" scope="col">N</th>
                  </tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            </div>
          </div>
        `;
      })
      .join("");
    return `
      <details class="rounded-lg border border-muted/20 p-4" open>
        <summary class="cursor-pointer text-sm font-semibold">Demographic breakdown</summary>
        <div class="mt-3">${sections}</div>
      </details>
    `;
  }

  function sortValue(r: PqRow, k: SortKey): string | number | null {
    switch (k) {
      case "key":
        return r.row.key;
      case "topic":
        return r.topic === "—" ? null : topicLabel(r.topic);
      case "model":
        return r.modelModal;
      case "human":
        return r.humanModal === "—" ? null : r.humanModal;
      case "year":
        return r.row.temporal_year || null;
      case "jsd":
        return typeof r.row.jsd === "number" ? r.row.jsd : null;
    }
  }

  function visibleRows(): PqRow[] {
    const mult = view.sortDir === "asc" ? 1 : -1;
    return view.rows
      .filter((r) => view.topic === "all" || r.topic === view.topic)
      .filter((r) => !view.flippedOnly || r.flipped === true)
      .sort((a, b) => {
        const x = sortValue(a, view.sortKey);
        const y = sortValue(b, view.sortKey);
        if (x == null && y == null) return 0;
        if (x == null) return 1;
        if (y == null) return -1;
        const c =
          typeof x === "number" && typeof y === "number"
            ? x - y
            : String(x).localeCompare(String(y), undefined, { numeric: true });
        return c * mult;
      });
  }

  function rowHtml(r: PqRow): string {
    const { row } = r;
    const yearCell = view.showYear
      ? `<td class="px-3 py-2 text-right font-mono text-xs">${row.temporal_year ? String(row.temporal_year) : "—"}</td>`
      : "";
    const detailId = `pq-detail-${safeQuestionKey(row.key)}`;
    const safeKey = safeQuestionKey(row.key);
    const hasPage = view.questionBaseUrl && (!view.pageKeys || view.pageKeys.has(safeKey));
    const flipMark =
      r.flipped === true
        ? ` <span class="sb-warn" title="Differs from the human modal answer">≠</span>`
        : "";
    return `
      <tr class="pq-row border-b border-muted/10 hover:bg-primary/5" data-key="${escapeHtml(row.key)}" data-topic="${escapeHtml(r.topic)}">
        <td class="px-3 py-2">
          <button type="button" class="pq-expand flex items-start gap-2 text-left"
                  aria-expanded="false"
                  aria-controls="${detailId}"
                  aria-label="Show full distribution for question ${escapeHtml(row.key)}">
            <span class="pq-caret mt-0.5 text-xs text-muted" aria-hidden="true">▸</span>
            <span>
              <span class="pq-key font-mono text-xs text-muted block">${escapeHtml(row.key)}</span>
              <span class="pq-text block max-w-xl text-xs text-muted">${escapeHtml(row.text ?? "")}</span>
            </span>
          </button>
        </td>
        <td class="px-3 py-2 text-xs">${escapeHtml(topicLabel(r.topic) || "—")}</td>
        <td class="px-3 py-2 text-xs">${escapeHtml(r.modelModal)}${flipMark}</td>
        <td class="px-3 py-2 text-xs">${escapeHtml(r.humanModal)}</td>
        ${yearCell}
        <td class="px-3 py-2 text-right font-mono">${fmt(row.jsd)}</td>
      </tr>
      <tr id="${detailId}" class="pq-detail hidden border-b border-muted/10 bg-surface/50 dark:bg-surface-dark/50" data-topic="${escapeHtml(r.topic)}">
        <td colspan="6" class="px-4 py-4">
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2 text-sm">
            <div>
              <strong>Question:</strong>
              <span class="ml-1">${escapeHtml(row.text ?? "")}</span>
            </div>
            ${
              hasPage
                ? `<a href="${view.questionBaseUrl}/${safeKey}/"
                      class="pq-compare shrink-0 text-xs text-primary hover:underline"
                      aria-label="Compare all models on question ${escapeHtml(row.key)}">
                    Compare across models →
                  </a>`
                : ""
            }
          </div>
          <div class="mb-2 text-xs text-muted">
            N samples: <span class="font-mono">${row.n_samples ?? "—"}</span>
            · JSD: <span class="font-mono">${fmt(row.jsd)}</span>
            · τ: <span class="font-mono">${fmt(row.kendall_tau)}</span>
            · parity: <span class="font-mono">${fmt(row.parity)}</span>
            ${row.temporal_year ? `· year: <span class="font-mono">${row.temporal_year}</span>` : ""}
          </div>
          <div class="dist-legend">${renderLegend(row.options ?? [], row.human_distribution ?? row.model_distribution)}</div>
          <div class="dist-stack">
            ${
              row.human_distribution
                ? renderStackedBar("Human", row.human_distribution, row.options ?? [])
                : `<div class="dist-row"><span class="dist-label">Human</span><span class="text-xs text-muted">not published for this question (private holdout or dataset license)</span></div>`
            }
            ${renderStackedBar("Model", row.model_distribution, row.options ?? [])}
          </div>
        </td>
      </tr>
    `;
  }

  function renderTable(): void {
    const tbody = document.getElementById("per-question-tbody");
    if (!tbody) return;
    const rows = visibleRows();
    tbody.innerHTML = rows.length
      ? rows.map(rowHtml).join("")
      : `<tr><td colspan="6" class="px-3 py-8 text-center text-muted">${
          view.rows.length ? "No questions match the current filters." : "No per-question data available."
        }</td></tr>`;
    const counter = document.getElementById("row-count");
    if (counter) {
      const flipped = view.rows.filter((r) => r.flipped === true).length;
      const hasHuman = view.rows.some((r) => r.flipped != null);
      counter.textContent = `${rows.length} row${rows.length === 1 ? "" : "s"}${hasHuman ? ` · ${flipped} differ from human` : ""}`;
    }
    for (const th of document.querySelectorAll<HTMLElement>("#per-question-table thead th[data-sort]")) {
      const active = th.dataset.sort === view.sortKey;
      th.setAttribute(
        "aria-sort",
        active ? (view.sortDir === "asc" ? "ascending" : "descending") : "none",
      );
      const btn = th.querySelector<HTMLButtonElement>("button");
      btn?.querySelector(".sort-arrow")?.remove();
      if (btn && active) {
        const arrow = document.createElement("span");
        arrow.className = "sort-arrow ml-1 text-xs";
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = view.sortDir === "asc" ? "▲" : "▼";
        btn.appendChild(arrow);
      }
    }
  }

  function readUrl(): void {
    const p = new URLSearchParams(location.search);
    const k = p.get("sort") as SortKey | null;
    view.sortKey = k && SORT_KEYS.includes(k) ? k : "jsd";
    const d = p.get("dir");
    view.sortDir = d === "asc" || d === "desc" ? d : defaultDir(view.sortKey);
    view.topic = p.get("topic") ?? "all";
    view.flippedOnly = p.get("flipped") === "1";
  }

  function writeUrl(): void {
    const p = new URLSearchParams();
    if (view.topic !== "all") p.set("topic", view.topic);
    if (view.flippedOnly) p.set("flipped", "1");
    if (view.sortKey !== "jsd") p.set("sort", view.sortKey);
    if (view.sortDir !== defaultDir(view.sortKey)) p.set("dir", view.sortDir);
    const qs = p.toString();
    history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`);
  }

  function update(): void {
    renderTable();
    writeUrl();
  }

  function wireControls(): void {
    const select = document.getElementById("topic-filter") as HTMLSelectElement | null;
    if (select) {
      const topics = new Set(view.rows.map((r) => r.topic).filter((t) => t !== "—"));
      for (const t of [...topics].sort()) {
        const opt = document.createElement("option");
        opt.value = t;
        opt.textContent = topicLabel(t);
        select.appendChild(opt);
      }
      if (view.topic !== "all" && !topics.has(view.topic)) view.topic = "all";
      select.value = view.topic;
      select.addEventListener("change", () => {
        view.topic = select.value;
        update();
      });
    }
    const flipped = document.getElementById("flipped-filter") as HTMLInputElement | null;
    if (flipped) {
      const hasHuman = view.rows.some((r) => r.flipped != null);
      flipped.disabled = !hasHuman;
      if (!hasHuman) view.flippedOnly = false;
      flipped.checked = view.flippedOnly;
      flipped.addEventListener("change", () => {
        view.flippedOnly = flipped.checked;
        update();
      });
    }
    for (const btn of document.querySelectorAll<HTMLButtonElement>("#per-question-table button.pq-sort")) {
      btn.addEventListener("click", () => {
        const k = btn.dataset.sort as SortKey;
        if (view.sortKey === k) view.sortDir = view.sortDir === "asc" ? "desc" : "asc";
        else {
          view.sortKey = k;
          view.sortDir = defaultDir(k);
        }
        update();
      });
    }
  }

  function wireRowExpansion(): void {
    const tbody = document.getElementById("per-question-tbody");
    if (!tbody) return;
    tbody.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest<HTMLButtonElement>("button.pq-expand");
      if (!btn) return;
      const controls = btn.getAttribute("aria-controls");
      if (!controls) return;
      const detail = document.getElementById(controls);
      if (!detail) return;
      const expanded = btn.getAttribute("aria-expanded") === "true";
      const next = !expanded;
      btn.setAttribute("aria-expanded", String(next));
      detail.classList.toggle("hidden", !next);
      const caret = btn.querySelector(".pq-caret");
      if (caret) caret.textContent = next ? "▾" : "▸";
    });
  }

  function disableTableControls(): void {
    for (const id of ["flipped-filter", "topic-filter"]) {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.disabled = true;
    }
  }

  function showError(message: string): void {
    const tbody = document.getElementById("per-question-tbody");
    if (tbody) tbody.innerHTML = "";
    const box = document.getElementById("run-error");
    const detail = document.getElementById("run-error-detail");
    if (box) box.classList.remove("hidden");
    if (detail) detail.textContent = message;
  }

  async function loadRun(): Promise<void> {
    const root = document.querySelector<HTMLElement>(".run-detail");
    if (!root) return;
    const runPath = root.dataset.runPath;
    const dataset = root.dataset.dataset ?? "";
    const questionIndexUrl = root.dataset.questionIndex ?? "";
    view.questionBaseUrl = root.dataset.questionBase ?? "";
    readUrl();

    // Public aggregates (runs-index) render first and survive a gate.
    const scoresEl = document.getElementById("run-scores");
    try {
      const s = JSON.parse(root.dataset.indexScores ?? "{}") as Record<string, number | null>;
      if (scoresEl) {
        scoresEl.innerHTML = renderScores(
          { sps: s.sps, p_dist: s.p_dist, p_rank: s.p_rank, p_refuse: s.p_refuse },
          { mean_jsd: s.jsd, mean_kendall_tau: s.tau, per_metric_ci: null },
          questionIndexUrl,
          dataset,
        );
      }
    } catch {
      // Leave the loading text; the run JSON below may still fill it.
    }
    if (!runPath) {
      showError("Missing data URL.");
      return;
    }

    // Resolve the dataset's redistribution tier from the leaderboard
    // policy manifest so we can route gated-tier fetches through the
    // Worker proxy with a Supabase JWT. Leaderboard.json is always local
    // and carries `dataset_policies` for every dataset.
    const { fetchTieredJson, lookupDatasetTier, renderSignInGate } =
      await import("@/lib/dataFetch");
    const baseUrl = import.meta.env.BASE_URL || "/";
    const normalizedBase = baseUrl.endsWith("/")
      ? baseUrl.slice(0, -1)
      : baseUrl;
    let tier: ReturnType<typeof lookupDatasetTier> = "unknown";
    try {
      const lbRes = await fetch(`${normalizedBase}/data/leaderboard.json`);
      if (lbRes.ok) {
        const lb = (await lbRes.json()) as {
          dataset_policies?: Parameters<typeof lookupDatasetTier>[1];
        };
        tier = lookupDatasetTier(dataset, lb.dataset_policies ?? null);
      }
    } catch {
      tier = "unknown";
    }

    try {
      const [result, pageKeys] = await Promise.all([
        fetchTieredJson<RunDetail>(runPath, tier),
        questionPageKeys(normalizedBase, dataset),
      ]);
      view.pageKeys = pageKeys;
      if (!result.ok) {
        disableTableControls();
        const tbody = document.getElementById("per-question-tbody");
        if (result.gated) {
          // Only the per-question detail is gated; the aggregate tiles above
          // come from the public runs index and stay.
          if (tbody) {
            tbody.innerHTML = `<tr><td colspan="6" class="px-3 py-4"><div id="pq-gate"></div></td></tr>`;
            const gate = document.getElementById("pq-gate");
            if (gate) renderSignInGate(gate, { datasetLabel: datasetLabel(dataset) });
          }
          return;
        }
        showError(result.message);
        return;
      }
      const detail = result.data;

      if (scoresEl) {
        scoresEl.innerHTML = renderScores(detail.scores, detail.aggregate, questionIndexUrl, dataset);
      }

      // Demographic breakdown (SubPOP) — conditional
      if (detail.demographic_breakdown && Object.keys(detail.demographic_breakdown).length) {
        const demo = document.getElementById("run-demographic");
        if (demo) {
          demo.innerHTML = renderDemographic(detail.demographic_breakdown);
          demo.classList.remove("hidden");
        }
      }

      // Year column — conditional (shown if any row has a non-zero temporal_year)
      const rows = detail.per_question ?? [];
      view.showYear = rows.some((r) => r.temporal_year != null && r.temporal_year !== 0);
      if (view.showYear) {
        for (const th of document.querySelectorAll<HTMLElement>(".year-col")) {
          th.classList.remove("hidden");
        }
      } else if (view.sortKey === "year") {
        view.sortKey = "jsd";
        view.sortDir = "desc";
      }

      view.rows = rows.map((row) => {
        const modelModal = modalOption(row.model_distribution);
        const hasHuman =
          row.human_distribution != null && Object.keys(row.human_distribution).length > 0;
        const humanModal = hasHuman ? modalOption(row.human_distribution) : "—";
        return {
          row,
          topic: typeof row.topic === "string" && row.topic ? row.topic : "—",
          modelModal,
          humanModal,
          flipped: hasHuman ? modelModal !== humanModal : null,
        };
      });
      wireControls();
      wireRowExpansion();
      update();
    } catch (err) {
      showError(err instanceof Error ? err.message : String(err));
    }
  }

  loadRun();
</script>

<style is:global>
  /* Scoped styles do not reach elements inserted via innerHTML from the client
     script below (Astro hashes the selectors with data-astro-cid-* attributes
     that our JS-built nodes lack). These rules must be global so the
     per-question detail bars, score tiles, and legend render at all. */
  .score-tile {
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklch, var(--color-muted) 25%, transparent);
    background: color-mix(in oklch, var(--color-surface) 60%, transparent);
  }
  /* `--color-surface` is the LIGHT-mode token and is not flipped in
     dark mode (the body uses Tailwind's `dark:bg-surface-dark` instead).
     Without this override the tile renders translucent-white over the dark
     page background, which collides with the lifted `--color-muted-dark`
     label color and produces grey-on-grey text (sb-ave). */
  @media (prefers-color-scheme: dark) {
    .score-tile {
      background: color-mix(in oklch, var(--color-surface-dark) 70%, transparent);
      border-color: color-mix(in oklch, var(--color-muted) 35%, transparent);
    }
  }
  /* No text-transform: labels may hold τ, which upper-cases to a T-like Τ. */
  .score-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .score-tech {
    font-size: 0.65rem;
    color: var(--color-muted);
  }
  .score-tile--lead {
    border-color: color-mix(in oklch, var(--color-primary) 45%, transparent);
  }
  .score-value {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }
  .score-ci {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }
  .score-link {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.7rem;
    color: var(--color-primary);
  }
  .score-link:hover {
    text-decoration: underline;
  }
  #per-question-table thead th[data-sort] button {
    display: inline-flex;
    align-items: center;
  }
  .dist-stack {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .dist-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
    gap: 0.5rem;
  }
  .dist-label {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .dist-bar {
    display: flex;
    width: 100%;
    height: 1rem;
    overflow: hidden;
    border-radius: 0.25rem;
    background: color-mix(in oklch, var(--color-muted) 15%, transparent);
  }
  .dist-seg {
    display: block;
    height: 100%;
  }
  .dist-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.7rem;
    color: var(--color-muted);
    margin-bottom: 0.35rem;
  }
  .dist-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .dist-swatch {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 0.125rem;
  }
  /* Phones: no text under 12px. */
  @media (max-width: 639px) {
    .score-tech,
    .score-ci,
    .score-link,
    .dist-legend {
      font-size: 0.75rem;
    }
  }
</style>
