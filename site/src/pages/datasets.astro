---
import DatasetCards from "@/components/methodology/DatasetCards.astro";
import DatasetPolicyTable from "@/components/methodology/DatasetPolicyTable.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<BaseLayout title="Datasets - SynthBench">
  <div class="py-12 text-center">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Datasets</h1>
    <p class="mt-3 text-lg text-muted max-w-2xl mx-auto">
      The real human survey datasets SynthBench validates against — sources,
      coverage, demographics, and redistribution policy for each.
    </p>
  </div>

  <DatasetCards />

  <DatasetPolicyTable />

  <section class="w-full max-w-4xl mx-auto py-8">
    <p class="text-sm text-muted">
      For how these datasets are scored — metrics, baselines, the private
      holdout split, and anti-gaming defences — see the{" "}
      <a
        href={`${base}methodology/`}
        class="text-primary dark:text-primary-light underline underline-offset-2 hover:no-underline"
        >methodology page</a
      >.
    </p>
  </section>
</BaseLayout>
