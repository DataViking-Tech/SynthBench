---
import IndexScales from "@/components/sb/IndexScales.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { INDEX_EXPLAINER } from "@/lib/vocab";

const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "");
const exploreUrl = `${base}/explore/`;
const selectCls =
  "w-full rounded-md border border-muted/30 bg-surface dark:bg-surface-dark px-2 py-1.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary";
const labelCls = "text-xs font-semibold uppercase tracking-wide text-muted";
---

<BaseLayout title="Compare runs">
  <IndexScales />
  <div class="mx-auto w-full max-w-6xl px-4 py-8" id="compare-root" data-base={base}>
    <!-- Breadcrumb -->
    <nav class="mb-4 text-sm text-muted" aria-label="Breadcrumb">
      <a class="hover:underline" href={exploreUrl} id="crumb-explore">Runs</a>
      <span class="mx-2">/</span>
      <span>Compare</span>
    </nav>

    <!-- Header -->
    <header class="mb-5">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Compare runs</h1>
      <p class="mt-1 text-sm text-muted">
        Two configurations (or two single runs) on the same dataset, question by question. The
        hero view is <strong>flipped questions</strong>: where A and B give different most-common
        answers.
      </p>
    </header>

    <!-- Pickers: scoped to one dataset so A and B always share questions. -->
    <section
      id="compare-pickers"
      aria-label="Choose what to compare"
      class="mb-6 grid grid-cols-1 gap-3 rounded-lg border border-muted/20 bg-surface dark:bg-surface-dark p-4 sm:grid-cols-2 lg:grid-cols-[auto_minmax(0,0.8fr)_minmax(0,1.5fr)_auto_minmax(0,1.5fr)]"
    >
      <div class="flex flex-col gap-1">
        <span id="pick-mode-label" class={labelCls}>Compare</span>
        <div
          id="pick-mode"
          role="radiogroup"
          aria-labelledby="pick-mode-label"
          class="inline-flex overflow-hidden rounded-md border border-muted/30"
        >
          <button type="button" role="radio" data-mode="config" class="px-3 py-1.5 text-sm"
            >Configs</button
          >
          <button type="button" role="radio" data-mode="run" class="px-3 py-1.5 text-sm"
            >Runs</button
          >
        </div>
      </div>
      <div class="flex flex-col gap-1">
        <label for="pick-dataset" class={labelCls}>Dataset</label>
        <select id="pick-dataset" class={selectCls}></select>
      </div>
      <div class="flex flex-col gap-1">
        <label for="pick-a" class={labelCls}>A</label>
        <select id="pick-a" class={selectCls}></select>
      </div>
      <div class="flex items-end">
        <button
          id="pick-swap"
          type="button"
          class="rounded-md border border-muted/30 px-2 py-1.5 text-sm hover:bg-muted/10"
          aria-label="Swap A and B"
          title="Swap A and B">⇄</button
        >
      </div>
      <div class="flex flex-col gap-1">
        <label for="pick-b" class={labelCls}>B</label>
        <select id="pick-b" class={selectCls}></select>
      </div>
    </section>

    <!-- Error box -->
    <div
      id="compare-error"
      class="mb-6 hidden rounded-lg border border-baseline/40 bg-baseline/5 p-4 text-sm"
      role="alert"
    >
      <strong id="compare-error-title">Could not load comparison.</strong>
      <span id="compare-error-detail" class="ml-2 text-muted"></span>
    </div>

    <!-- Empty state -->
    <div
      id="compare-empty"
      class="mb-6 hidden rounded-lg border border-muted/20 p-6 text-center text-sm text-muted"
    >
      Pick A and B above, or tick two rows in
      <a class="text-primary hover:underline" href={exploreUrl}>Runs</a>.
    </div>

    <!-- Subject chips (A / B) -->
    <section class="mb-6 hidden grid-cols-1 gap-3 sm:grid-cols-2" id="subject-chips">
      {
        (["a", "b"] as const).map((side) => (
          <div class="rounded-lg border border-muted/20 bg-surface/60 dark:bg-surface-dark/60 p-3 text-sm">
            <div class="mb-1 text-xs uppercase tracking-wide text-muted">
              Subject {side.toUpperCase()}
            </div>
            <div class="font-semibold break-words" data-field={`${side}-title`}>—</div>
            <div class="mt-0.5 text-xs text-muted" data-field={`${side}-meta`} />
            <div class="mt-0.5 font-mono text-[11px] text-muted break-all" data-field={`${side}-id`} />
            <a
              class="mt-1 inline-block text-xs text-primary hover:underline"
              data-field={`${side}-link`}
              href={exploreUrl}
            >
              Open detail →
            </a>
          </div>
        ))
      }
    </section>

    <!-- Section 1: metric tiles -->
    <section id="compare-metrics-wrap" class="mb-8 hidden">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted">Metrics</h2>
      <p class="mb-1 text-xs text-muted">{INDEX_EXPLAINER}</p>
      <p id="compare-metrics-note" class="mb-3 text-xs text-muted"></p>
      <div id="compare-metrics" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
    </section>

    <!-- Section 2: flipped questions table -->
    <section id="compare-flipped-wrap" class="mb-8 hidden">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">
          Flipped questions
        </h2>
        <div class="flex items-center gap-3 text-xs text-muted">
          <span id="flipped-count"></span>
          <label class="flex items-center gap-1">
            <input id="flipped-only" type="checkbox" class="accent-primary" />
            Flipped only
          </label>
        </div>
      </div>

      <div
        id="flipped-note"
        class="mb-3 hidden rounded border border-muted/20 bg-surface/40 dark:bg-surface-dark/40 p-2 text-xs text-muted"
      >
      </div>

      <div id="flipped-gate" class="hidden"></div>

      <div class="overflow-x-auto rounded-lg border border-muted/20" id="flipped-table-wrap">
        <table class="sb-stack w-full text-sm" id="flipped-table">
          <caption class="sr-only">Per-question comparison of A versus B. Select a column header to sort; expand a row with its question button for full distributions.</caption>
          <thead>
            <tr class="border-b border-muted/20 bg-surface dark:bg-surface-dark">
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="question" aria-sort="none"><button type="button" class="font-semibold hover:text-primary" data-sort="question">Question</button></th>
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="topic" aria-sort="none"><button type="button" class="font-semibold hover:text-primary" data-sort="topic">Topic</button></th>
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="human_modal" aria-sort="none"><button type="button" class="font-semibold hover:text-primary" data-sort="human_modal">Human modal</button></th>
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="a_modal" aria-sort="none"><button type="button" class="font-semibold hover:text-primary" data-sort="a_modal">A modal</button></th>
              <th class="px-3 py-2 text-left font-semibold" scope="col" data-sort="b_modal" aria-sort="none"><button type="button" class="font-semibold hover:text-primary" data-sort="b_modal">B modal</button></th>
              <th class="px-3 py-2 text-right font-semibold" scope="col" data-sort="a_jsd" aria-sort="none"><button type="button" class="font-semibold hover:text-primary" data-sort="a_jsd" title="Distribution gap: Jensen-Shannon divergence from people's answers (lower is better)">JSD A</button></th>
              <th class="px-3 py-2 text-right font-semibold" scope="col" data-sort="b_jsd" aria-sort="none"><button type="button" class="font-semibold hover:text-primary" data-sort="b_jsd" title="Distribution gap: Jensen-Shannon divergence from people's answers (lower is better)">JSD B</button></th>
              <th class="px-3 py-2 text-right font-semibold" scope="col" data-sort="delta_jsd" aria-sort="descending"><button type="button" class="font-semibold hover:text-primary" data-sort="delta_jsd" title="JSD A − JSD B; sorted by size">ΔJSD</button></th>
              <th class="px-3 py-2 text-center font-semibold" scope="col" data-sort="flip" aria-sort="none"><button type="button" class="font-semibold hover:text-primary" data-sort="flip">Flip</button></th>
            </tr>
          </thead>
          <tbody id="flipped-tbody">
            <tr>
              <td colspan="9" class="px-3 py-8 text-center text-muted">Loading comparison…</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import "@/scripts/stackTables";
  import {
    datasetLabel,
    methodName,
    modalOption,
    questionPageKeys,
    replicateStats,
    safeQuestionKey,
    settingsLabel,
    systemName,
  } from "@/lib/runExplorer";
  import {
    METRIC_NAMES,
    datasetId,
    fmtIndex,
    readIndexScales,
    spsToIndex,
  } from "@/lib/vocab";
  import { topicLabel } from "@/lib/topics";
  import type { DatasetPolicyEntry } from "@/types/leaderboard";
  import type { PerQuestionRow, RunDetail, RunIndex, RunIndexEntry } from "@/types/runs";

  type Mode = "config" | "run";
  type DataFetchModule = typeof import("@/lib/dataFetch");

  interface CiRange {
    low: number;
    high: number;
  }
  interface MetricValue {
    value: number | null;
    ci: CiRange | null;
  }
  interface SubjectMetrics {
    sps: MetricValue;
    jsd: MetricValue;
    tau: MetricValue;
  }

  /** A config (all its replicates) or a single run, resolved from the public index. */
  interface Subject {
    id: string;
    head: RunIndexEntry;
    runs: RunIndexEntry[];
    title: string;
    meta: string;
    detailUrl: string;
    metrics: SubjectMetrics;
    /** Why no interval is drawn, when there isn't one. */
    ciNote: string | null;
  }

  /** One question, averaged over a subject's replicates. */
  interface QuestionAgg {
    key: string;
    text: string;
    topic: string;
    options: string[];
    human: Record<string, number> | null;
    dist: Record<string, number>;
    jsd: number | null;
    nReplicates: number;
  }

  interface FlippedRow {
    key: string;
    topic: string;
    text: string;
    options: string[];
    a: { modal: string; jsd: number | null; dist: Record<string, number> };
    b: { modal: string; jsd: number | null; dist: Record<string, number> };
    humanDist: Record<string, number> | null;
    humanModal: string;
    deltaJsd: number | null;
    flip: boolean;
  }

  type SortKey =
    | "question"
    | "topic"
    | "human_modal"
    | "a_modal"
    | "b_modal"
    | "a_jsd"
    | "b_jsd"
    | "delta_jsd"
    | "flip";
  type SortDir = "asc" | "desc";
  const SORT_KEYS: SortKey[] = [
    "question",
    "topic",
    "human_modal",
    "a_modal",
    "b_modal",
    "a_jsd",
    "b_jsd",
    "delta_jsd",
    "flip",
  ];
  const NUMERIC: SortKey[] = ["a_jsd", "b_jsd", "delta_jsd", "flip"];
  const defaultDir = (k: SortKey): SortDir => (NUMERIC.includes(k) ? "desc" : "asc");

  const fmt = (n: number | null | undefined, places = 3): string =>
    n == null || Number.isNaN(n) ? "—" : n.toFixed(places);

  const fmtSigned = (n: number | null | undefined, places = 3): string => {
    if (n == null || Number.isNaN(n)) return "—";
    if (n > 0) return `+${n.toFixed(places)}`;
    return n.toFixed(places);
  };

  function escapeHtml(s: unknown): string {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function ciOverlap(a: CiRange | null, b: CiRange | null): "overlap" | "disjoint" | "unknown" {
    if (!a || !b) return "unknown";
    // Overlap if the max of the lows is <= the min of the highs.
    const lo = Math.max(a.low, b.low);
    const hi = Math.min(a.high, b.high);
    return lo <= hi ? "overlap" : "disjoint";
  }

  /** The SPS metric on the dataset's Index scale (lib/vocab.ts), interval included. */
  function indexMetric(sps: MetricValue, dataset: string): MetricValue {
    const scale = readIndexScales()[datasetId(dataset)];
    const lo = sps.ci ? spsToIndex(sps.ci.low, scale) : null;
    const hi = sps.ci ? spsToIndex(sps.ci.high, scale) : null;
    return {
      value: spsToIndex(sps.value, scale),
      ci: lo != null && hi != null ? { low: lo, high: hi } : null,
    };
  }
  const idxOf = (sps: number | null | undefined, dataset: string) =>
    fmtIndex(spsToIndex(sps, readIndexScales()[datasetId(dataset)]));

  function ciFromPair(range: [number, number] | undefined | null): CiRange | null {
    if (!range) return null;
    const [low, high] = range;
    if (low == null || high == null || Number.isNaN(low) || Number.isNaN(high)) return null;
    return { low, high };
  }

  /** Distribution bar palette (keyed by index, cycles on reuse).
   *  Matches the run detail page so colors are consistent across views. */
  const BAR_COLORS = [
    "var(--color-primary)",
    "var(--color-accent)",
    "var(--color-provider-raw-llm)",
    "var(--color-baseline)",
    "var(--color-provider-althing)",
    "var(--color-muted)",
  ];

  function renderStackedBar(
    label: string,
    dist: Record<string, number> | null | undefined,
    options: string[],
  ): string {
    if (!dist || !Object.keys(dist).length) return "";
    const keys = options.length ? options : Object.keys(dist);
    const segments = keys
      .map((k, i) => {
        const v = dist[k] ?? 0;
        const pct = Math.max(0, Math.min(1, v)) * 100;
        const color = BAR_COLORS[i % BAR_COLORS.length];
        const title = `${escapeHtml(k)}: ${(v * 100).toFixed(1)}%`;
        return `<span class="dist-seg" title="${title}" style="width:${pct}%;background:${color}"></span>`;
      })
      .join("");
    // Accessible text equivalent for screen readers and keyboard users —
    // the `title` tooltips above are not reachable without a mouse.
    const accessibleSummary = keys
      .map((k) => `${k}: ${((dist[k] ?? 0) * 100).toFixed(1)}%`)
      .join(", ");
    const barLabel = `${label} distribution: ${accessibleSummary}`;
    return `
      <div class="dist-row">
        <span class="dist-label" aria-hidden="true">${escapeHtml(label)}</span>
        <span class="dist-bar" role="img" aria-label="${escapeHtml(barLabel)}">${segments}</span>
      </div>
    `;
  }

  function renderLegend(options: string[], dist: Record<string, number> | null): string {
    const keys = options.length ? options : Object.keys(dist ?? {});
    return keys
      .map((k, i) => {
        const color = BAR_COLORS[i % BAR_COLORS.length];
        return `<span class="dist-chip"><span class="dist-swatch" style="background:${color}"></span>${escapeHtml(k)}</span>`;
      })
      .join("");
  }

  /** Page state; the URL mirrors mode, a, b, ds, sort, dir and flipped. */
  const state = {
    base: "/",
    mode: "config" as Mode,
    dataset: "",
    aId: "",
    bId: "",
    rows: [] as FlippedRow[],
    sortKey: "delta_jsd" as SortKey,
    sortDir: "desc" as SortDir,
    flippedOnly: false,
    index: [] as RunIndexEntry[],
    policies: null as DatasetPolicyEntry[] | null,
    pageKeys: null as Set<string> | null,
    /** Bumped on every load so a slow earlier fetch can't overwrite a newer one. */
    generation: 0,
  };
  let dataFetch: DataFetchModule;

  const $ = <T extends HTMLElement>(id: string): T | null =>
    document.getElementById(id) as T | null;

  // ---------- URL ----------

  function readUrl(): void {
    const qs = new URLSearchParams(window.location.search);
    state.aId = qs.get("a") ?? "";
    state.bId = qs.get("b") ?? "";
    state.mode = (qs.get("mode") ?? "config").toLowerCase() === "run" ? "run" : "config";
    state.dataset = qs.get("ds") ?? "";
    const sort = qs.get("sort") as SortKey | null;
    state.sortKey = sort && SORT_KEYS.includes(sort) ? sort : "delta_jsd";
    const dir = qs.get("dir");
    state.sortDir = dir === "asc" || dir === "desc" ? dir : defaultDir(state.sortKey);
    state.flippedOnly = qs.get("flipped") === "1";
  }

  function writeUrl(): void {
    const p = new URLSearchParams();
    if (state.aId) p.set("a", state.aId);
    if (state.bId) p.set("b", state.bId);
    p.set("mode", state.mode);
    // The dataset follows from A or B; keep it only when neither is set.
    if (!state.aId && !state.bId && state.dataset) p.set("ds", state.dataset);
    if (state.sortKey !== "delta_jsd") p.set("sort", state.sortKey);
    if (state.sortDir !== defaultDir(state.sortKey)) p.set("dir", state.sortDir);
    if (state.flippedOnly) p.set("flipped", "1");
    history.replaceState(null, "", `${window.location.pathname}?${p.toString()}`);
  }

  // ---------- Subjects from the public index ----------

  const runsOf = (mode: Mode, id: string): RunIndexEntry[] =>
    state.index.filter((r) => (mode === "config" ? r.config_id === id : r.run_id === id));

  function buildSubject(mode: Mode, id: string): Subject | null {
    const runs = runsOf(mode, id).sort((x, y) =>
      (x.timestamp ?? "").localeCompare(y.timestamp ?? ""),
    );
    if (!runs.length) return null;
    const head = runs[0];
    const enc = encodeURIComponent(id);
    const n = runs.length;
    let metrics: SubjectMetrics;
    let ciNote: string | null = null;
    if (mode === "config") {
      const sps = replicateStats(runs.map((r) => r.sps));
      const jsd = replicateStats(runs.map((r) => r.jsd));
      const tau = replicateStats(runs.map((r) => r.tau));
      metrics = {
        sps: { value: sps.mean, ci: sps.ci },
        jsd: { value: jsd.mean, ci: jsd.ci },
        tau: { value: tau.mean, ci: tau.ci },
      };
      if (!sps.ci) ciNote = n === 1 ? "1 replicate: no interval" : `n=${n} replicates: too few for an interval`;
    } else {
      metrics = {
        sps: { value: head.sps, ci: null },
        jsd: { value: head.jsd, ci: null },
        tau: { value: head.tau, ci: null },
      };
      ciNote = "no interval published";
    }
    const reps = mode === "config" ? ` · ${n} replicate${n === 1 ? "" : "s"}` : ` · ${head.timestamp?.slice(0, 16).replace("T", " ") ?? ""}`;
    return {
      id,
      head,
      runs,
      title: systemName(head) || id,
      meta: `${datasetLabel(head.dataset)} · ${methodName(head)} · ${settingsLabel(head)}${reps}`,
      detailUrl: `${state.base}/${mode}/${enc}/`,
      metrics,
      ciNote,
    };
  }

  // ---------- Pickers ----------

  function pickerOptions(mode: Mode, dataset: string): [string, string][] {
    const rows = state.index.filter((r) => r.dataset === dataset);
    if (mode === "run") {
      return rows
        .slice()
        .sort((x, y) => (y.sps ?? -1) - (x.sps ?? -1))
        .map((r) => [
          r.run_id,
          `${systemName(r)} — ${settingsLabel(r)} · ${r.timestamp?.slice(0, 10) ?? ""} (Index ${idxOf(r.sps, r.dataset)})`,
        ]);
    }
    const byConfig = new Map<string, RunIndexEntry[]>();
    for (const r of rows) byConfig.set(r.config_id, [...(byConfig.get(r.config_id) ?? []), r]);
    return [...byConfig]
      .map(([id, reps]) => ({ id, reps, mean: replicateStats(reps.map((r) => r.sps)).mean }))
      .sort((x, y) => (y.mean ?? -1) - (x.mean ?? -1))
      .map(({ id, reps, mean }): [string, string] => [
        id,
        `${systemName(reps[0])} — ${settingsLabel(reps[0])}${reps.length > 1 ? ` · ${reps.length} reps` : ""} (Index ${idxOf(mean, reps[0].dataset)})`,
      ]);
  }

  function fillSelect(sel: HTMLSelectElement | null, placeholder: string, opts: [string, string][], value: string) {
    if (!sel) return;
    sel.replaceChildren();
    for (const [v, label] of [["", placeholder] as [string, string], ...opts]) {
      const o = document.createElement("option");
      o.value = v;
      o.textContent = label;
      sel.appendChild(o);
    }
    sel.value = opts.some(([v]) => v === value) ? value : "";
  }

  function renderPickers(): void {
    for (const b of document.querySelectorAll<HTMLButtonElement>("#pick-mode button")) {
      const on = b.dataset.mode === state.mode;
      b.setAttribute("aria-checked", String(on));
      b.className = `px-3 py-1.5 text-sm ${on ? "bg-primary text-white font-semibold" : "hover:bg-muted/10"}`;
    }
    const datasets = [...new Set(state.index.map((r) => r.dataset))].sort((x, y) =>
      datasetLabel(x).localeCompare(datasetLabel(y)),
    );
    fillSelect(
      $<HTMLSelectElement>("pick-dataset"),
      "Choose a dataset",
      datasets.map((d) => [d, datasetLabel(d)]),
      state.dataset,
    );
    const opts = state.dataset ? pickerOptions(state.mode, state.dataset) : [];
    const noun = state.mode === "config" ? "config" : "run";
    fillSelect($<HTMLSelectElement>("pick-a"), `Choose ${noun} A`, opts, state.aId);
    fillSelect($<HTMLSelectElement>("pick-b"), `Choose ${noun} B`, opts, state.bId);
    const crumb = $<HTMLAnchorElement>("crumb-explore");
    if (crumb) {
      crumb.href = `${state.base}/explore/${state.dataset ? `?ds=${encodeURIComponent(state.dataset)}` : ""}`;
      crumb.textContent = state.dataset ? `Runs · ${datasetLabel(state.dataset)}` : "Runs";
    }
  }

  function wirePickers(): void {
    for (const b of document.querySelectorAll<HTMLButtonElement>("#pick-mode button")) {
      b.addEventListener("click", () => {
        const mode: Mode = b.dataset.mode === "run" ? "run" : "config";
        if (mode === state.mode) return;
        // Carry the selection across: a config maps to its first replicate run, a run to its config.
        const convert = (id: string): string => {
          if (!id) return "";
          if (mode === "run") return runsOf("config", id)[0]?.run_id ?? "";
          return runsOf("run", id)[0]?.config_id ?? "";
        };
        state.aId = convert(state.aId);
        state.bId = convert(state.bId);
        state.mode = mode;
        void load();
      });
    }
    $<HTMLSelectElement>("pick-dataset")?.addEventListener("change", (e) => {
      state.dataset = (e.target as HTMLSelectElement).value;
      state.aId = "";
      state.bId = "";
      void load();
    });
    for (const side of ["a", "b"] as const) {
      $<HTMLSelectElement>(`pick-${side}`)?.addEventListener("change", (e) => {
        const v = (e.target as HTMLSelectElement).value;
        if (side === "a") state.aId = v;
        else state.bId = v;
        void load();
      });
    }
    $("pick-swap")?.addEventListener("click", () => {
      [state.aId, state.bId] = [state.bId, state.aId];
      void load();
    });
  }

  // ---------- Rendering ----------

  function resetView(): void {
    for (const id of ["compare-error", "compare-empty", "flipped-note"]) $(id)?.classList.add("hidden");
    for (const id of ["compare-metrics-wrap", "compare-flipped-wrap"]) $(id)?.classList.add("hidden");
    const chips = $("subject-chips");
    chips?.classList.add("hidden");
    chips?.classList.remove("grid");
    $("flipped-gate")?.classList.add("hidden");
    $("flipped-table-wrap")?.classList.remove("hidden");
  }

  function showError(title: string, msg: string): void {
    const box = $("compare-error");
    box?.classList.remove("hidden");
    const t = $("compare-error-title");
    if (t) t.textContent = title;
    const d = $("compare-error-detail");
    if (d) d.textContent = msg;
  }

  function renderSubjectChip(side: "a" | "b", s: Subject | null): void {
    const root = $("subject-chips");
    if (!root) return;
    const set = (f: string, v: string) => {
      const el = root.querySelector<HTMLElement>(`[data-field="${side}-${f}"]`);
      if (el) el.textContent = v;
    };
    set("title", s ? s.title : "Not chosen yet");
    set("meta", s ? s.meta : `Pick ${side.toUpperCase()} above.`);
    set("id", s ? s.id : "");
    const link = root.querySelector<HTMLAnchorElement>(`[data-field="${side}-link"]`);
    if (link) {
      link.hidden = !s;
      if (s) link.href = s.detailUrl;
    }
  }

  function showChips(): void {
    const root = $("subject-chips");
    root?.classList.remove("hidden");
    root?.classList.add("grid");
  }

  function renderMetrics(a: Subject, b: Subject): void {
    const container = $("compare-metrics");
    const wrap = $("compare-metrics-wrap");
    const note = $("compare-metrics-note");
    if (!container || !wrap) return;

    if (note) {
      const why = [a.ciNote ? `A: ${a.ciNote}` : "", b.ciNote ? `B: ${b.ciNote}` : ""]
        .filter(Boolean)
        .join("; ");
      note.textContent =
        `${state.mode === "config" ? "Means over each config's replicates; intervals are 95% t-intervals over 3+ replicates." : "Single runs; intervals are the run's bootstrap intervals."} ` +
        "Solid border: intervals don't overlap. Dashed: they overlap (likely noise). Thin: no interval" +
        (why ? ` (${why}).` : ".");
    }

    // Index first (the site-wide scale), then SPS and its technical parts.
    type Key = keyof SubjectMetrics | "index";
    const metrics: Array<{ key: Key; label: string }> = [
      { key: "index", label: "Index" },
      { key: "sps", label: "SPS" },
      { key: "jsd", label: METRIC_NAMES.jsd.label },
      { key: "tau", label: METRIC_NAMES.tau.label },
    ];
    const metricOf = (s: Subject, key: Key): MetricValue =>
      key === "index" ? indexMetric(s.metrics.sps, s.head.dataset) : s.metrics[key];

    container.innerHTML = metrics
      .map(({ key, label }) => {
        const m = METRIC_NAMES[key];
        const f = (v: number | null | undefined) => (key === "index" ? fmtIndex(v) : fmt(v));
        const am = metricOf(a, key);
        const bm = metricOf(b, key);
        const aVal = am.value;
        const bVal = bm.value;
        const delta = aVal != null && bVal != null ? aVal - bVal : null;
        const overlap = ciOverlap(am.ci, bm.ci);
        const borderClass =
          overlap === "disjoint"
            ? "metric-tile--disjoint"
            : overlap === "overlap"
              ? "metric-tile--overlap"
              : "metric-tile--unknown";
        const sigLabel =
          overlap === "disjoint"
            ? "CIs disjoint"
            : overlap === "overlap"
              ? "CIs overlap"
              : a.ciNote?.includes("too few") || b.ciNote?.includes("too few")
                ? "n too small"
                : "CI n/a";
        const ciLine = (ci: CiRange | null) =>
          ci ? `<span class="metric-ci">[${f(ci.low)}, ${f(ci.high)}]</span>` : "";
        return `
          <div class="metric-tile ${borderClass}" data-metric="${key}" title="${escapeHtml(m.desc)}">
            <div class="flex items-baseline justify-between">
              <div class="metric-label">${escapeHtml(label)}<span class="metric-tech">${escapeHtml(m.tech)}</span></div>
              <div class="metric-sig" title="${escapeHtml(sigLabel)}">${escapeHtml(sigLabel)}</div>
            </div>
            <div class="mt-2 grid grid-cols-2 gap-2">
              <div>
                <div class="metric-side">A</div>
                <div class="metric-val">${escapeHtml(f(aVal))}</div>
                ${ciLine(am.ci)}
              </div>
              <div>
                <div class="metric-side">B</div>
                <div class="metric-val">${escapeHtml(f(bVal))}</div>
                ${ciLine(bm.ci)}
              </div>
            </div>
            <div class="metric-delta">Δ (A − B): <span class="font-mono">${escapeHtml(fmtSigned(delta, key === "index" ? 0 : 3))}</span>${key === "index" ? " Index points" : ""}</div>
          </div>
        `;
      })
      .join("");
    wrap.classList.remove("hidden");
  }

  /** Average each question over replicates: mean distribution, mean JSD. */
  function aggregateQuestions(details: RunDetail[]): Map<string, QuestionAgg> {
    const out = new Map<string, QuestionAgg & { sums: Record<string, number>; jsds: number[] }>();
    for (const d of details) {
      for (const q of d.per_question ?? []) {
        let agg = out.get(q.key);
        if (!agg) {
          const human =
            q.human_distribution && Object.keys(q.human_distribution).length
              ? q.human_distribution
              : null;
          agg = {
            key: q.key,
            text: q.text ?? "",
            topic: typeof q.topic === "string" ? q.topic : "",
            options: q.options ?? [],
            human,
            dist: {},
            jsd: null,
            nReplicates: 0,
            sums: {},
            jsds: [],
          };
          out.set(q.key, agg);
        }
        agg.nReplicates += 1;
        for (const [k, v] of Object.entries(q.model_distribution ?? {})) {
          agg.sums[k] = (agg.sums[k] ?? 0) + v;
        }
        if (typeof q.jsd === "number") agg.jsds.push(q.jsd);
      }
    }
    for (const agg of out.values()) {
      for (const [k, v] of Object.entries(agg.sums)) agg.dist[k] = v / agg.nReplicates;
      agg.jsd = agg.jsds.length ? agg.jsds.reduce((x, y) => x + y, 0) / agg.jsds.length : null;
    }
    return out;
  }

  function buildFlippedRows(a: Map<string, QuestionAgg>, b: Map<string, QuestionAgg>): FlippedRow[] {
    const rows: FlippedRow[] = [];
    for (const qa of a.values()) {
      const qb = b.get(qa.key);
      if (!qb) continue;
      const aModal = modalOption(qa.dist);
      const bModal = modalOption(qb.dist);
      const human = qa.human ?? qb.human;
      rows.push({
        key: qa.key,
        text: qa.text,
        topic: qa.topic ? topicLabel(qa.topic) : "—",
        options: qa.options.length ? qa.options : qb.options,
        a: { modal: aModal, jsd: qa.jsd, dist: qa.dist },
        b: { modal: bModal, jsd: qb.jsd, dist: qb.dist },
        humanDist: human,
        humanModal: human ? modalOption(human) : "—",
        deltaJsd: qa.jsd != null && qb.jsd != null ? qa.jsd - qb.jsd : null,
        flip: aModal !== bModal,
      });
    }
    return rows;
  }

  function sortValue(row: FlippedRow, key: SortKey): string | number | null {
    switch (key) {
      case "question":
        return row.key;
      case "topic":
        return row.topic === "—" ? null : row.topic;
      case "human_modal":
        return row.humanModal === "—" ? null : row.humanModal;
      case "a_modal":
        return row.a.modal;
      case "b_modal":
        return row.b.modal;
      case "a_jsd":
        return row.a.jsd;
      case "b_jsd":
        return row.b.jsd;
      case "delta_jsd":
        return row.deltaJsd == null ? null : Math.abs(row.deltaJsd);
      case "flip":
        return row.flip ? 1 : 0;
    }
  }

  function sortRows(rows: FlippedRow[]): FlippedRow[] {
    const mult = state.sortDir === "asc" ? 1 : -1;
    return rows.slice().sort((x, y) => {
      const xv = sortValue(x, state.sortKey);
      const yv = sortValue(y, state.sortKey);
      if (xv == null && yv == null) return 0;
      if (xv == null) return 1;
      if (yv == null) return -1;
      if (typeof xv === "number" && typeof yv === "number") return (xv - yv) * mult;
      return String(xv).localeCompare(String(yv), undefined, { numeric: true }) * mult;
    });
  }

  function modalCell(modal: string, human: string): string {
    const differs = human !== "—" && modal !== human;
    return `<td class="px-3 py-2 text-xs">${escapeHtml(modal)}${differs ? ' <span class="text-accent" title="Differs from the human modal answer">≠</span>' : ""}</td>`;
  }

  function renderTable(): void {
    const tbody = $("flipped-tbody");
    const wrap = $("compare-flipped-wrap");
    const count = $("flipped-count");
    if (!tbody || !wrap) return;
    wrap.classList.remove("hidden");

    const visible = state.flippedOnly ? state.rows.filter((r) => r.flip) : state.rows;
    const sorted = sortRows(visible);

    if (count) {
      const total = state.rows.length;
      const flipped = state.rows.filter((r) => r.flip).length;
      count.textContent = state.flippedOnly
        ? `${sorted.length} flipped of ${total}`
        : `${total} shared (${flipped} flipped)`;
    }

    if (!sorted.length) {
      tbody.innerHTML = `<tr><td colspan="9" class="px-3 py-8 text-center text-muted">${
        state.rows.length === 0
          ? "No shared questions between A and B."
          : "No rows match the current filter."
      }</td></tr>`;
      return;
    }

    const qBase = `${state.base}/question/${encodeURIComponent(state.dataset)}`;
    tbody.innerHTML = sorted
      .map((row, i) => {
        const detailId = `fq-detail-${i}`;
        const deltaClass =
          row.deltaJsd == null ? "" : row.deltaJsd > 0 ? "text-baseline" : "text-primary";
        const flipCell = row.flip
          ? '<span class="rounded bg-baseline/20 px-1.5 py-0.5 text-xs text-baseline">yes</span>'
          : '<span class="text-muted">—</span>';
        const safe = safeQuestionKey(row.key);
        const hasPage = !state.pageKeys || state.pageKeys.has(safe);
        const keyHtml = hasPage
          ? `<a href="${qBase}/${safe}/" class="font-mono text-xs text-primary hover:underline">${escapeHtml(row.key)}</a>`
          : `<span class="font-mono text-xs text-muted">${escapeHtml(row.key)}</span>`;
        return `
          <tr class="fq-row border-b border-muted/10 hover:bg-primary/5" data-key="${escapeHtml(row.key)}">
            <td class="px-3 py-2">
              <div class="flex items-start gap-2">
                <button type="button" class="fq-expand mt-0.5 text-xs text-muted hover:text-primary"
                        aria-expanded="false"
                        aria-controls="${detailId}"
                        aria-label="Show full distribution for question ${escapeHtml(row.key)}"><span class="fq-caret" aria-hidden="true">▸</span></button>
                <span>
                  ${keyHtml}
                  <span class="block max-w-md text-xs text-muted">${escapeHtml(row.text)}</span>
                </span>
              </div>
            </td>
            <td class="px-3 py-2 text-xs">${escapeHtml(row.topic)}</td>
            <td class="px-3 py-2 text-xs">${escapeHtml(row.humanModal)}</td>
            ${modalCell(row.a.modal, row.humanModal)}
            ${modalCell(row.b.modal, row.humanModal)}
            <td class="px-3 py-2 text-right font-mono text-xs">${fmt(row.a.jsd)}</td>
            <td class="px-3 py-2 text-right font-mono text-xs">${fmt(row.b.jsd)}</td>
            <td class="px-3 py-2 text-right font-mono ${deltaClass}">${escapeHtml(fmtSigned(row.deltaJsd))}</td>
            <td class="px-3 py-2 text-center">${flipCell}</td>
          </tr>
          <tr id="${detailId}" class="fq-detail hidden border-b border-muted/10 bg-surface/50 dark:bg-surface-dark/50">
            <td colspan="9" class="px-4 py-4">
              <div class="mb-3 text-sm">
                <strong>Question:</strong>
                <span class="ml-1">${escapeHtml(row.text)}</span>
              </div>
              <div class="mb-2 text-xs text-muted">
                JSD A: <span class="font-mono">${fmt(row.a.jsd)}</span>
                · JSD B: <span class="font-mono">${fmt(row.b.jsd)}</span>
                · ΔJSD: <span class="font-mono">${fmtSigned(row.deltaJsd)}</span>
                · topic: <span>${escapeHtml(row.topic)}</span>
              </div>
              <div class="dist-legend">${renderLegend(row.options, row.humanDist ?? row.a.dist)}</div>
              <div class="dist-stack">
                ${row.humanDist ? renderStackedBar("Human", row.humanDist, row.options) : `<div class="dist-row"><span class="dist-label">Human</span><span class="text-xs text-muted">not published for this question</span></div>`}
                ${renderStackedBar("A", row.a.dist, row.options)}
                ${renderStackedBar("B", row.b.dist, row.options)}
              </div>
            </td>
          </tr>
        `;
      })
      .join("");
  }

  function renderSortIndicators(): void {
    for (const th of document.querySelectorAll<HTMLTableCellElement>("#flipped-table thead th[data-sort]")) {
      th.querySelector(".sort-arrow")?.remove();
      if (th.dataset.sort === state.sortKey) {
        th.setAttribute("aria-sort", state.sortDir === "asc" ? "ascending" : "descending");
        const span = document.createElement("span");
        span.className = "sort-arrow";
        span.setAttribute("aria-hidden", "true");
        span.textContent = state.sortDir === "asc" ? "▲" : "▼";
        span.style.marginLeft = "0.25rem";
        (th.querySelector<HTMLButtonElement>("button[data-sort]") ?? th).appendChild(span);
      } else {
        th.setAttribute("aria-sort", "none");
      }
    }
  }

  function wireTable(): void {
    for (const btn of document.querySelectorAll<HTMLButtonElement>("#flipped-table thead button[data-sort]")) {
      btn.addEventListener("click", () => {
        const key = btn.dataset.sort as SortKey | undefined;
        if (!key) return;
        if (state.sortKey === key) state.sortDir = state.sortDir === "asc" ? "desc" : "asc";
        else {
          state.sortKey = key;
          state.sortDir = defaultDir(key);
        }
        renderSortIndicators();
        renderTable();
        writeUrl();
      });
    }
    const flippedOnly = $<HTMLInputElement>("flipped-only");
    flippedOnly?.addEventListener("change", () => {
      state.flippedOnly = flippedOnly.checked;
      renderTable();
      writeUrl();
    });
    $("flipped-tbody")?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>("button.fq-expand");
      const controls = btn?.getAttribute("aria-controls");
      const detail = controls ? document.getElementById(controls) : null;
      if (!btn || !detail) return;
      const next = btn.getAttribute("aria-expanded") !== "true";
      btn.setAttribute("aria-expanded", String(next));
      detail.classList.toggle("hidden", !next);
      const caret = btn.querySelector(".fq-caret");
      if (caret) caret.textContent = next ? "▾" : "▸";
    });
  }

  // ---------- Loading ----------

  /** Fetch every run behind a subject (tier-aware). "gated" when not signed in. */
  async function loadRuns(s: Subject): Promise<RunDetail[] | "gated"> {
    const tier = dataFetch.lookupDatasetTier(s.head.dataset, state.policies);
    const results = await Promise.all(
      s.runs.map((r) => dataFetch.fetchTieredJson<RunDetail>(`run/${encodeURIComponent(r.run_id)}.json`, tier)),
    );
    if (results.some((r) => !r.ok && r.gated)) return "gated";
    const failed = results.find((r) => !r.ok);
    if (failed && !failed.ok) throw new Error(failed.message);
    return results.flatMap((r) => (r.ok ? [r.data] : []));
  }

  async function load(): Promise<void> {
    const gen = ++state.generation;
    resetView();
    const noun = state.mode;

    // Resolve the dataset from A or B; refuse cross-dataset pairs.
    const subjA = state.aId ? buildSubject(state.mode, state.aId) : null;
    const subjB = state.bId ? buildSubject(state.mode, state.bId) : null;
    const missing = [
      state.aId && !subjA ? `A (“${state.aId}”)` : "",
      state.bId && !subjB ? `B (“${state.bId}”)` : "",
    ].filter(Boolean);
    if (subjA) state.dataset = subjA.head.dataset;
    else if (subjB) state.dataset = subjB.head.dataset;
    if (!state.dataset) state.dataset = state.index.some((r) => r.dataset === "opinionsqa") ? "opinionsqa" : (state.index[0]?.dataset ?? "");
    let crossNote = "";
    if (subjA && subjB && subjA.head.dataset !== subjB.head.dataset) {
      crossNote = `A is on ${datasetLabel(subjA.head.dataset)} and B on ${datasetLabel(subjB.head.dataset)}. Compares work within one dataset, so B was cleared: pick a ${datasetLabel(subjA.head.dataset)} ${noun} for B.`;
      state.bId = "";
    }
    if (missing.length) {
      if (state.aId && !subjA) state.aId = "";
      if (state.bId && !subjB) state.bId = "";
    }
    renderPickers();
    writeUrl();

    if (missing.length) {
      showError(
        `No published ${noun} matches ${missing.join(" and ")}.`,
        "It may have been renamed or retired. Pick one above.",
      );
    } else if (crossNote) {
      showError("Different datasets.", crossNote);
    }
    const a = state.aId ? subjA : null;
    const b = state.bId ? subjB : null;
    renderSubjectChip("a", a);
    renderSubjectChip("b", b);
    if (a || b) showChips();
    if (!a || !b) {
      if (!missing.length && !crossNote) $("compare-empty")?.classList.remove("hidden");
      return;
    }
    if (a.id === b.id) {
      showError("A and B are the same.", `Pick a different ${noun} for B.`);
      return;
    }

    renderMetrics(a, b);
    const flippedOnly = $<HTMLInputElement>("flipped-only");
    if (flippedOnly) flippedOnly.checked = state.flippedOnly;
    renderSortIndicators();
    $("compare-flipped-wrap")?.classList.remove("hidden");
    const tbody = $("flipped-tbody");
    if (tbody) tbody.innerHTML = `<tr><td colspan="9" class="px-3 py-8 text-center text-muted">Loading per-question detail…</td></tr>`;

    try {
      const [ra, rb, keys] = await Promise.all([
        loadRuns(a),
        loadRuns(b),
        questionPageKeys(state.base, state.dataset),
      ]);
      if (gen !== state.generation) return;
      state.pageKeys = keys;
      if (ra === "gated" || rb === "gated") {
        // Aggregates above are public; only the per-question diff is gated.
        $("flipped-table-wrap")?.classList.add("hidden");
        const gate = $("flipped-gate");
        if (gate) {
          gate.classList.remove("hidden");
          dataFetch.renderSignInGate(gate, { datasetLabel: datasetLabel(state.dataset) });
        }
        const count = $("flipped-count");
        if (count) count.textContent = "";
        return;
      }
      if (state.mode === "run") {
        // Single runs publish bootstrap intervals; show them now.
        const ci = (d: RunDetail) => d.aggregate?.per_metric_ci ?? null;
        const ca = ci(ra[0]);
        const cb = ci(rb[0]);
        a.metrics.sps.ci = ciFromPair(ca?.sps);
        b.metrics.sps.ci = ciFromPair(cb?.sps);
        a.metrics.jsd.ci = ciFromPair(ca?.jsd ?? ca?.mean_jsd);
        b.metrics.jsd.ci = ciFromPair(cb?.jsd ?? cb?.mean_jsd);
        a.metrics.tau.ci = ciFromPair(ca?.tau ?? ca?.mean_kendall_tau);
        b.metrics.tau.ci = ciFromPair(cb?.tau ?? cb?.mean_kendall_tau);
        if (a.metrics.sps.ci) a.ciNote = null;
        if (b.metrics.sps.ci) b.ciNote = null;
        renderMetrics(a, b);
      } else if (a.runs.length > 1 || b.runs.length > 1) {
        const note = $("flipped-note");
        if (note) {
          note.textContent = `Each question is averaged over the config's replicates (A: ${a.runs.length}, B: ${b.runs.length}): mean answer distribution, modal answer of that mean, and mean JSD.`;
          note.classList.remove("hidden");
        }
      }
      state.rows = buildFlippedRows(aggregateQuestions(ra), aggregateQuestions(rb));
      renderTable();
    } catch (err) {
      if (gen !== state.generation) return;
      $("compare-flipped-wrap")?.classList.add("hidden");
      showError("Could not load per-question detail.", err instanceof Error ? err.message : String(err));
    }
  }

  async function fetchJson<T>(url: string): Promise<T | null> {
    try {
      const res = await fetch(url);
      return res.ok ? ((await res.json()) as T) : null;
    } catch {
      return null;
    }
  }

  async function main(): Promise<void> {
    state.base = $("compare-root")?.dataset.base ?? "";
    readUrl();
    dataFetch = await import("@/lib/dataFetch");
    // runs-index.json (catalog) and leaderboard.json (dataset policies) are
    // public, tier-less artifacts: titles, settings and aggregate metrics
    // come from them, so they render for gated datasets too.
    const [idx, lb] = await Promise.all([
      fetchJson<RunIndex>(`${state.base}/data/runs-index.json`),
      fetchJson<{ dataset_policies?: DatasetPolicyEntry[] }>(`${state.base}/data/leaderboard.json`),
    ]);
    if (!idx) {
      showError("Could not load the runs index.", "Try again later, or start from the Leaderboard.");
      return;
    }
    state.index = idx.runs;
    state.policies = lb?.dataset_policies ?? null;
    wirePickers();
    wireTable();
    await load();
  }

  main();
</script>

<style is:global>
  /* Scoped styles do not reach elements inserted via innerHTML from the client
     script above (Astro hashes the selectors with data-astro-cid-* attributes
     that our JS-built nodes lack). These rules must be global so the metric
     tiles and distribution bars render at all. */
  .metric-tile {
    padding: 0.85rem;
    border-radius: 0.5rem;
    background: color-mix(in oklch, var(--color-surface) 60%, transparent);
  }
  /* `--color-surface` is the LIGHT-mode token and is not flipped in
     dark mode (the body uses Tailwind's `dark:bg-surface-dark` instead).
     Without this override the tile renders translucent-white over the dark
     page background, which collides with the lifted `--color-muted-dark`
     label/sig/side text and produces grey-on-grey (sb-3ie, mirrors sb-ave). */
  @media (prefers-color-scheme: dark) {
    .metric-tile {
      background: color-mix(in oklch, var(--color-surface-dark) 70%, transparent);
    }
    .metric-tile--unknown {
      border-color: color-mix(in oklch, var(--color-muted) 35%, transparent);
    }
  }
  .metric-tile--disjoint {
    border: 2px solid color-mix(in oklch, var(--color-primary) 55%, transparent);
  }
  .metric-tile--overlap {
    border: 2px dashed color-mix(in oklch, var(--color-muted) 45%, transparent);
  }
  .metric-tile--unknown {
    border: 1px solid color-mix(in oklch, var(--color-muted) 25%, transparent);
  }
  /* No text-transform on labels: they may hold τ, which upper-cases to Τ. */
  .metric-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .metric-tech {
    display: block;
    font-size: 0.65rem;
    font-weight: 400;
  }
  .metric-sig {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
