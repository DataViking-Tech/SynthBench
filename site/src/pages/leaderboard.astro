---
import DemographicHeatmap from "@/components/leaderboard/DemographicHeatmap.astro";
import IndexPayload from "@/components/sb/IndexPayload.astro";
import leaderboardRaw from "@/data/leaderboard.json";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { LeaderboardData } from "@/types/leaderboard";

const leaderboard = leaderboardRaw as LeaderboardData;
const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const generatedAt = leaderboard.generated_at ? new Date(leaderboard.generated_at) : null;
const generatedAtLabel =
  generatedAt && !Number.isNaN(generatedAt.getTime())
    ? `${generatedAt.toISOString().slice(0, 16).replace("T", " ")} UTC`
    : null;
const nExcluded = leaderboard.excluded_runs?.length ?? 0;

// The PyPI name `synthbench` belongs to an unrelated project, so install from
// the repo; `[subpop]` pulls the HF datasets extra the subpop adapter needs.
const reproduceCommands = [
  'pip install "synthbench-eval[subpop] @ git+https://github.com/DataViking-Tech/SynthBench.git"',
  "synthbench run --provider <yours> --dataset subpop --samples 30",
  "synthbench validate results/<your-run>.json",
  "synthbench compare results/<your-run>.json <any-published-run>.json",
].join("\n");
---

<BaseLayout
  title="Leaderboard: SynthBench"
  description="Every synthetic-respondent system ranked by the SynthBench Index, grouped into statistical tiers."
>
  <IndexPayload />
  <div class="sb">
    <section class="sb-head sb-head-row">
      <div>
        <div class="sb-kicker" data-provenance>
          Index v1
          {nExcluded > 0 && <> · <a href={`${base}methodology/#run-validity`}>{nExcluded} runs excluded</a></>}
          {generatedAtLabel && <> · generated <span data-vrt-mask>{generatedAtLabel}</span></>}
          {leaderboard.synthbench_version && ` · synthbench v${leaderboard.synthbench_version}`}
        </div>
        <h1 class="sb-h1 sm">Leaderboard</h1>
        <p class="sb-lede">
          Systems are grouped into <b>tiers</b>. Systems in the same tier can't be reliably told apart once
          you account for their 95% intervals.
        </p>
      </div>
      <div class="sb-head-actions">
        <button type="button" class="sb-btn" id="lb-csv">Download CSV</button>
        <a class="sb-btn" href={`${base}data/leaderboard.json`}>JSON API</a>
      </div>
    </section>

    <section class="sb-block sb-panel">
      <div class="sb-filterbar" id="lb-filters"></div>
      <div class="sb-tablewrap"><table class="sb-lb" id="leaderboard"></table></div>
    </section>

    <section class="sb-notes">
      <div>
        <h4>Tiers</h4>
        A system's tier is 1 plus the number of systems whose 95% interval sits entirely above its own.
        A difference of a few points inside a tier is noise.
      </div>
      <div>
        <h4>Reference rows</h4>
        Striped rows are reference points, not systems: <b>random answers</b> (Index 0) and
        <b>always choosing the most popular answer</b>.
      </div>
      <div>
        <h4>Compare</h4>
        Tick up to three rows to compare them side by side. Click a row for details. GSS (†) has no
        published human ceiling yet, so it isn't part of the Index.
      </div>
    </section>

    <section class="sb-block sb-panel sb-pad" data-reproduce-box>
      <h2 class="sb-h2">Reproduce these numbers</h2>
      <p class="sb-muted">
        Every number on this page is recomputed from per-question data when the site is built. The scoring
        code and public data are open, so you can re-run any of it:
      </p>
      <div class="sb-code">
        <pre><code>{reproduceCommands}</code></pre>
        <button type="button" id="copy-reproduce" class="sb-btn sb-btn-sm" data-commands={reproduceCommands}>Copy</button>
      </div>
      <p class="sb-note">
        <code>run</code> scores your provider on the same public questions. <code>validate</code> checks the
        result file against the integrity rules. <code>compare</code> runs a paired bootstrap test against any
        published run. See the <a href="https://github.com/DataViking-Tech/SynthBench/blob/main/docs/leaderboard-json-api.md">API contract</a>
        for the JSON format.
      </p>
    </section>
  </div>

  <div class="mt-12">
    <DemographicHeatmap />
  </div>
</BaseLayout>

<script>
  import "@/scripts/sb/pages/leaderboard";

  const copyBtn = document.getElementById("copy-reproduce");
  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText(copyBtn.dataset.commands ?? "").then(() => {
      copyBtn.textContent = "Copied";
      setTimeout(() => {
        copyBtn.textContent = "Copy";
      }, 2000);
    });
  });
</script>
