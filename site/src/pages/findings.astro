---
import ConditioningGap from "@/components/findings/ConditioningGap.astro";
import ConvergenceLine from "@/components/findings/ConvergenceLine.astro";
import CostPerformancePareto from "@/components/findings/CostPerformancePareto.astro";
import CrossProviderJSDMatrix from "@/components/findings/CrossProviderJSDMatrix.astro";
import ElicitationComparison from "@/components/findings/ElicitationComparison.astro";
import EnsembleGain from "@/components/findings/EnsembleGain.astro";
import EnsembleMethodology from "@/components/findings/EnsembleMethodology.astro";
import LeverHierarchy from "@/components/findings/LeverHierarchy.astro";
import NonresponseFidelity from "@/components/findings/NonresponseFidelity.astro";
import TemperatureCurve from "@/components/findings/TemperatureCurve.astro";
import TemporalDriftFloor from "@/components/findings/TemporalDriftFloor.astro";
import TopicGroupedBar from "@/components/findings/TopicGroupedBar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<BaseLayout title="Findings - SynthBench">
  <div class="py-12 text-center">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Research Findings</h1>
    <p class="mt-3 text-lg text-muted max-w-2xl mx-auto">
      Six experiments that reveal what drives synthetic survey quality —
      from the levers that matter most to the biases hiding in default model behavior.
    </p>
    <p class="mt-3 text-sm text-muted max-w-2xl mx-auto">
      Scope of claim: every score below measures distributional fidelity to
      specific surveys (Pew ATP, SubPOP, GlobalOpinionQA, GSS) — not validity,
      individual-response accuracy, or real-world behavior prediction.
      <a href={`${base}methodology/#scope-of-claim`} class="text-primary hover:underline">What SPS does and doesn't measure →</a>
    </p>
  </div>

  <LeverHierarchy />

  <EnsembleGain />

  <CostPerformancePareto />

  <CrossProviderJSDMatrix />

  <EnsembleMethodology />

  <TemperatureCurve />

  <ConditioningGap />

  <NonresponseFidelity />

  <ElicitationComparison />

  <TopicGroupedBar />

  <ConvergenceLine />

  <TemporalDriftFloor />
</BaseLayout>
