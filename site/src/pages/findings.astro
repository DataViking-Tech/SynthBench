---
import ConditioningGap from "@/components/findings/ConditioningGap.astro";
import ConvergenceLine from "@/components/findings/ConvergenceLine.astro";
import CostPerformancePareto from "@/components/findings/CostPerformancePareto.astro";
import CrossProviderJSDMatrix from "@/components/findings/CrossProviderJSDMatrix.astro";
import ElicitationComparison from "@/components/findings/ElicitationComparison.astro";
import EnsembleGain from "@/components/findings/EnsembleGain.astro";
import EnsembleMethodology from "@/components/findings/EnsembleMethodology.astro";
import LeverHierarchy from "@/components/findings/LeverHierarchy.astro";
import NonresponseFidelity from "@/components/findings/NonresponseFidelity.astro";
import TemperatureCurve from "@/components/findings/TemperatureCurve.astro";
import TemporalDriftFloor from "@/components/findings/TemporalDriftFloor.astro";
import TopicGroupedBar from "@/components/findings/TopicGroupedBar.astro";
import IndexPayload from "@/components/sb/IndexPayload.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<BaseLayout
  title="Findings: SynthBench"
  description="What the benchmark shows about synthetic survey respondents: raw LLMs vs. random answers, ensembles, prompt templates, temperature, model agreement and subgroup bias."
>
  <IndexPayload />
  <div class="sb">
    <section class="sb-head">
      <div class="sb-kicker">Findings</div>
      <h1 class="sb-h1 sm">What the benchmark shows</h1>
      <p class="sb-lede">
        Each finding gives the claim, how strong the evidence is, and what it means if you run synthetic
        surveys. Numbers are on the SynthBench Index unless noted. Every score measures how well a system
        matches the answer distributions of specific surveys, not how well it predicts individual answers or
        real-world behavior (<a href={`${base}methodology/#scope-of-claim`}>scope of claim</a>).
      </p>
    </section>
    <nav class="sb-block sb-panel sb-toc" id="fd-toc" aria-label="Findings"></nav>
    <div id="fd-list"></div>

    <section class="sb-block sb-head">
      <h2 class="sb-h2">Detailed analyses</h2>
      <p class="sb-muted">
        The original analyses behind the findings above. These charts use the raw Survey Parity Score (SPS,
        0 to 1) rather than the Index.
      </p>
    </section>
  </div>

  <LeverHierarchy />

  <EnsembleGain />

  <CostPerformancePareto />

  <CrossProviderJSDMatrix />

  <EnsembleMethodology />

  <TemperatureCurve />

  <ConditioningGap />

  <NonresponseFidelity />

  <ElicitationComparison />

  <TopicGroupedBar />

  <ConvergenceLine />

  <TemporalDriftFloor />
</BaseLayout>

<script>
  import "@/scripts/sb/pages/findings";
</script>
