---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

import IndexScales from "@/components/sb/IndexScales.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { INDEX_EXPLAINER } from "@/lib/vocab";

// Build-time guard: warn (don't fail) if runs-index.json isn't available so
// releases ship the friendly empty-state below rather than a runtime 404 error.
// Only meaningful during `astro build` / SSR-time evaluation.
const runsIndexPath = fileURLToPath(new URL("../../public/data/runs-index.json", import.meta.url));
const hasRunsIndex = existsSync(runsIndexPath);
if (!hasRunsIndex && import.meta.env.PROD) {
  // eslint-disable-next-line no-console
  console.warn(
    "[explore.astro] public/data/runs-index.json not found at build time — " +
      "Explore page will render empty-state. Run `synthbench publish-runs` to populate.",
  );
}

const selectCls =
  "rounded-md border border-muted/30 bg-surface dark:bg-surface-dark px-3 py-1.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary";
const labelCls = "text-xs font-semibold uppercase tracking-wide text-muted";
const btnCls =
  "rounded-md border border-muted/30 px-3 py-1.5 text-sm font-medium hover:bg-muted/10";
---

<BaseLayout title="Runs">
  <IndexScales />
  <div class="mx-auto max-w-7xl px-4 py-10 space-y-5">
    <header class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Runs</h1>
      <p class="text-muted max-w-3xl leading-relaxed">
        Every benchmark configuration, one dataset at a time, ranked by score. Filter by
        settings, then tick two rows to compare them question by question.
      </p>
      <p class="text-xs text-muted max-w-3xl">{INDEX_EXPLAINER}</p>
    </header>

    <!-- Dataset is the first, required choice: scores are only comparable within one. -->
    <section aria-labelledby="ds-heading" class="flex flex-wrap items-center gap-3">
      <span id="ds-heading" class={labelCls}>Dataset</span>
      <div
        id="filter-dataset"
        role="radiogroup"
        aria-labelledby="ds-heading"
        class="sb-seg"
      >
      </div>
    </section>

    <!-- Phones: the fields fold behind a "Filters (n)" button; view and reset stay out. -->
    <section
      id="ex-filters"
      aria-label="Filters"
      class="ex-filters rounded-lg border border-muted/20 bg-surface dark:bg-surface-dark p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"
    >
      <button
        id="filters-toggle"
        type="button"
        class="ex-ftoggle sm:hidden"
        aria-expanded="false"
        aria-controls="ex-filters"
      >
        <span aria-hidden="true" class="ex-caret">▸</span>
        <span>Filters</span>
        <span id="filters-count" class="text-muted"></span>
      </button>
      <div class="ex-f flex flex-col gap-1">
        <label for="filter-search" class={labelCls}>Search model</label>
        <input
          id="filter-search"
          type="search"
          placeholder="e.g. claude, gpt-4o, llama"
          class={selectCls}
        />
      </div>

      <div class="ex-f flex flex-col gap-1">
        <label for="filter-framework" class={labelCls}>Method</label>
        <select id="filter-framework" class={selectCls}>
          <option value="">All methods</option>
        </select>
      </div>

      <div class="ex-f flex flex-col gap-1">
        <label for="filter-temp" class={labelCls}>Temperature</label>
        <select id="filter-temp" class={selectCls}>
          <option value="">Any temperature</option>
        </select>
      </div>

      <div class="ex-f flex flex-col gap-1">
        <label for="filter-template" class={labelCls}>Prompt template</label>
        <select id="filter-template" class={selectCls}>
          <option value="">Any template</option>
        </select>
      </div>

      <div class="ex-f flex flex-wrap items-center gap-x-5 gap-y-2 sm:col-span-2 lg:col-span-3">
        <label class="inline-flex items-center gap-2 text-sm">
          <input id="filter-baselines" type="checkbox" checked class="accent-primary" />
          Show baselines
        </label>
        <label class="inline-flex items-center gap-2 text-sm">
          <input id="filter-exploratory" type="checkbox" class="accent-primary" />
          Show exploratory runs (small N or low samples)
        </label>
        <label class="inline-flex items-center gap-2 text-sm">
          <input id="filter-collapse" type="checkbox" checked class="accent-primary" />
          Collapse replicates into parent config
        </label>
      </div>

      <div class="ex-view flex flex-wrap items-center gap-2 lg:justify-end">
        <div
          id="view-mode"
          role="radiogroup"
          aria-label="View"
          class="sb-seg"
        >
          <button type="button" role="radio" data-view="table" class="view-btn">Table</button>
          <button type="button" role="radio" data-view="grouped" class="view-btn">Grouped</button>
        </div>
        <button id="filter-reset" type="button" class={btnCls} hidden>Reset</button>
      </div>
    </section>

    <div class="flex flex-wrap items-center justify-between gap-2">
      <p id="explore-summary" class="text-sm text-muted" aria-live="polite"></p>
      <!-- Phones: the table's sortable headers become this menu. -->
      <div id="sort-phone" class="ex-sort sm:hidden">
        <label for="sort-select" class={labelCls}>Sort</label>
        <select id="sort-select" class={selectCls}></select>
        <button id="sort-dir" type="button" class={btnCls} aria-label="Reverse the order"></button>
      </div>
      <div id="group-actions" class="hidden items-center gap-2">
        <button id="expand-all" type="button" class={btnCls}>Expand all</button>
        <button id="collapse-all" type="button" class={btnCls}>Collapse all</button>
      </div>
    </div>

    <div id="explore-tree" class="min-h-[240px]">
      <p class="text-muted text-sm">Loading runs…</p>
    </div>
    <!-- Live region for screen-reader announcements (errors + filter counts). -->
    <div id="explore-live" class="sr-only" role="status" aria-live="polite"></div>

    <div
      id="compare-tray"
      role="region"
      aria-label="Compare selection"
      hidden
      class="ex-tray sticky bottom-4 z-30 mx-auto max-w-4xl rounded-lg border border-primary/40 bg-surface dark:bg-surface-dark shadow-lg p-4 flex flex-col sm:flex-row sm:items-center gap-3"
    >
      <div class="ex-tray-main flex-1 flex flex-wrap items-center gap-2">
        <span class="ex-tray-lbl text-sm font-semibold">Compare:</span>
        <span id="compare-chips" class="flex flex-wrap gap-2"></span>
        <span id="compare-hint" class="text-xs text-muted">Pick another to enable compare</span>
      </div>
      <div class="ex-tray-act flex items-center gap-2">
        <button id="compare-clear" type="button" class={btnCls}>Clear</button>
        <a
          id="compare-go"
          href="#"
          class="rounded-md bg-primary px-3 py-1.5 text-sm font-semibold text-white hover:bg-primary-dark aria-disabled:pointer-events-none aria-disabled:opacity-50"
          role="link"
          aria-disabled="true"
          tabindex="-1"
          >Compare <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import "@/scripts/scrollEdges";
  import "@/scripts/stackTables";
  import { labOf, logoMarkup } from "@/lib/providerIcons";
  import {
    datasetBase,
    datasetLabel,
    replicateStats,
    settingsLabel,
    tempLabel,
    templateLabel,
  } from "@/lib/runExplorer";
  import {
    METHOD_NAMES,
    type MethodId,
    datasetId,
    fmtIndex,
    readIndexScales,
    runSystem,
    spsToIndex,
  } from "@/lib/vocab";
  import type { RunIndex, RunIndexEntry } from "@/types/runs";

  // Canonical names (lib/vocab.ts), cached per run. The method filter and the
  // grouped view use the method and normalized model, so "claude-haiku-4.5"
  // and "claude-haiku-4-5" runs share a group (display only).
  const sysCache = new Map<RunIndexEntry, ReturnType<typeof runSystem>>();
  const sysOf = (r: RunIndexEntry) => {
    let v = sysCache.get(r);
    if (!v) sysCache.set(r, (v = runSystem(r)));
    return v;
  };
  const METHOD_ORDER: MethodId[] = ["raw", "althing", "ensemble", "baseline"];
  const SCALES = readIndexScales();
  /** SPS on the current dataset's Index scale (0 = random answers, 100 = people). */
  const toIndex = (sps: number | null | undefined, dataset: string) =>
    spsToIndex(sps, SCALES[datasetId(dataset)]);

  type SelectionMode = "config" | "run";
  type View = "table" | "grouped";
  type SortKey = "name" | "method" | "temp" | "tpl" | "n" | "spq" | "runs" | "score";
  type SortDir = "asc" | "desc";

  interface Selection {
    id: string;
    label: string;
    mode: SelectionMode;
  }

  /** One table row: a config (replicates collapsed) or a single run. */
  interface Row {
    id: string;
    mode: SelectionMode;
    config_id: string;
    framework: string;
    base_provider: string | null;
    model: string;
    display_name: string;
    dataset: string;
    temperature: number | null;
    effort: string | null;
    template: string | null;
    persona_pack: string | null;
    harness: string | null;
    samples_per_question: number | null;
    n_questions: number;
    is_baseline: boolean;
    is_ensemble: boolean;
    /** Canonical system name, method and model (lib/vocab.ts). */
    name: string;
    method: MethodId;
    modelName: string;
    runs: number;
    /** Mean SPS: sorts the same as the Index within one dataset. */
    score: number | null;
    ci: { low: number; high: number } | null;
    ciKind: "bootstrap" | "replicates" | null;
  }

  // Thresholds from sb-djv: filter out quick-iteration runs that otherwise
  // flood the list with visually near-identical rows.
  const EXPLORATORY_NQ = 50;
  const EXPLORATORY_SPQ = 10;
  function isExploratory(r: RunIndexEntry): boolean {
    if (r.n_questions < EXPLORATORY_NQ) return true;
    if (r.samples_per_question != null && r.samples_per_question <= EXPLORATORY_SPQ) return true;
    return false;
  }

  const BASE = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "");
  const DEFAULT_DATASET = "opinionsqa";
  const DATASET_ORDER = ["opinionsqa", "subpop", "gss", "globalopinionqa", "ntia"];
  /** Rows shown before "Show all": enough for a read on the top of the field. */
  const TABLE_LIMIT = 25;
  const SORT_KEYS: SortKey[] = ["name", "method", "temp", "tpl", "n", "spq", "runs", "score"];
  /** Text columns sort A→Z first; numeric ones high→low. */
  const defaultDir = (k: SortKey): SortDir =>
    k === "name" || k === "method" || k === "tpl" ? "asc" : "desc";

  const state = {
    runs: [] as RunIndexEntry[],
    datasets: [] as string[],
    search: "",
    dataset: "",
    framework: "",
    temp: "",
    template: "",
    showBaselines: true,
    showExploratory: false,
    collapseReplicates: true,
    view: "table" as View,
    sortKey: "score" as SortKey,
    sortDir: "desc" as SortDir,
    selection: [] as Selection[],
    /** Table view shows the top rows only until "Show all" is pressed. */
    showAll: false,
    /** Grouped view: groups are collapsed unless listed here. */
    openGroups: new Set<string>(),
    /** config_id → 95% bootstrap interval published on the leaderboard. */
    lbCi: new Map<string, { low: number; high: number }>(),
  };

  // Framework / provider / model strings originate from submitted result files
  // (config.provider / config.model / framework), so they are attacker-
  // influenced once a submission is published into runs-index.json. Escape
  // before any innerHTML interpolation to close the stored-XSS vector.
  function escapeHtml(s: unknown): string {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  const fmtScore = (v: number | null | undefined): string => (v == null ? "—" : v.toFixed(3));
  const byId = <T extends HTMLElement>(id: string): T | null =>
    document.getElementById(id) as T | null;

  // ---------- URL state ----------

  function readUrl(): void {
    const p = new URLSearchParams(location.search);
    state.search = p.get("q") ?? "";
    state.dataset = p.get("ds") ?? "";
    state.framework = p.get("fw") ?? "";
    state.temp = p.get("t") ?? "";
    state.template = p.get("tpl") ?? "";
    state.showBaselines = p.get("baselines") !== "0";
    state.showExploratory = p.get("exp") === "1";
    state.collapseReplicates = p.get("runs") !== "1";
    state.view = p.get("view") === "grouped" ? "grouped" : "table";
    state.showAll = p.get("all") === "1";
    const sort = p.get("sort") as SortKey | null;
    state.sortKey = sort && SORT_KEYS.includes(sort) ? sort : "score";
    const dir = p.get("dir");
    state.sortDir = dir === "asc" || dir === "desc" ? dir : defaultDir(state.sortKey);
    const mode: SelectionMode = state.collapseReplicates ? "config" : "run";
    state.selection = (p.get("sel") ?? "")
      .split(",")
      .filter(Boolean)
      .slice(0, 2)
      .map((id) => ({ id, label: id, mode }));
  }

  function writeUrl(): void {
    const p = new URLSearchParams();
    const set = (k: string, v: string | null) => {
      if (v) p.set(k, v);
    };
    set("ds", state.dataset);
    set("q", state.search);
    set("fw", state.framework);
    set("t", state.temp);
    set("tpl", state.template);
    set("baselines", state.showBaselines ? null : "0");
    set("exp", state.showExploratory ? "1" : null);
    set("runs", state.collapseReplicates ? null : "1");
    set("view", state.view === "table" ? null : "grouped");
    set("all", state.showAll ? "1" : null);
    set("sort", state.sortKey === "score" ? null : state.sortKey);
    set("dir", state.sortDir === defaultDir(state.sortKey) ? null : state.sortDir);
    set("sel", state.selection.map((s) => s.id).join(","));
    const qs = p.toString();
    history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`);
  }

  // ---------- Filter chrome ----------

  /** How many filters differ from their defaults (the "Filters (n)" count). */
  function activeFilters(): number {
    return [
      state.search !== "",
      state.framework !== "",
      state.temp !== "",
      state.template !== "",
      !state.showBaselines,
      state.showExploratory,
      !state.collapseReplicates,
    ].filter(Boolean).length;
  }
  const filtersAtDefault = () => activeFilters() === 0;
  /** Reset also restores the view and sort, so it shows when any of those changed. */
  const resetNeeded = () =>
    !filtersAtDefault() ||
    state.view !== "table" ||
    state.sortKey !== "score" ||
    state.sortDir !== "desc";

  function resetAll(): void {
    Object.assign(state, {
      search: "",
      framework: "",
      temp: "",
      template: "",
      showBaselines: true,
      showExploratory: false,
      collapseReplicates: true,
      view: "table",
      sortKey: "score",
      sortDir: "desc",
      showAll: false,
    });
    state.openGroups.clear();
    populateControls();
    update();
  }

  const SORT_LABELS: Record<SortKey, [string, string]> = {
    // [default direction, reversed]
    score: ["Index, best first", "Index, worst first"],
    name: ["System, A to Z", "System, Z to A"],
    method: ["Method, A to Z", "Method, Z to A"],
    temp: ["Temperature, highest first", "Temperature, lowest first"],
    tpl: ["Template, A to Z", "Template, Z to A"],
    n: ["Questions, most first", "Questions, fewest first"],
    spq: ["Samples, most first", "Samples, fewest first"],
    runs: ["Runs, most first", "Runs, fewest first"],
  };

  /** Filter count, Reset visibility and the phone sort menu, after any change. */
  function renderChrome(): void {
    const n = activeFilters();
    const count = byId("filters-count");
    if (count) count.textContent = n ? `(${n})` : "";
    const reset = byId<HTMLButtonElement>("filter-reset");
    if (reset) reset.hidden = !resetNeeded();
    const sel = byId<HTMLSelectElement>("sort-select");
    if (sel) {
      if (!sel.options.length)
        for (const k of SORT_KEYS) {
          const o = document.createElement("option");
          o.value = k;
          sel.appendChild(o);
        }
      const flipped = state.sortDir !== defaultDir(state.sortKey);
      for (const o of sel.options) o.textContent = SORT_LABELS[o.value as SortKey][0];
      const cur = [...sel.options].find((o) => o.value === state.sortKey);
      if (cur) cur.textContent = SORT_LABELS[state.sortKey][flipped ? 1 : 0];
      sel.value = state.sortKey;
    }
    const dir = byId("sort-dir");
    if (dir) dir.textContent = state.sortDir === "asc" ? "↑" : "↓";
  }

  /** URL → leaderboard scope (persisted by the leaderboard) → OpinionsQA. */
  function pickDefaultDataset(): string {
    const ds = state.datasets;
    if (state.dataset && ds.includes(state.dataset)) return state.dataset;
    let scope: string | null = null;
    try {
      scope = localStorage.getItem("sb-scope");
    } catch {
      scope = null;
    }
    if (scope && scope !== "all") {
      const hit = ds.find((d) => datasetBase(d) === scope);
      if (hit) return hit;
    }
    return ds.includes(DEFAULT_DATASET) ? DEFAULT_DATASET : (ds[0] ?? "");
  }

  // ---------- Rows ----------

  function inDataset(): RunIndexEntry[] {
    return state.runs.filter((r) => r.dataset === state.dataset);
  }

  function matchesFilters(r: RunIndexEntry): boolean {
    if (r.dataset !== state.dataset) return false;
    if (state.search) {
      const q = state.search.toLowerCase();
      const hay =
        `${r.model} ${r.display_name} ${r.base_provider ?? ""} ${sysOf(r).full}`.toLowerCase();
      if (!hay.includes(q)) return false;
    }
    if (state.framework && sysOf(r).method !== state.framework) return false;
    if (!state.showBaselines && r.is_baseline) return false;
    if (state.temp) {
      if (state.temp === "default" ? r.temperature != null : String(r.temperature) !== state.temp)
        return false;
    }
    if (state.template && templateLabel(r.template) !== state.template) return false;
    return true;
  }

  function toRows(runs: RunIndexEntry[]): Row[] {
    const head = (r: RunIndexEntry) => ({
      config_id: r.config_id,
      framework: r.framework,
      base_provider: r.base_provider,
      model: r.model,
      display_name: r.display_name,
      dataset: r.dataset,
      temperature: r.temperature,
      effort: r.effort,
      template: r.template,
      persona_pack: r.persona_pack ?? null,
      harness: r.harness ?? null,
      samples_per_question: r.samples_per_question,
      n_questions: r.n_questions,
      is_baseline: r.is_baseline,
      is_ensemble: r.is_ensemble,
      name: sysOf(r).full,
      method: sysOf(r).method,
      modelName: sysOf(r).base,
    });
    if (!state.collapseReplicates) {
      return runs.map((r) => ({
        ...head(r),
        id: r.run_id,
        mode: "run",
        runs: 1,
        score: r.sps,
        ci: null,
        ciKind: null,
      }));
    }
    const byConfig = new Map<string, RunIndexEntry[]>();
    for (const r of runs) {
      const list = byConfig.get(r.config_id);
      if (list) list.push(r);
      else byConfig.set(r.config_id, [r]);
    }
    return [...byConfig].map(([config_id, reps]) => {
      const stats = replicateStats(reps.map((r) => r.sps));
      const lb = state.lbCi.get(config_id) ?? null;
      return {
        ...head(reps[0]),
        id: config_id,
        mode: "config",
        runs: reps.length,
        score: stats.mean,
        ci: lb ?? stats.ci,
        ciKind: lb ? "bootstrap" : stats.ci ? "replicates" : null,
      };
    });
  }

  function sortValue(r: Row, k: SortKey): string | number | null {
    switch (k) {
      case "name":
        return r.name;
      case "method":
        return METHOD_NAMES[r.method].label;
      case "temp":
        return r.temperature;
      case "tpl":
        return templateLabel(r.template);
      case "n":
        return r.n_questions;
      case "spq":
        return r.samples_per_question;
      case "runs":
        return r.runs;
      case "score":
        return r.score;
    }
  }

  function sortRows(rows: Row[]): Row[] {
    const mult = state.sortDir === "asc" ? 1 : -1;
    return rows.slice().sort((a, b) => {
      const x = sortValue(a, state.sortKey);
      const y = sortValue(b, state.sortKey);
      if (x == null && y == null) return (b.score ?? -1) - (a.score ?? -1);
      if (x == null) return 1;
      if (y == null) return -1;
      const c =
        typeof x === "number" && typeof y === "number"
          ? x - y
          : String(x).localeCompare(String(y));
      // Ties fall back to score, best first.
      return c !== 0 ? c * mult : (b.score ?? -1) - (a.score ?? -1);
    });
  }

  // ---------- Controls ----------

  function fillSelect(sel: HTMLSelectElement | null, first: string, values: [string, string][]) {
    if (!sel) return;
    sel.replaceChildren();
    for (const [value, label] of [["", first] as [string, string], ...values]) {
      const opt = document.createElement("option");
      opt.value = value;
      opt.textContent = label;
      sel.appendChild(opt);
    }
  }

  /** Rebuild the option lists from the current dataset so every choice matches something. */
  function populateControls(): void {
    const rows = inDataset();
    const dsWrap = byId<HTMLDivElement>("filter-dataset");
    if (dsWrap) {
      dsWrap.replaceChildren(
        ...state.datasets.map((d) => {
          const n = new Set(
            state.runs.filter((r) => r.dataset === d && !isExploratory(r)).map((r) => r.config_id),
          ).size;
          const on = d === state.dataset;
          const b = document.createElement("button");
          b.type = "button";
          b.setAttribute("role", "radio");
          b.setAttribute("aria-checked", String(on));
          b.dataset.dataset = d;
          b.className = on ? "seg-btn on" : "seg-btn";
          b.innerHTML = `${escapeHtml(datasetLabel(d))} <span class="sb-seg-n">${n}</span>`;
          b.addEventListener("click", () => setDataset(d));
          return b;
        }),
      );
    }

    const present = new Set(rows.map((r) => sysOf(r).method));
    const fws = METHOD_ORDER.filter((m) => present.has(m));
    if (state.framework && !(fws as string[]).includes(state.framework)) state.framework = "";
    const fwSel = byId<HTMLSelectElement>("filter-framework");
    fillSelect(
      fwSel,
      "All methods",
      fws.map((f) => [f, METHOD_NAMES[f].label]),
    );
    if (fwSel) fwSel.value = state.framework;

    const temps = [
      ...new Set(rows.map((r) => r.temperature).filter((t): t is number => t != null)),
    ].sort((a, b) => a - b);
    const tempValues: [string, string][] = [
      ["default", "Provider default only"],
      ...temps.map((t): [string, string] => [String(t), `t = ${t}`]),
    ];
    if (state.temp && !tempValues.some(([v]) => v === state.temp)) state.temp = "";
    const tSel = byId<HTMLSelectElement>("filter-temp");
    fillSelect(tSel, temps.length ? "Any temperature" : "Any (all provider default)", tempValues);
    if (tSel) {
      tSel.value = state.temp;
      tSel.disabled = temps.length === 0;
    }

    const tpls = [...new Set(rows.map((r) => templateLabel(r.template)))].sort((a, b) =>
      a === "default" ? -1 : b === "default" ? 1 : a.localeCompare(b),
    );
    if (state.template && !tpls.includes(state.template)) state.template = "";
    const tplSel = byId<HTMLSelectElement>("filter-template");
    fillSelect(
      tplSel,
      tpls.length > 1 ? "Any template" : "Any (all default)",
      tpls.map((t) => [t, t === "default" ? "Default template only" : t]),
    );
    if (tplSel) {
      tplSel.value = state.template;
      tplSel.disabled = tpls.length < 2;
    }

    const search = byId<HTMLInputElement>("filter-search");
    if (search) search.value = state.search;
    const set = (id: string, v: boolean) => {
      const el = byId<HTMLInputElement>(id);
      if (el) el.checked = v;
    };
    set("filter-baselines", state.showBaselines);
    set("filter-exploratory", state.showExploratory);
    set("filter-collapse", state.collapseReplicates);
    for (const b of document.querySelectorAll<HTMLButtonElement>("#view-mode .view-btn")) {
      const on = b.dataset.view === state.view;
      b.setAttribute("aria-checked", String(on));
      b.className = on ? "view-btn on" : "view-btn";
    }
  }

  function setDataset(d: string): void {
    if (d === state.dataset) return;
    state.dataset = d;
    // Compares are per dataset; a selection from another one can't carry over.
    state.selection = [];
    state.openGroups.clear();
    populateControls();
    update();
  }

  // ---------- Selection / compare tray ----------

  function toggleSelection(sel: Selection): void {
    const idx = state.selection.findIndex((s) => s.id === sel.id);
    if (idx >= 0) {
      state.selection.splice(idx, 1);
    } else {
      if (state.selection.length > 0 && state.selection[0].mode !== sel.mode) {
        state.selection = [];
      }
      state.selection.push(sel);
      // Cap at 2: drop oldest to make room.
      if (state.selection.length > 2) state.selection.shift();
    }
    update();
  }

  function renderCompareTray(): void {
    const tray = byId<HTMLElement>("compare-tray");
    const chips = byId("compare-chips");
    const hint = byId("compare-hint");
    const go = byId<HTMLAnchorElement>("compare-go");
    if (!tray || !chips || !hint || !go) return;

    if (state.selection.length === 0) {
      tray.hidden = true;
      return;
    }
    tray.hidden = false;
    chips.innerHTML = "";
    for (const s of state.selection) {
      const chip = document.createElement("span");
      chip.className =
        "ex-chip inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary px-2 py-0.5 text-xs font-medium";
      chip.title = s.label;
      // Phones cut the name short, so the row's Index leads to tell picks apart.
      const row = lastRows.find((x) => x.id === s.id);
      if (row) {
        const idx = document.createElement("b");
        idx.className = "ex-chip-i sm:hidden";
        idx.textContent = fmtIndex(toIndex(row.score, row.dataset));
        chip.appendChild(idx);
      }
      const text = document.createElement("span");
      text.className = "ex-chip-t";
      text.textContent = s.label;
      chip.appendChild(text);
      const close = document.createElement("button");
      close.type = "button";
      close.setAttribute("aria-label", `Remove ${s.label}`);
      close.className = "text-primary/70 hover:text-primary";
      close.textContent = "×";
      close.addEventListener("click", () => toggleSelection(s));
      chip.appendChild(close);
      chips.appendChild(chip);
    }

    const mode = state.selection[0]?.mode;
    tray.classList.toggle("ex-ready", state.selection.length === 2);
    if (state.selection.length === 2 && mode) {
      const [a, b] = state.selection;
      const url = `${BASE}/compare/?a=${encodeURIComponent(a.id)}&b=${encodeURIComponent(b.id)}&mode=${mode}`;
      go.setAttribute("href", url);
      go.setAttribute("aria-disabled", "false");
      go.removeAttribute("tabindex");
      hint.textContent = `Ready to compare ${mode}s`;
    } else {
      go.setAttribute("href", "#");
      go.setAttribute("aria-disabled", "true");
      go.setAttribute("tabindex", "-1");
      hint.textContent = `Pick one more ${mode ?? "row"} to compare`;
    }
  }

  /** Rows of the last render (the tray looks up each pick's Index). */
  let lastRows: Row[] = [];

  /** Give URL-restored selections their human labels once rows exist. */
  function labelSelection(rows: Row[]): void {
    for (const s of state.selection) {
      const r = rows.find((x) => x.id === s.id);
      if (r) s.label = rowLabel(r);
    }
  }

  const rowLabel = (r: Row): string =>
    `${r.name} (${settingsLabel(r)}${r.mode === "run" ? `, ${r.id.slice(-15)}` : ""})`;

  function guardDisabledLink(el: HTMLAnchorElement): void {
    const block = (e: Event): void => {
      if (el.getAttribute("aria-disabled") === "true") {
        e.preventDefault();
        e.stopPropagation();
      }
    };
    el.addEventListener("click", block);
    el.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      block(e);
    });
  }

  // ---------- Rendering ----------

  function captureFocusKey(): string | null {
    const active = document.activeElement as HTMLElement | null;
    const tree = byId("explore-tree");
    if (!active || !tree || !tree.contains(active)) return null;
    return active.dataset.focusKey ?? null;
  }

  function restoreFocus(key: string | null): void {
    if (!key) return;
    document.querySelector<HTMLElement>(`[data-focus-key="${CSS.escape(key)}"]`)?.focus();
  }

  const COLS: { key: SortKey; label: string; align: "left" | "right"; title?: string }[] = [
    { key: "name", label: "System", align: "left" },
    { key: "method", label: "Method", align: "left", title: "Raw LLM, Althing persona or ensemble" },
    { key: "temp", label: "Temp.", align: "right", title: "Sampling temperature" },
    { key: "tpl", label: "Template", align: "left", title: "Prompt template" },
    { key: "n", label: "Questions", align: "right" },
    { key: "spq", label: "Samples", align: "right", title: "Samples per question" },
    { key: "runs", label: "Runs", align: "right", title: "Replicate runs behind the row" },
    {
      key: "score",
      label: "Index",
      align: "right",
      title:
        "SynthBench Index on this dataset (0 = random answers, 100 = real people), with the raw SPS (0 to 1) below. Mean across replicates. Interval: the leaderboard's 95% bootstrap interval when published, else a 95% t-interval over 3+ replicates.",
    },
  ];

  function headHtml(): string {
    const ths = COLS.map((c) => {
      const active = c.key === state.sortKey;
      const aria = active ? (state.sortDir === "asc" ? "ascending" : "descending") : "none";
      const arrow = active ? (state.sortDir === "asc" ? "▲" : "▼") : "";
      return `<th scope="col" aria-sort="${aria}" class="px-3 py-2 font-semibold text-${c.align} whitespace-nowrap">
        <button type="button" data-sort="${c.key}" data-focus-key="sort::${c.key}" class="inline-flex items-center gap-1 font-semibold hover:text-primary"${c.title ? ` title="${escapeHtml(c.title)}"` : ""}>${escapeHtml(c.label)}<span aria-hidden="true" class="text-xs">${arrow}</span></button>
      </th>`;
    }).join("");
    return `<thead><tr class="border-b border-muted/20 bg-surface dark:bg-surface-dark text-xs uppercase tracking-wide text-muted"><th scope="col" class="w-8 px-3 py-2"><span class="sr-only">Select for compare</span></th>${ths}</tr></thead>`;
  }

  const tag = (text: string, cls = "bg-muted/10 text-muted", title = "") =>
    `<span class="rounded px-1.5 py-0.5 text-xs font-mono ${cls}"${title ? ` title="${escapeHtml(title)}"` : ""}>${escapeHtml(text)}</span>`;

  /** Settings that tell a row apart from same-named rows in its table (row id → keys). */
  type DiffKey = "temp" | "tpl" | "n" | "spq";
  const DIFF_OF: Record<DiffKey, (r: Row) => string> = {
    temp: (r) => tempLabel(r.temperature),
    tpl: (r) => templateLabel(r.template),
    n: (r) => String(r.n_questions),
    spq: (r) => String(r.samples_per_question),
  };
  function diffKeys(rows: Row[]): Map<string, Set<DiffKey>> {
    const byName = new Map<string, Row[]>();
    for (const r of rows) byName.set(r.name, [...(byName.get(r.name) ?? []), r]);
    const out = new Map<string, Set<DiffKey>>();
    for (const same of byName.values()) {
      if (same.length < 2) continue;
      const keys = (Object.keys(DIFF_OF) as DiffKey[]).filter(
        (k) => new Set(same.map(DIFF_OF[k])).size > 1,
      );
      for (const r of same) out.set(r.id, new Set(keys));
    }
    return out;
  }
  /** Emphasis for a setting that differs between rows with the same name. */
  const DIFF_CLS = " ex-diff";

  /**
   * Phones: the settings columns fold into one line under the name. Words
   * rather than the n= / s= column tokens, so it reads as a sentence.
   */
  function metaHtml(r: Row, diff: Set<DiffKey> | undefined): string {
    const part = (k: DiffKey | null, text: string) =>
      k && diff?.has(k) ? `<b class="ex-diff">${escapeHtml(text)}</b>` : escapeHtml(text);
    const bits = [
      part(null, METHOD_NAMES[r.method].label),
      part("temp", `t ${tempLabel(r.temperature)}`),
      part("tpl", `${templateLabel(r.template)} template`),
      part("n", `${r.n_questions} questions`),
      r.samples_per_question == null ? "" : part("spq", `${r.samples_per_question} samples`),
      `${r.runs} run${r.runs === 1 ? "" : "s"}`,
    ].filter(Boolean);
    return `<div class="ex-meta sm:hidden">${bits.join(" · ")}</div>`;
  }

  function rowHtml(r: Row, diff?: Set<DiffKey>): string {
    const dc = (k: DiffKey) => (diff?.has(k) ? DIFF_CLS : "");
    const href =
      r.mode === "run"
        ? `${BASE}/run/${encodeURIComponent(r.id)}/`
        : `${BASE}/config/${encodeURIComponent(r.id)}/`;
    const checked = state.selection.some((s) => s.id === r.id);
    const cbId = `pick-${r.id}`.replace(/[^a-zA-Z0-9_-]/g, "_");
    const tags = [
      r.effort ? tag(`effort=${r.effort}`, undefined, `reasoning effort: ${r.effort}`) : "",
      r.persona_pack
        ? tag(
            `pack=${r.persona_pack}`,
            undefined,
            `conditioned on the Althing ${r.persona_pack} population pack`,
          )
        : "",
      r.mode === "run" ? tag(r.id.slice(-15), undefined, r.id) : "",
    ].join("");
    const ci = r.ci
      ? `<div class="whitespace-nowrap text-[11px] text-muted" title="${r.ciKind === "bootstrap" ? "95% bootstrap interval (leaderboard)" : `95% t-interval over ${r.runs} replicates`}">${fmtIndex(toIndex(r.ci.low, r.dataset))} to ${fmtIndex(toIndex(r.ci.high, r.dataset))}</div>`
      : "";
    return `<tr class="border-b border-muted/10 hover:bg-muted/5${checked ? " bg-primary/5" : ""}" data-row-id="${escapeHtml(r.id)}">
      <td class="px-3 py-1.5 align-top"><input type="checkbox" id="${cbId}" class="accent-primary" data-pick="${escapeHtml(r.id)}" data-focus-key="pick::${escapeHtml(r.id)}" aria-label="Select for compare: ${escapeHtml(rowLabel(r))}"${checked ? " checked" : ""} /></td>
      <td class="px-3 py-1.5 align-top">
        <a href="${href}" class="font-medium text-text dark:text-text-dark hover:text-primary dark:hover:text-primary-light inline-flex items-center gap-1.5">${logoMarkup(labOf(r.is_ensemble ? "ensemble" : r.model), 14)}${escapeHtml(r.name)}</a>
        ${tags ? `<div class="mt-1 flex flex-wrap gap-1">${tags}</div>` : ""}
        ${metaHtml(r, diff)}
      </td>
      <td class="px-3 py-1.5 align-top text-xs">${escapeHtml(METHOD_NAMES[r.method].label)}</td>
      <td class="px-3 py-1.5 align-top text-right font-mono text-xs${r.temperature == null ? " text-muted" : ""}${dc("temp")}">${escapeHtml(tempLabel(r.temperature))}</td>
      <td class="px-3 py-1.5 align-top font-mono text-xs${!r.template || r.template === "current" ? " text-muted" : ""}${dc("tpl")}">${escapeHtml(templateLabel(r.template))}</td>
      <td class="px-3 py-1.5 align-top text-right font-mono text-xs${dc("n")}" data-col="n">n=${r.n_questions}</td>
      <td class="px-3 py-1.5 align-top text-right font-mono text-xs${dc("spq")}" data-col="spq">${r.samples_per_question == null ? "—" : `s=${r.samples_per_question}`}</td>
      <td class="px-3 py-1.5 align-top text-right font-mono text-xs">${r.runs}</td>
      <td class="ex-index px-3 py-1.5 align-top text-right font-mono"><span class="font-semibold">${fmtIndex(toIndex(r.score, r.dataset))}</span>${ci}<div class="whitespace-nowrap text-[11px] text-muted" title="Survey Parity Score, 0 to 1">SPS ${fmtScore(r.score)}</div></td>
    </tr>`;
  }

  function tableHtml(rows: Row[], caption: string, limit = Number.POSITIVE_INFINITY): string {
    const sorted = sortRows(rows);
    const shown = sorted.slice(0, limit);
    // Keep selected rows visible even when they sort below the cut.
    for (const s of state.selection) {
      const r = sorted.find((x) => x.id === s.id);
      if (r && !shown.includes(r)) shown.push(r);
    }
    const diffs = diffKeys(shown);
    const more =
      sorted.length > shown.length
        ? `<div class="flex items-center justify-between gap-3 border-t border-muted/20 px-3 py-2 text-sm text-muted"><span>Showing ${shown.length} of ${sorted.length}.</span><button type="button" id="show-all" class="rounded-md border border-muted/30 px-3 py-1 text-sm font-medium text-text dark:text-text-dark hover:bg-muted/10">Show all ${sorted.length}</button></div>`
        : "";
    return `<div class="overflow-x-auto rounded-lg border border-muted/20"><table class="sb-stack w-full text-sm explore-table" data-stack-lead><caption class="sr-only">${escapeHtml(caption)}</caption>${headHtml()}<tbody>${shown.map((r) => rowHtml(r, diffs.get(r.id))).join("")}</tbody></table>${more}</div>`;
  }

  function groupOf(r: Row): string {
    if (r.method === "baseline") return "Baselines";
    if (r.method === "ensemble") return "Ensembles";
    return `${r.modelName} · ${METHOD_NAMES[r.method].label}`;
  }

  function groupedHtml(rows: Row[]): string {
    const groups = new Map<string, Row[]>();
    for (const r of rows) {
      const k = groupOf(r);
      groups.set(k, [...(groups.get(k) ?? []), r]);
    }
    const best = (rs: Row[]) => Math.max(...rs.map((r) => r.score ?? -1));
    return [...groups]
      .sort((a, b) => best(b[1]) - best(a[1]))
      .map(([k, rs]) => {
        const open = state.openGroups.has(k);
        const bodyId = `grp-${k}`.replace(/[^a-zA-Z0-9_-]/g, "_");
        return `<section class="rounded-lg border border-muted/20 bg-surface dark:bg-surface-dark overflow-hidden">
          <button type="button" class="w-full flex items-center justify-between gap-3 px-4 py-2 text-left text-sm hover:bg-muted/5" data-group="${escapeHtml(k)}" data-focus-key="grp::${escapeHtml(k)}" aria-expanded="${open}" aria-controls="${bodyId}">
            <span class="flex min-w-0 items-center gap-2"><span aria-hidden="true" class="text-muted">${open ? "▾" : "▸"}</span>${logoMarkup(labOf(k === "Baselines" ? "" : k), 15)}<span class="min-w-0"><span class="font-medium">${escapeHtml(k)}</span> <span class="whitespace-nowrap text-xs text-muted">· ${rs.length} ${state.collapseReplicates ? "config" : "run"}${rs.length === 1 ? "" : "s"}</span></span></span>
            <span class="shrink-0 whitespace-nowrap font-mono text-xs text-muted">best Index <span class="font-semibold text-text dark:text-text-dark">${fmtIndex(best(rs) < 0 ? null : toIndex(best(rs), state.dataset))}</span></span>
          </button>
          <div id="${bodyId}" class="px-2 pb-2"${open ? "" : " hidden"}>${tableHtml(rs, `Configurations in ${k}`)}</div>
        </section>`;
      })
      .join("");
  }

  function render(): void {
    const tree = byId("explore-tree");
    const summary = byId("explore-summary");
    const live = byId("explore-live");
    if (!tree || !summary) return;

    const focusKey = captureFocusKey();
    const baseFiltered = state.runs.filter(matchesFilters);
    const filtered = state.showExploratory
      ? baseFiltered
      : baseFiltered.filter((r) => !isExploratory(r));
    const nRuns = filtered.length;
    const nConfigs = new Set(filtered.map((r) => r.config_id)).size;
    const nHidden = baseFiltered.length - filtered.length;
    const ds = datasetLabel(state.dataset);
    const head = state.collapseReplicates
      ? `${nConfigs} configs · ${nRuns} runs on ${ds}`
      : `${nRuns} runs across ${nConfigs} configs on ${ds}`;
    summary.innerHTML =
      nHidden > 0
        ? `${escapeHtml(head)} · ${nHidden} hidden — <button type="button" id="show-exploratory" class="text-primary underline underline-offset-2 hover:no-underline">show exploratory</button>`
        : escapeHtml(head);
    if (live) live.textContent = summary.textContent;

    const groupActions = byId("group-actions");
    if (groupActions) {
      groupActions.classList.toggle("hidden", state.view !== "grouped");
      groupActions.classList.toggle("flex", state.view === "grouped");
    }

    byId("sort-phone")?.classList.toggle("ex-none", nRuns === 0);
    if (nRuns === 0) {
      tree.innerHTML = filtersAtDefault()
        ? `<p class="text-sm text-muted">No runs to show.</p>`
        : `<div class="flex flex-wrap items-center gap-3"><p class="text-sm text-muted">No runs match the current filters.</p><button type="button" id="empty-reset" class="rounded-md border border-muted/30 px-3 py-1.5 text-sm font-medium hover:bg-muted/10">Clear filters</button></div>`;
      return;
    }
    const rows = toRows(filtered);
    lastRows = rows;
    labelSelection(rows);
    tree.innerHTML =
      state.view === "grouped"
        ? `<div class="space-y-2">${groupedHtml(rows)}</div>`
        : tableHtml(
            rows,
            `Configurations on ${ds}. Select a column header to sort.`,
            state.showAll ? Number.POSITIVE_INFINITY : TABLE_LIMIT,
          );
    restoreFocus(focusKey);
  }

  function update(): void {
    render();
    renderCompareTray();
    renderChrome();
    writeUrl();
  }

  // ---------- Wiring ----------

  function wire(): void {
    const tree = byId("explore-tree");
    tree?.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const sortBtn = t.closest<HTMLButtonElement>("button[data-sort]");
      if (sortBtn) {
        const k = sortBtn.dataset.sort as SortKey;
        if (state.sortKey === k) state.sortDir = state.sortDir === "asc" ? "desc" : "asc";
        else {
          state.sortKey = k;
          state.sortDir = defaultDir(k);
        }
        update();
        return;
      }
      if (t.closest("#empty-reset")) {
        resetAll();
        return;
      }
      if (t.closest("#show-all")) {
        state.showAll = true;
        update();
        return;
      }
      const grp = t.closest<HTMLButtonElement>("button[data-group]");
      if (grp?.dataset.group) {
        const k = grp.dataset.group;
        if (state.openGroups.has(k)) state.openGroups.delete(k);
        else state.openGroups.add(k);
        render();
      }
    });
    tree?.addEventListener("change", (e) => {
      const cb = (e.target as HTMLElement).closest<HTMLInputElement>("input[data-pick]");
      if (!cb?.dataset.pick) return;
      const id = cb.dataset.pick;
      const mode: SelectionMode = state.collapseReplicates ? "config" : "run";
      const label = cb.getAttribute("aria-label")?.replace(/^Select for compare: /, "") ?? id;
      toggleSelection({ id, label, mode });
    });
    byId("explore-summary")?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).id !== "show-exploratory") return;
      state.showExploratory = true;
      populateControls();
      update();
      byId("filter-exploratory")?.focus();
    });

    const search = byId<HTMLInputElement>("filter-search");
    search?.addEventListener("input", () => {
      state.search = search.value.trim();
      update();
    });
    const onSelect = (id: string, key: "framework" | "temp" | "template") => {
      const el = byId<HTMLSelectElement>(id);
      el?.addEventListener("change", () => {
        state[key] = el.value;
        update();
      });
    };
    onSelect("filter-framework", "framework");
    onSelect("filter-temp", "temp");
    onSelect("filter-template", "template");
    const onCheck = (id: string, fn: (v: boolean) => void) => {
      const el = byId<HTMLInputElement>(id);
      el?.addEventListener("change", () => {
        fn(el.checked);
        update();
      });
    };
    onCheck("filter-baselines", (v) => {
      state.showBaselines = v;
    });
    onCheck("filter-exploratory", (v) => {
      state.showExploratory = v;
    });
    onCheck("filter-collapse", (v) => {
      state.collapseReplicates = v;
      // Switching mode invalidates any selection whose mode no longer matches.
      const needed: SelectionMode = v ? "config" : "run";
      state.selection = state.selection.filter((s) => s.mode === needed);
    });
    for (const b of document.querySelectorAll<HTMLButtonElement>("#view-mode .view-btn")) {
      b.addEventListener("click", () => {
        state.view = b.dataset.view === "grouped" ? "grouped" : "table";
        populateControls();
        update();
      });
    }
    byId("filter-reset")?.addEventListener("click", resetAll);
    const fToggle = byId<HTMLButtonElement>("filters-toggle");
    fToggle?.addEventListener("click", () => {
      const open = fToggle.getAttribute("aria-expanded") !== "true";
      fToggle.setAttribute("aria-expanded", String(open));
      byId("ex-filters")?.classList.toggle("ex-open", open);
    });
    const sortSel = byId<HTMLSelectElement>("sort-select");
    sortSel?.addEventListener("change", () => {
      state.sortKey = sortSel.value as SortKey;
      state.sortDir = defaultDir(state.sortKey);
      update();
    });
    byId("sort-dir")?.addEventListener("click", () => {
      state.sortDir = state.sortDir === "asc" ? "desc" : "asc";
      update();
    });
    byId("expand-all")?.addEventListener("click", () => {
      const rows = toRows(state.runs.filter(matchesFilters));
      for (const r of rows) state.openGroups.add(groupOf(r));
      render();
    });
    byId("collapse-all")?.addEventListener("click", () => {
      state.openGroups.clear();
      render();
    });
    byId("compare-clear")?.addEventListener("click", () => {
      state.selection = [];
      update();
    });
    const go = byId<HTMLAnchorElement>("compare-go");
    if (go) guardDisabledLink(go);
  }

  /** Leaderboard bootstrap intervals for the configs it ranks (public). */
  async function loadLeaderboardCis(): Promise<void> {
    try {
      const res = await fetch(`${BASE}/data/leaderboard.json`, { cache: "force-cache" });
      if (!res.ok) return;
      const lb = (await res.json()) as {
        entries?: { config_id?: string; ci_lower?: number | null; ci_upper?: number | null }[];
      };
      for (const e of lb.entries ?? []) {
        if (e.config_id && e.ci_lower != null && e.ci_upper != null) {
          state.lbCi.set(e.config_id, { low: e.ci_lower, high: e.ci_upper });
        }
      }
      render();
    } catch {
      // Intervals are optional; rows keep their replicate-based ones.
    }
  }

  async function init(): Promise<void> {
    readUrl();
    wire();
    try {
      const resp = await fetch(`${BASE}/data/runs-index.json`, { cache: "force-cache" });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const payload = (await resp.json()) as RunIndex;
      state.runs = payload.runs;
      // Leaderboard order (core datasets first), then anything else A→Z.
      const rank = (d: string) => {
        const i = DATASET_ORDER.indexOf(datasetBase(d));
        return i < 0 ? DATASET_ORDER.length : i;
      };
      state.datasets = [...new Set(state.runs.map((r) => r.dataset))].sort(
        (a, b) => rank(a) - rank(b) || a.localeCompare(b),
      );
      state.dataset = pickDefaultDataset();
      populateControls();
      update();
      void loadLeaderboardCis();
    } catch (err) {
      const tree = byId("explore-tree");
      const live = byId("explore-live");
      const message = (err as Error).message;
      const isMissing = /HTTP 404/.test(message);
      const liveMsg = isMissing
        ? "No runs published yet — try the Leaderboard."
        : `Failed to load runs index: ${message}. Make sure \`synthbench publish-runs\` has been run.`;
      if (tree) {
        tree.innerHTML = isMissing
          ? `<div class="rounded-lg border border-muted/20 bg-surface dark:bg-surface-dark p-6 text-sm">
              <p class="font-medium mb-1">No runs published yet.</p>
              <p class="text-muted mb-3">The runs index isn't available in this build. Once benchmark runs are published, this page will list them.</p>
              <p>In the meantime, head to the <a class="text-primary hover:underline" href="${BASE}/leaderboard/">Leaderboard</a> for aggregate scores.</p>
            </div>`
          : `<p class="text-sm text-baseline">${escapeHtml(liveMsg)}</p>`;
      }
      if (live) live.textContent = liveMsg;
    }
  }

  init();
</script>

