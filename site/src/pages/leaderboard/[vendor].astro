---
// Retired per-vendor scorecards (sb-1i6). The old /leaderboard/<vendor>/
// URLs now redirect to the system profile for the same model, or to the
// leaderboard for baselines and providers that span several systems. In a
// static build Astro.redirect emits a tiny page with a meta refresh, a
// canonical link to the target and robots noindex.
import leaderboardRaw from "@/data/leaderboard.json";
import { baseIdOf, buildIndexData, systemSlug } from "@/lib/synthIndex";
import { vendorSlugMap } from "@/lib/vendor-slug";
import type { LeaderboardData, SynthBenchData } from "@/types/leaderboard";

export function getStaticPaths() {
  const leaderboard = leaderboardRaw as unknown as LeaderboardData;
  const profiles = new Set(
    buildIndexData(leaderboardRaw as unknown as SynthBenchData).systems.map((c) => c.baseId),
  );
  const baseIds = new Map<string, Set<string>>();
  for (const e of leaderboard.entries) {
    if (!e.provider) continue;
    const ids = baseIds.get(e.provider) ?? new Set<string>();
    ids.add(e.is_baseline ? "" : baseIdOf(e));
    baseIds.set(e.provider, ids);
  }
  return [...vendorSlugMap(baseIds.keys()).entries()].map(([slug, provider]) => {
    const ids = [...(baseIds.get(provider) ?? [])];
    const target =
      ids.length === 1 && profiles.has(ids[0]) ? `system/${systemSlug(ids[0])}/` : "leaderboard/";
    return { params: { vendor: slug }, props: { target } };
  });
}

const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
return Astro.redirect(`${base}${Astro.props.target}`, 301);
---
