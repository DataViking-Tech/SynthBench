---
import AntiGamingSection from "@/components/methodology/AntiGamingSection.astro";
import BaselineDefinitions from "@/components/methodology/BaselineDefinitions.astro";
import CostMethodology from "@/components/methodology/CostMethodology.astro";
import DatasetCards from "@/components/methodology/DatasetCards.astro";
import DatasetPolicyTable from "@/components/methodology/DatasetPolicyTable.astro";
import MetricExplainer from "@/components/methodology/MetricExplainer.astro";
import OperatorDisclosure from "@/components/methodology/OperatorDisclosure.astro";
import PhaseRoadmap from "@/components/methodology/PhaseRoadmap.astro";
import PrivateHoldoutSection from "@/components/methodology/PrivateHoldoutSection.astro";
import ProblemFraming from "@/components/methodology/ProblemFraming.astro";
import RelatedWork from "@/components/methodology/RelatedWork.astro";
import RunValidity from "@/components/methodology/RunValidity.astro";
import ScopeOfClaim from "@/components/methodology/ScopeOfClaim.astro";
import ScoringProtocol from "@/components/methodology/ScoringProtocol.astro";
import IndexPayload from "@/components/sb/IndexPayload.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const bibtex = `@software{synthbench2026,
  title   = {SynthBench: Open Benchmark for Synthetic Survey Respondents},
  author  = {DataViking-Tech},
  year    = {2026},
  url     = {https://github.com/DataViking-Tech/synthbench},
  version = {0.1.0}
}`;
---

<BaseLayout
  title="Methodology: SynthBench"
  description="How SynthBench scores synthetic survey respondents: three checks against real answer distributions, combined into SPS and placed on the SynthBench Index between random answers and real people."
>
  <IndexPayload />
  <div class="sb">
    <section class="sb-head">
      <div class="sb-kicker">Method · Index v1</div>
      <h1 class="sb-h1 sm">How a score is made</h1>
      <p class="sb-lede">
        Each system is scored on three checks against real survey answers. The three are averaged into the
        Survey Parity Score (SPS), which is then placed between two fixed reference points to give the
        SynthBench Index. Raw SPS is still published for every result.
      </p>
      <nav class="sb-toc-inline" aria-label="On this page">
        <a href="#example">Worked example</a>
        <a href="#why-index">Why an Index</a>
        <a href="#recipe">Formula</a>
        <a href="#anchors">Reference points</a>
        <a href="#scope-of-claim">Scope of claim</a>
        <a href="#run-validity">Run validity</a>
        <a href="#citation">Citation</a>
      </nav>
    </section>

    <section class="sb-block sb-panel sb-pad" id="example">
      <h2 class="sb-h2">One survey question, scored</h2>
      <p class="sb-muted">Illustrative numbers. Move the slider to change how the synthetic panel answers.</p>
      <div class="sb-demo">
        <div>
          <div class="sb-strong">“How much do you trust the national news media?”</div>
          <div class="sb-note sb-legend" id="mt-legend"></div>
          <div id="mt-dist"></div>
          <input type="range" min="0" max="100" value="80" id="mt-slider" class="sb-range" aria-label="How the synthetic panel answers" />
          <div class="sb-range-labels"><span>Random</span><span>Matches people</span><span>Over-confident</span></div>
        </div>
        <div>
          <div class="sb-scores" id="mt-scores"></div>
          <div class="sb-kicker sb-mt">Index for this question</div>
          <div class="sb-big" id="mt-big"></div>
          <p class="sb-note" id="mt-note"></p>
        </div>
      </div>
    </section>

    <section class="sb-block sb-panel sb-pad" id="why-index">
      <h2 class="sb-h2">Why an Index instead of raw SPS</h2>
      <p class="sb-muted">The same systems on both scales, OpinionsQA.</p>
      <div id="mt-why"></div>
      <p class="sb-note" id="mt-why-note"></p>
    </section>

    <section class="sb-block sb-panel sb-pad" id="recipe">
      <h2 class="sb-h2">The formula</h2>
      <p class="sb-muted">Versioned. Any change to the weights or reference points changes the Index version.</p>
      <div class="sb-formula">
        <div>
          <span>Per question</span>
          <p>
            <b>Shares match</b> = 1 − Jensen-Shannon divergence(system, people)<br />
            <b>Order match</b> = (1 + Kendall τ<sub>b</sub>) ÷ 2<br />
            <b>Refusal match</b> = 1 − |refusal rate gap|
          </p>
        </div>
        <div>
          <span>Per dataset</span>
          <p>
            <b>SPS</b> = mean of the three, averaged over questions<br />
            <b>Index<sub>d</sub></b> = 100 × (SPS − SPS<sub>random</sub>) ÷ (ceiling − SPS<sub>random</sub>)
          </p>
        </div>
        <div>
          <span>Headline</span>
          <p>
            <b>SynthBench Index</b> = mean of Index<sub>d</sub> over OpinionsQA, SubPOP and GlobalOpinionQA<br />
            95% intervals come from bootstrap resampling of questions
          </p>
        </div>
      </div>
    </section>

    <section class="sb-block sb-panel sb-pad" id="anchors">
      <h2 class="sb-h2">Where 0 and 100 sit</h2>
      <p class="sb-muted">
        0 is the SPS of uniformly random answers. 100 is the ceiling: how well one random half of the real
        panel matches the other half (split-half bootstrap). The majority-answer baseline is shown for reference.
      </p>
      <div class="sb-tablewrap"><table class="sb-ct" id="mt-anchors"></table></div>
    </section>

    <section class="sb-block sb-head">
      <h2 class="sb-h2">Full methodology</h2>
    </section>
  </div>

  <ProblemFraming />

  <ScopeOfClaim />

  <OperatorDisclosure />

  <MetricExplainer />

  <BaselineDefinitions />

  <DatasetCards />

  <p class="w-full max-w-4xl mx-auto -mt-6 pb-6 text-sm text-muted">
    These dataset cards also live on the standalone{" "}
    <a
      href={`${import.meta.env.BASE_URL?.replace(/\/?$/, "/") ?? "/"}datasets/`}
      class="text-primary dark:text-primary-light underline underline-offset-2 hover:no-underline"
      >datasets page</a
    >.
  </p>

  <DatasetPolicyTable />

  <PrivateHoldoutSection />

  <ScoringProtocol />

  <RunValidity />

  <AntiGamingSection />

  <CostMethodology />

  <RelatedWork />

  <PhaseRoadmap />

  <!-- Citation -->
  <section class="w-full max-w-4xl mx-auto py-12" id="citation">
    <h2
      class="text-2xl font-bold tracking-tight text-text dark:text-text-dark mb-2"
    >
      Citation
    </h2>
    <p class="text-muted mb-6">
      If you use SynthBench in your research, please cite:
    </p>
    <div class="relative">
      <pre
        class="rounded-lg border border-muted/20 bg-surface p-6 text-sm/6 font-mono text-text overflow-x-auto dark:bg-surface-dark dark:text-text-dark"
        >{bibtex}</pre>
      <button
        type="button"
        class="absolute top-3 right-3 rounded-md p-2 text-muted hover:text-text dark:hover:text-text-dark"
        id="copy-bibtex"
        aria-label="Copy BibTeX"
        data-bibtex={bibtex}
      >
        <svg
          class="size-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"
          ></path>
        </svg>
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import "@/scripts/sb/pages/method";
</script>

<script>
  const btn = document.getElementById("copy-bibtex");
  if (btn) {
    btn.addEventListener("click", () => {
      const text = btn.dataset.bibtex ?? "";
      navigator.clipboard.writeText(text).then(() => {
        btn.setAttribute("aria-label", "Copied!");
        setTimeout(() => btn.setAttribute("aria-label", "Copy BibTeX"), 2000);
      });
    });
  }
</script>
