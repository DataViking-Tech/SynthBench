---
import AntiGamingSection from "@/components/methodology/AntiGamingSection.astro";
import CeilingDetail from "@/components/methodology/CeilingDetail.astro";
import CostMethodology from "@/components/methodology/CostMethodology.astro";
import DatasetSummary from "@/components/methodology/DatasetSummary.astro";
import MethodJump, { type JumpGroup } from "@/components/methodology/MethodJump.astro";
import MethodSection from "@/components/methodology/MethodSection.astro";
import OperatorDisclosure from "@/components/methodology/OperatorDisclosure.astro";
import PreliminaryResults from "@/components/methodology/PreliminaryResults.astro";
import PrivateHoldoutSection from "@/components/methodology/PrivateHoldoutSection.astro";
import ProblemFraming from "@/components/methodology/ProblemFraming.astro";
import RelatedWork from "@/components/methodology/RelatedWork.astro";
import RunValidity from "@/components/methodology/RunValidity.astro";
import ScopeOfClaim from "@/components/methodology/ScopeOfClaim.astro";
import ScoringProtocol from "@/components/methodology/ScoringProtocol.astro";
import SubMetrics from "@/components/methodology/SubMetrics.astro";
import IndexPayload from "@/components/sb/IndexPayload.astro";
import CodeBlock from "@/components/shared/CodeBlock.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/sb-method.css";

const bibtex = `@software{synthbench2026,
  title   = {SynthBench: Open Benchmark for Synthetic Survey Respondents},
  author  = {DataViking-Tech},
  year    = {2026},
  url     = {https://github.com/DataViking-Tech/synthbench},
  version = {0.1.0}
}`;

// Every section (h2) on the page, in order. A section that doesn't render
// (Preliminary, when there are no matched pairs) is dropped from the menu
// at runtime.
const jump: JumpGroup[] = [
  {
    label: "How a score is made",
    items: [
      { id: "example", label: "Worked example" },
      { id: "why-index", label: "Why an Index" },
      { id: "recipe", label: "Formula" },
      { id: "metrics", label: "Sub-metrics" },
      { id: "anchors", label: "Reference points" },
      { id: "ceiling", label: "Ceiling" },
      { id: "preliminary", label: "Preliminary results" },
    ],
  },
  {
    label: "Full methodology",
    items: [
      { id: "problem-framing", label: "Why human data" },
      { id: "scope-of-claim", label: "Scope of claim" },
      { id: "operator-disclosure", label: "Who runs this" },
      { id: "datasets", label: "Datasets" },
      { id: "private-holdout", label: "Private holdout" },
      { id: "scoring", label: "How a run works" },
      { id: "run-validity", label: "Run validity" },
      { id: "anti-gaming", label: "Anti-gaming" },
      { id: "cost-computation", label: "Cost" },
      { id: "related-work", label: "Related work" },
      { id: "citation", label: "Citation" },
    ],
  },
];
---

<BaseLayout
  title="Method"
  description="How SynthBench scores synthetic survey respondents: three checks against real answer distributions, combined into SPS and placed on the SynthBench Index between random answers and real people."
>
  <IndexPayload />
  <div class="sb sb-meth">
    <section class="sb-head">
      <div class="sb-kicker">Method · Index v1</div>
      <h1 class="sb-h1 sm" tabindex="-1">How a score is made</h1>
      <p class="sb-lede">
        Each system is scored on three checks against real survey answers. The three are averaged into the
        Survey Parity Score (SPS), which is then placed between two fixed reference points to give the
        SynthBench Index. Raw SPS is still published for every result.
      </p>
    </section>

    <MethodJump groups={jump} />

    <MethodSection id="example" title="One survey question, scored">
      <p class="sb-muted" slot="lede">Illustrative numbers. Move the slider to change how the synthetic panel answers.</p>
      <div class="sb-demo">
        <div>
          <div class="sb-strong">“How much do you trust the national news media?”</div>
          <div class="sb-note sb-legend" id="mt-legend"></div>
          <div id="mt-dist"></div>
          <input type="range" min="0" max="100" value="80" id="mt-slider" class="sb-range" aria-label="How the synthetic panel answers" />
          <div class="sb-range-labels"><span>Random</span><span>Matches people</span><span>Over-confident</span></div>
        </div>
        <div>
          <div class="sb-scores" id="mt-scores"></div>
          <div class="sb-kicker sb-mt">Index for this question</div>
          <div class="sb-big" id="mt-big"></div>
          <p class="sb-note" id="mt-note"></p>
        </div>
      </div>
    </MethodSection>

    <MethodSection id="why-index" title="Why an Index instead of raw SPS">
      <p class="sb-muted" slot="lede">The same systems on both scales, OpinionsQA.</p>
      <div id="mt-why"></div>
      <p class="sb-note" id="mt-why-note"></p>
    </MethodSection>

    <MethodSection id="recipe" title="The formula">
      <p class="sb-muted" slot="lede">Versioned. Any change to the weights or reference points changes the Index version.</p>
      <div class="sb-formula">
        <div>
          <span>Per question</span>
          <p>
            <b>Shares match</b> = 1 − Jensen-Shannon divergence(system, people)<br />
            <b>Order match</b> = (1 + Kendall τ<sub>b</sub>) ÷ 2<br />
            <b>Refusal match</b> = 1 − |refusal rate gap|
          </p>
        </div>
        <div>
          <span>Per dataset</span>
          <p>
            <b>SPS</b> = mean of the three, averaged over questions<br />
            <b>Index<sub>d</sub></b> = 100 × (SPS − SPS<sub>random</sub>) ÷ (ceiling − SPS<sub>random</sub>)
          </p>
        </div>
        <div>
          <span>Headline</span>
          <p>
            <b>SynthBench Index</b> = mean of Index<sub>d</sub> over OpinionsQA, SubPOP, GSS and GlobalOpinionQA<br />
            95% intervals come from bootstrap resampling of questions
          </p>
        </div>
      </div>
    </MethodSection>

    <SubMetrics />

    <MethodSection id="anchors" title="Where 0 and 100 sit">
      <p class="sb-muted sb-measure" slot="lede">
        0 is the SPS of uniformly random answers. 100 is the ceiling: how well one random half of the real
        panel matches the other half (split-half bootstrap). The majority-answer baseline is shown for reference.
      </p>
      <div class="sb-tablewrap sb-sticky sb-mt"><table class="sb-ct" id="mt-anchors"></table></div>
    </MethodSection>

    <CeilingDetail />

    <PreliminaryResults />

    <div class="sb-mdiv">
      <div class="sb-kicker">Full methodology</div>
      <p class="sb-muted sb-measure">
        The claim and its limits, who runs the benchmark, the datasets, the holdout, the run protocol, cost
        and related work.
      </p>
    </div>

    <ProblemFraming />

    <ScopeOfClaim />

    <OperatorDisclosure />

    <DatasetSummary />

    <PrivateHoldoutSection />

    <ScoringProtocol />

    <RunValidity />

    <AntiGamingSection />

    <CostMethodology />

    <RelatedWork />

    <MethodSection id="citation" title="Citation">
      <p class="sb-muted" slot="lede">If you use SynthBench in your research, please cite:</p>
      <CodeBlock code={bibtex} what="BibTeX" wrap class="sb-mt" />
    </MethodSection>
  </div>
</BaseLayout>

<script>
  import "@/scripts/methodNav";
  import { boot } from "@/scripts/sb/boot";
  boot(() => import("@/scripts/sb/pages/method"));
</script>
