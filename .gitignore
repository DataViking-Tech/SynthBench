# SynthBench data & results (downloaded, not committed). Everything under /data
# is gitignored *except* the question-text registries — those are committed
# fixtures used by publish.py to rehydrate historical truncated text (sb-x2k) —
# and the accepted-adapter registry that gates submission PRs (sb-6gw).
/data/*
!/data/question-text-registries/
!/data/accepted_adapters.json
/results/
*.json.bak

# Astro site build artifacts
site/dist/
site/node_modules/
site/.astro/
# Generated leaderboard + run explorer data (regenerated by CI)
site/src/data/
site/public/data/

# Playwright test artifacts
site/e2e/test-results/
site/e2e/test-results-*/
site/e2e/mobile-audit-out/
site/playwright-report/

# Gas City
.beads/*
!.beads/config.yaml
!.beads/metadata.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
